{:paths ["src" "resources"]
 :deps {
        ;; The host-free, dependency-closed core of this repository (15 namespaces and their tests) lives in
        ;; kotoba lib/kotoba.torihikiCore; this repository keeps the rest and requires the library, so the code exists once.
        io.github.kotoba-lang/torihiki-core
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "c59d8fd4a5f4de6f8d51df28768e97b78d3f31fd"
         :deps/root "lib/kotoba.torihikiCore"}
        ;; kotoba.io replaced clojure.java.io here (2026-09-24). An explicit floor:
        ;; kotoba.io carries clojure.java.io's file/as-file/as-relative-path/
        ;; make-parents/delete-file from 98045c7, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/io
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.io"}
        ;; kotoba.pprint replaced clojure.pprint here (2026-09-24): the same
        ;; bytes (cljs.pprint transcribed). An explicit floor; tools.deps takes the
        ;; NEWEST sha it is shown.
        io.github.kotoba-lang/pprint
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.pprint"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.edn"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.test"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.text"}
       org.clojure/clojure {:mvn/version "1.12.0"}
        ;; torihiki.log only. The book, clearinghouse, funding and
        ;; liquidation namespaces have no dependencies at all and must keep
        ;; it that way — they are the part a validator executes per order.
        io.github.kotoba-lang/chain
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.chain"}
        ;; Pure, synchronous, dependency-free SHA-256 that is identical on the
        ;; JVM and in JS. Its own docstring says it exists so repos stop
        ;; hand-rolling one each; taking it at its word is the point.
        ;; The authenticated tree over the state. Already a zero-dependency
        ;; portable .cljc Merkle tree with inclusion proofs, extracted so that
        ;; "any actor needing PoR/PoL reuses one audited implementation" —
        ;; writing a fourth Merkle tree in this workspace to avoid one
        ;; dependency would be writing a fourth thing to get subtly wrong.
        io.github.kotoba-lang/merkle-sum
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.merkleSum"}
        io.github.kotoba-lang/bytes
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.bytes"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/url "https://github.com/cognitect-labs/test-runner.git"
                       :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  ;; The JVM half of the cross-runtime parity check; the nbb half is
  ;; script/torihiki-parity-on-nbb.cljk (via script/nbb-parity.sh).
  ;; Both must print the same state root.
  :parity {:main-opts ["-m" "torihiki.parity"]}
  ;; The throughput claim in the README is this alias. It is not a test —
  ;; it prints numbers and asserts nothing — so it never gates CI, but it
  ;; must stay runnable or the claim rots.
  :bench {:extra-paths ["bench"]
          :jvm-opts ["-Xmx4g" "-XX:+UseParallelGC"]
          :main-opts ["-m" "torihiki.bench"]}
  ;; The Hyperliquid comparison: the whole state machine (validation, margin,
  ;; fees, liquidation sweep), then signatures, then the state root, each timed
  ;; per block and set beside the figures in bench/torihiki/hyperliquid-reference.edn.
  ;; Refuses (exit 1) rather than print a number it did not earn.
  :bench-hl {:extra-paths ["bench"]
             :jvm-opts ["-Xmx6g" "-XX:+UseParallelGC"]
             :main-opts ["-m" "torihiki.hyperliquid"]}}}
