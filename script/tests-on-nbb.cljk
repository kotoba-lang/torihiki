;; The whole test suite, on ClojureScript, without a JVM.
;;
;;   KOTOBA_CHECKOUTS=<dir-of-sibling-checkouts> script/nbb-test.sh
;;
;; `script/nbb-leg.sh` (which that wrapper calls) builds the classpath from
;; the deps.edn pins and calls this, so the pins are what runs rather than
;; whatever is checked out. This file's header used to name a runner
;; (`script/run-nbb-tests.cljs`) that never existed — flagged in
;; evidence/2026-09-03-maturity-remeasure-2100.md, still true on 2026-10-24
;; when script/nbb-test.sh landed and the citation was retired.
;;
;; ## Why this exists, and why `loads-on-nbb` is not it
;;
;; `loads-on-nbb` requires every namespace and stops. It catches the class it
;; was written for -- unresolvable symbols, reader damage, macro expansion that
;; only works on one side -- and its own comment says plainly that it does NOT
;; catch behaviour that differs between the runtimes.
;;
;; That leaves the ClojureScript path asserting almost nothing, and the
;; ClojureScript path is the one that DEPLOYS: `torihiki-node` compiles this
;; engine to a Worker bundle, and a validator runs those bytes. The JVM suite
;; is the one nobody ships.
;;
;; The gap was not hypothetical either. `torihiki.parity` exists because a
;; JVM-side optimisation -- reading a record's fields with direct interop --
;; returned `undefined` in ClojureScript instead of failing, and surfaced much
;; later as an array read on nothing. `parity` pins two digests against that.
;; Two digests are not 845 assertions.
;;
;; ## And because the ledger already claimed this file
;;
;; ADR-2800004800 section 4 records, under "this period's added instruments",
;; `script/tests-on-nbb.cljk -- 328 tests / 850 assertions on both runtimes`.
;; The file was not on `main`. A recorded instrument that does not exist reads
;; exactly like one that exists and is passing, which is the failure this
;; workspace names as its own: a check that could not run returning the value
;; of a check that ran and found nothing.
;;
;; So the counts below are printed, not asserted against a remembered number.
;; The JVM suite prints its own; two numbers that disagree are a finding.
(ns tests-on-nbb
  (:require [cljs.test :as ct]
            [torihiki.api-test]
            [torihiki.apply-totality-test]
            [torihiki.auth-test]
            [torihiki.book-test]
            [torihiki.bridge-test]
            [torihiki.commit-test]
            [torihiki.evm-interp-test]
            [torihiki.evm-test]
            [torihiki.funding-test]
            [torihiki.fuzz-seeded-test]
            [torihiki.governance-test]
            [torihiki.light-test]
            [torihiki.liquidation-makers-test]
            [torihiki.log-test]
            [torihiki.mark-test]
            [torihiki.oracle-test]
            [torihiki.oracle-set-test]
            [torihiki.order-margin-test]
            [torihiki.overflow-gates-test]
            [torihiki.principal-test]
            [torihiki.schedule-totality-test]
            [torihiki.settlement-test]
            [torihiki.slab-full-test]
            [torihiki.snapshot-test]
            [torihiki.spot-reservation-test]
            [torihiki.state-test]
            [torihiki.trigger-test]
            [torihiki.validators-test]))

;; The floor. A classpath that resolves `cljs.test` but none of the test
;; namespaces would run zero tests and report zero failures, and this script
;; would exit 0 -- "could not measure" wearing the face of "measured, clean".
;; Twenty-seven namespaces are required; fewer than twenty-seven ran means
;; the run is unanswerable, and it exits 2 rather than 0 or 1. (This floor
;; said "sixteen" and checked 26 while `torihiki.overflow-gates-test` and
;; `torihiki.fuzz-seeded-test` were missing from the lists below: the leg
;; ran the suite MINUS the i53 gates and the fuzz invariants and blessed it
;; as "the suite" — measured 2026-10-24, 468 tests / 3265 assertions here
;; against 502 / 3504 on `kbb -M:test`. A floor that counts the namespaces
;; actually listed is only as honest as the list.)
;;
;; The floor is 26, not 29, since PR #74: `torihiki.address-test`,
;; `torihiki.clearing-test` and `torihiki.thorchain-test` moved into kotoba
;; `lib/kotoba.torihikiCore` with the 15 host-free namespaces they test
;; (registered there in `lib/test-suites.json`), and the require list above
;; was trimmed to match. PR #74 left this constant at 29 and merged with
;; "Not run: this repository's build and tests"; the first nbb leg after the
;; move measured the disagreement as a floor refusal (26 of 29 namespaces,
;; 516 tests / 3605 assertions clean otherwise, exit 2 — 2026-10-28).
;; The floor is 27, not 26: `torihiki.apply-totality-test` joined the suite
;; with the apply-path shape gates (the `torihiki.api` order/amend/cancel/
;; trigger doors and their `torihiki.state` engine gates) — 26 was the suite
;; PR #74 left, and 27 is that suite plus the totality pins. The constant
;; stays hard so a classpath that drops more namespaces still exits 2.
;; The floor is 28, not 27: `torihiki.schedule-totality-test` joined the
;; suite with the schedule-path shape gates (the `torihiki.api` scale/twap
;; doors and their `torihiki.state` engine gates + `fire-twaps` fire-time
;; gate) — 27 was the suite the apply-path totality gates left, and 28 is
;; that suite plus the schedule totality pins. The constant stays hard so a
;; classpath that drops more namespaces still exits 2.
(def ^:private expected-namespaces 28)
(defonce ^:private ns-seen (atom 0))

(defmethod ct/report [::ct/default :begin-test-ns] [_] (swap! ns-seen inc))

(defmethod ct/report [::ct/default :end-run-tests] [m]
  (let [{:keys [test pass fail error]} m
        ran-ns @ns-seen]
    (println (str "namespaces " ran-ns "/" expected-namespaces))
    (println)
    (println (str "Ran " test " tests containing " (+ pass fail error) " assertions."))
    (println (str fail " failures, " error " errors."))
    (cond
      (or (zero? test) (< ran-ns expected-namespaces))
      (do (println (str "REFUSING to report a pass: " ran-ns " of " expected-namespaces
                        " namespaces ran and " test " tests executed. The classpath did"
                        " not carry the suite; this run is unanswerable, not clean."))
          (js/process.exit 2))

      (pos? (+ fail error))
      (js/process.exit 1)

      :else
      (println "TESTS-ON-NBB: pass — the runtime that deploys ran the suite"))))

(ct/run-tests 'torihiki.api-test
              'torihiki.apply-totality-test
              'torihiki.auth-test
              'torihiki.book-test
              'torihiki.bridge-test
              'torihiki.commit-test
              'torihiki.evm-interp-test
              'torihiki.evm-test
              'torihiki.funding-test
              'torihiki.fuzz-seeded-test
              'torihiki.governance-test
              'torihiki.light-test
              'torihiki.liquidation-makers-test
              'torihiki.log-test
              'torihiki.mark-test
              'torihiki.oracle-test
              'torihiki.oracle-set-test
              'torihiki.order-margin-test
              'torihiki.overflow-gates-test
              'torihiki.principal-test
              'torihiki.schedule-totality-test
              'torihiki.settlement-test
              'torihiki.slab-full-test
              'torihiki.snapshot-test
              'torihiki.spot-reservation-test
              'torihiki.state-test
              'torihiki.trigger-test
              'torihiki.validators-test)
