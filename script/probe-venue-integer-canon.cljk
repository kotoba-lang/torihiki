(require '[torihiki.venue :as v]
         '[torihiki.venue-mt :as mt])

(defn show [label x] (println label "=>" (pr-str x)))

;; ── 1. the raw predicate, the api.cljk:67 claim measured one layer down ──
(show "integer? 3.0" (integer? 3.0))
(show "integer? 9007199254740992" (integer? 9007199254740992))
(show "long 3.0" (long 3.0))

;; ── 2. venue-mt frame-seq door (ingest*, the `n` gate) ──
(def hello {"t" "hello" "v" 1 "n" 0 "mode" "demo"})
(defn tick [n] {"t" "tick" "n" n "s" "EURUSD" "bid" "1.08490" "ask" "1.08500"})

(let [st (-> (mt/empty-state) (mt/ingest hello 1000) (mt/ingest (tick 3.0) 1000))]
  (show "seq n=3.0 (whole double) rejects" (mapv :reason (:rejects st)))
  (show "seq n=3.0 stored :n" (pr-str (:n st))))

(let [st (-> (mt/empty-state) (mt/ingest hello 1000) (mt/ingest (tick 9007199254740992) 1000))]
  (show "seq n=2^53 rejects" (mapv :reason (:rejects st)))
  (show "seq n=2^53 stored :n" (pr-str (:n st))))

(let [st (-> (mt/empty-state) (mt/ingest hello 1000) (mt/ingest (tick 3.5) 1000))]
  (show "seq n=3.5 (fractional) rejects" (mapv :reason (:rejects st))))

;; ── 3. venue-mt sym door (the `digits` gate) ──
(let [st (mt/ingest (mt/empty-state) hello 1000)
      st (mt/ingest st {"t" "sym" "n" 1 "s" "EURUSD" "digits" 3.0 "step" "0.01"
                        "min" "0.01" "max" "100.00" "tick" "0.00001" "trade" "full"} 1000)]
  (show "sym digits=3.0 rejects" (mapv :reason (:rejects st)))
  (show "sym digits=3.0 :digits" (pr-str (get-in st [:syms "EURUSD" :digits]))))

;; ── 4. venue order-translation door (->venue-order) and value guards ──
(def entry {:market 1 :venue-symbol "EURUSD" :tick-size "0.00001" :lot-size "0.01"})
(show "->venue-order qty 3.0" (pr-str (v/->venue-order entry {:cid "t-1" :side :buy :qty 3.0 :price 108500})))
(show "->venue-order qty 30 price 3.0" (pr-str (v/->venue-order entry {:cid "t-1" :side :buy :qty 30 :price 3.0})))
(show "string-of 3.0 0.01" (pr-str (v/string-of 3.0 "0.01")))
(show "check-entry digits 3.0" (pr-str (v/check-entry entry {:digits 3.0 :volume-step "0.01"
                                                             :volume-min "0.01" :volume-max "100.00"
                                                             :trade-allowed? true})))
(println "PROBE-DONE")
