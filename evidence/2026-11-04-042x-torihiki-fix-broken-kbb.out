expected: nil
  actual: #error {:message "torihiki.log: value has no wire form", :data {:type :sci/error, :line 112, :column 11, :message "torihiki.log: value has no wire form", :sci.impl/callstack #object[cljs.core.Volatile {:val (#sci.impl.utils.StackFrame{:line 278, :column 3, :end-line nil, :end-column nil, :ns #object[at torihiki.log-test], :file "/Users/junkawasaki/github/wt/fleet/bot-torihiki-fix-20261104-0028/test/torihiki/log_test.cljk", :f-meta nil, :special false} #sci.impl.utils.StackFrame{:line 280, :column 13, :end-line nil, :end-column nil, :ns #object[at torihiki.log-test], :file "/Users/junkawasaki/github/wt/fleet/bot-torihiki-fix-20261104-0028/test/torihiki/log_test.cljk", :f-meta {:arglists ([tx]), :doc "Encode a transaction exactly — every key, every value, whatever the engine\n  will later make of it.\n\n  The kind rides under \"tx\": a plain keyword as its name string (the shape\n  every committed block has), anything else tagged. Other entries ride under\n  their name string when that name is unambiguous, and under `pairs-key` when\n  it is not — so a transaction carrying a namespaced key or a key the codec\n  has never seen still round-trips byte-exactly through `wire->tx`.", :line 130, :column 1, :ns #object[at torihiki.log], :name tx->wire, :file "/Users/junkawasaki/github/wt/fleet/bot-torihiki-fix-20261104-0028/src/torihiki/log.cljk"}, :special false} #sci.impl.utils.StackFrame{:line 147, :column 14, :end-line nil, :end-column nil, :ns #object[at torihiki.log], :file "/Users/junkawasaki/github/wt/fleet/bot-torihiki-fix-20261104-0028/src/torihiki/log.cljk", :f-meta {:name into, :doc "Returns a new coll consisting of to-coll with all of the items of\n  from-coll conjoined. A transducer may be supplied.", :arglists ([] [to] [to from] [to xform from]), :file "cljs/core.cljs", :line 5430, :column 7, :ns #object[at clojure.core], :sci/built-in true}, :special false} #sci.impl.utils.StackFrame{:line nil, :column nil, :end-line nil, :end-column nil, :ns #object[at torihiki.log], :file "/Users/junkawasaki/github/wt/fleet/bot-torihiki-fix-20261104-0028/src/torihiki/log.cljk", :f-meta nil, :special false} #sci.impl.utils.StackFrame{:line 148, :column 35, :end-line nil, :end-column nil, :ns #object[at torihiki.log], :file "/Users/junkawasaki/github/wt/fleet/bot-torihiki-fix-20261104-0028/src/torihiki/log.cljk", :f-meta {:private true, :arglists ([v]), :doc "The wire form of one value: bare where the wire format was always bare\n  (integers, strings), tagged `[tag payload]` where the type must survive the\n  round trip. Total over the EDN subset a transaction can carry; anything\n  else has no wire form and is refused loudly rather than mangled.\n\n  Map entries are sorted by the printed encoding of their key so two runtimes\n  that fold the same map produce the same bytes — an unsorted pair list would\n  make the CID depend on hash iteration order.", :line 78, :column 1, :ns #object[at torihiki.log], :name enc-val, :file "/Users/junkawasaki/github/wt/fleet/bot-torihiki-fix-20261104-0028/src/torihiki/log.cljk"}, :special false} #sci.impl.utils.StackFrame{:line 112, :column 11, :end-line nil, :end-column nil, :ns #object[at torihiki.log], :file "/Users/junkawasaki/github/wt/fleet/bot-torihiki-fix-20261104-0028/src/torihiki/log.cljk", :f-meta nil, :special true})}], :file "/Users/junkawasaki/github/wt/fleet/bot-torihiki-fix-20261104-0028/src/torihiki/log.cljk"}, :cause #error {:message "torihiki.log: value has no wire form", :data {:value 5.5}}}

