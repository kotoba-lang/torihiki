;; probe: can a map/set actually hold two members whose canon-val forms are
;; `=`-equal on this runtime? (api/canon-val silent-merge door — measurements
;; must precede the tests)
(println "jvm-or-sci probe")
(println "(= 5 5.0)" (= 5 5.0))
(println "(= 5 (long 5.0))" (= 5 (long 5.0)))
(println "(count (into {} [[5 :a] [5.0 :b]]))" (count (into {} [[5 :a] [5.0 :b]])))
(println "(count (into #{} [5 5.0]))" (count (into #{} [5 5.0])))
(println "(count (into #{} [5 5]))" (count (into #{} [5 5])))
#?(:clj (do
          (println "(= 5 5N)" (= 5 (bigint 5)))
          (println "(= 5.0 5N)" (= 5.0 (bigint 5)))
          (println "(count (into {} [[5 :a] [(bigint 5) :b]]))" (count (into {} [[5 :a] [(bigint 5) :b]])))
          (println "(count (into {} [[5.0 :a] [(bigint 5) :b]]))" (count (into {} [[5.0 :a] [(bigint 5) :b]])))
          (println "(= 1e17 (bigint 1e17))" (= 1e17 (bigint 1e17)))
          (println "(count (into {} [[1e17 :a] [(bigint 1e17) :b]]))" (count (into {} [[1e17 :a] [(bigint 1e17) :b]])))
          (println "(count (into {} [[5 :a] [5.0 :b]])) then assoc" (count (assoc (into {} [[5 :a] [5.0 :b]]) 5 :c)))
          (println "vector keys (count (into {} [[[5] :a] [[5.0] :b]]))" (count (into {} [[[5] :a] [[5.0] :b]])))))
#?(:cljs (do
           (println "(= 5 (js/BigInt 5))" (= 5 (js/BigInt 5)))
           (println "(integer? (js/BigInt 5))" (integer? (js/BigInt 5)))
           (println "(number? (js/BigInt 5))" (number? (js/BigInt 5)))
           (println "(count (into {} [[5 :a] [(js/BigInt 5) :b]]))" (count (into {} [[5 :a] [(js/BigInt 5) :b]])))
           (println "(count (into {} [[5.0 :a] [(js/BigInt 5) :b]]))" (count (into {} [[5.0 :a] [(js/BigInt 5) :b]])))
           (println "(count (into #{} [5 (js/BigInt 5)]))" (count (into #{} [5 (js/BigInt 5)])))
           (println "vector keys (count (into {} [[[5] :a] [[5.0] :b]]))" (count (into {} [[[5] :a] [[5.0] :b]])))))
(println "(count (into {} [[[5] :a] [[5] :b]]))" (count (into {} [[[5] :a] [[5] :b]])))
(println "(count (into #{} [[5] [5.0]]))" (count (into #{} [[5] [5.0]])))
(println "(= [5] [5.0])" (= [5] [5.0]))
(println "done")
