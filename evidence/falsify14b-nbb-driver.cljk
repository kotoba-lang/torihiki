;; falsify-14b nbb driver (frame 535) — owns the try/catch.
(require '["fs" :as fs])
(require '[torihiki.state :as st] '[torihiki.fixed :as fx])
(load-string (fs/readFileSync "evidence/falsify14b-multi-deficit.cljk" "utf8"))

(println (falsify14b-multi-deficit/header))

(defn- fmt-snap [[h s]]
  (str " k" (:k s)
       " d4 " (:d4 s) " d6 " (:d6 s)
       " c4 " (:c4 s) " c6 " (:c6 s)
       " root " (:root s)))

(defn- fmt-probe [r]
  (str "probe " (:probe r)
       (reduce (fn [acc [h s]] (str acc (fmt-snap [h s]))) "" (:snaps r))))

(println
 (try (fmt-probe (falsify14b-multi-deficit/probe-multi-account-accum))
   (catch js/Error e
     (falsify14b-multi-deficit/line-threw "multi-account-deficit-accum" e))))

(println "done")
