(ns torihiki.venue-test
  "The Venue port against the in-memory fake. No network, no real venue."
  (:require [kotoba.test :refer [deftest is testing]]
            [torihiki.fixed :as fx]
            [torihiki.venue :as v]
            [torihiki.venue-fake :as fake]
            [torihiki.venue-router :as r]))

(def eurusd {:digits 5 :volume-step "0.01" :volume-min "0.01" :volume-max "100"
             :trade-allowed? true})

(def entry {:market 1 :venue-symbol "EURUSD" :tick-size "0.00001" :lot-size "0.01"})

(defn- rig
  ([] (rig {}))
  ([limits]
   (let [f (fake/make {"EURUSD" eurusd} {"EURUSD" {:bid "1.08490" :ask "1.08500"}})]
     {:fake f :router (r/make (:venue f) [entry] limits)})))

(defn- buy [cid qty & {:as more}]
  (merge {:cid cid :market 1 :side :buy :qty qty} more))

;; ── exact decimals ──────────────────────────────────────────────────────────

(deftest decimals-never-touch-a-float
  (is (= {:units 108500 :scale 5} (v/parse-decimal "1.08500")))
  (is (= {:units -30 :scale 2} (v/parse-decimal "-0.30")))
  (doseq [bad ["" "1." ".5" "+1" "1e3" "1,5" " 1" "1 " "NaN" "0x10" nil 1.5
               "0.1234567890123"                 ; 13 fractional digits
               "9007199254740992"]]               ; past i53
    (is (nil? (v/parse-decimal bad)) (str "refused: " (pr-str bad)))))

(deftest count-of-is-exact-or-refuses
  (is (= 108500 (v/count-of "1.08500" "0.00001" :exact)))
  (is (= 30 (v/count-of "0.30" "0.01" :exact)))
  (testing "off the grid is refused, not rounded"
    (is (nil? (v/count-of "1.085005" "0.00001" :exact))))
  (testing "volume is cut toward zero, in both directions"
    (is (= 30 (v/count-of "0.309" "0.01" :trunc)))
    (is (= -30 (v/count-of "-0.309" "0.01" :trunc))))
  (is (nil? (v/count-of "1" "0" :exact)) "a zero unit is not a unit"))

(deftest string-of-round-trips
  (doseq [[n unit] [[108500 "0.00001"] [30 "0.01"] [-30 "0.01"] [5 "1"] [1 "0.001"] [0 "0.01"]]]
    (is (= n (v/count-of (v/string-of n unit) unit :exact))
        (str n " x " unit)))
  (is (= "0.04" (v/string-of 4 "0.01")))
  (is (= "-0.30" (v/string-of -30 "0.01")))
  (is (= "1.08500" (v/string-of 108500 "0.00001")))
  (is (nil? (v/string-of 9007199254740991 "0.10")) "overflow is refused"))

;; ── symbol map ──────────────────────────────────────────────────────────────

(deftest a-matching-entry-is-enabled
  (is (= [] (v/check-entry entry eurusd))))

(deftest a-mismatch-disables-the-market-and-says-why
  (is (= [:unknown-symbol] (v/check-entry entry nil)))
  (is (some #{:trading-disabled} (v/check-entry entry (assoc eurusd :trade-allowed? false))))
  (is (some #{:tick-finer-than-venue}
            (v/check-entry (assoc entry :tick-size "0.000001") eurusd)))
  (is (some #{:lot-not-a-venue-step}
            (v/check-entry (assoc entry :lot-size "0.015") eurusd)))
  (is (some #{:lot-below-venue-minimum}
            (v/check-entry (assoc entry :lot-size "0.001") (assoc eurusd :volume-step "0.001"))))
  (is (some #{:lot-above-venue-maximum}
            (v/check-entry (assoc entry :lot-size "1000") (assoc eurusd :volume-step "1"))))
  (is (some #{:bad-tick-size} (v/check-entry (assoc entry :tick-size "abc") eurusd))))

(deftest the-venue-changing-a-contract-disables-the-market
  (let [{:keys [fake router]} (rig)]
    (is (= :filled (:status (r/place! router (buy "a1" 5)))))
    (swap! (:state fake) assoc-in [:symbols "EURUSD" :volume-step] "0.10")
    (r/rebind! router)
    (let [res (r/place! router (buy "a2" 5))]
      (is (= :refused (:status res)))
      (is (= :market-disabled (:reason res))))))

(deftest an-unreachable-venue-disables-everything
  (let [f (fake/make {"EURUSD" eurusd} {})
        _ (fake/fault! f :symbol-info :unreachable)
        router (r/make (:venue f) [entry] {})]
    (is (= :refused (:status (r/place! router (buy "a1" 5)))))))

;; ── order translation ───────────────────────────────────────────────────────

(deftest engine-order-to-venue-request
  (is (= {:symbol "EURUSD" :side :buy :volume "0.30" :price "1.08500"
          :comment "t-1" :reduce-only? false}
         (v/->venue-order entry {:cid "t-1" :side :buy :qty 30 :price 108500})))
  (is (not (contains? (v/->venue-order entry {:cid "t-1" :side :sell :qty 1}) :price))
      "no price means market")
  (doseq [[bad why] [[{:cid "" :side :buy :qty 1} :bad-cid]
                     [{:cid (apply str (repeat 32 "x")) :side :buy :qty 1} :bad-cid]
                     [{:cid "a b" :side :buy :qty 1} :bad-cid]
                     [{:cid "a" :side :hold :qty 1} :bad-side]
                     [{:cid "a" :side :buy :qty 0} :bad-qty]
                     [{:cid "a" :side :buy :qty 1.5} :bad-qty]
                     [{:cid "a" :side :buy :qty 1 :price 0} :bad-price]]]
    (is (= {:error why} (v/->venue-order entry bad)) (pr-str bad))))

;; ── the fake's :place door ─────────────────────────────────────────────────

(deftest a-request-the-fake-cannot-execute-is-refused-whole
  (let [f (fake/make {"EURUSD" eurusd} {"EURUSD" {:bid "1.08490" :ask "1.08500"}})
        place (:place (:venue f))
        good {:symbol "EURUSD" :side :buy :volume "0.30" :comment "g1"}]
    (doseq [[req why] [[(dissoc good :side) :bad-side]                       ; missing side
                       [(assoc good :side :hold) :bad-side]                  ; over the set
                       [(assoc good :side "buy") :bad-side]                  ; not even a keyword
                       [(assoc good :symbol "GBPUSD") :unknown-symbol]       ; kept, moved into the door
                       [(assoc good :volume "0.015") :bad-volume]            ; off the step grid
                       [(assoc good :volume nil) :bad-volume]
                       [(assoc good :volume 0.3) :bad-volume]                ; not a string
                       [(assoc good :volume "1e2") :bad-volume]              ; exponent notation
                       [(assoc good :volume "-0.10") :bad-volume]            ; negative
                       [(assoc good :volume "0.00") :bad-volume]             ; zero
                       [(assoc good :volume "9007199254740992") :bad-volume] ; past i53
                       [(assoc good :price "abc") :bad-price]                ; not a decimal
                       [(assoc good :price "0.00") :bad-price]               ; not positive
                       [(assoc good :price "-1.08500") :bad-price]]]         ; negative
      (is (= {:error why} (place req)) (pr-str req))
      (is (= [] (:orders @(:state f))) (str "nothing landed: " (pr-str req)))
      (is (= {} (:positions @(:state f))) (str "no position: " (pr-str req))))
    (testing "the door still opens — and no refused request consumed a seq number"
      (is (= {:ok {:venue-order-id "V1" :status :filled}} (place good)))
      (is (= {"EURUSD" 30} (:positions @(:state f))))))
  (testing "a request never sent triggers no terminal fault"
    (let [f (fake/make {"EURUSD" eurusd} {"EURUSD" {:bid "1.08490" :ask "1.08500"}})
          place (:place (:venue f))]
      (fake/fault! f :place :unreachable)
      (is (= {:error :bad-side} (place {:symbol "EURUSD" :side :hold :volume "0.30"}))
          "the refusal comes from the door, before the fault machinery")
      (is (= [] (:orders @(:state f))))
      (is (= {} (:positions @(:state f))))
      (testing "the queued fault still fires for the request actually sent"
        (is (= {:error :unreachable} (place {:symbol "EURUSD" :side :buy :volume "0.30"})))
        (is (= [] (:orders @(:state f))))
        (is (= {} (:positions @(:state f))))))))

;; ── idempotency ─────────────────────────────────────────────────────────────

(deftest the-fake-itself-does-not-deduplicate
  (testing "so the tests below prove the router, not the fake"
    (let [{:keys [fake]} (rig)
          req (v/->venue-order entry (buy "dup" 5))]
      ((:place (:venue fake)) req)
      ((:place (:venue fake)) req)
      (is (= 2 (count (fake/orders-with-comment fake "dup")))))))

(deftest sending-the-same-order-twice-places-it-once
  (let [{:keys [fake router]} (rig)]
    (is (= :filled (:status (r/place! router (buy "o1" 5)))))
    (let [again (r/place! router (buy "o1" 5))]
      (is (= :filled (:status again)))
      (is (:repeat? again)))
    (is (= 1 (count (fake/orders-with-comment fake "o1"))))
    (is (= 5 (r/position router 1)))))

(deftest a-lost-reply-after-execution-is-recovered-not-resent
  (let [{:keys [fake router]} (rig)]
    (fake/fault! fake :place :timeout-after-accept)
    (is (= :unknown (:status (r/place! router (buy "o2" 5)))))
    (is (= 1 (count (fake/orders-with-comment fake "o2"))) "it did execute")
    (let [again (r/place! router (buy "o2" 5))]
      (is (= :filled (:status again)))
      (is (:recovered? again)))
    (is (= 1 (count (fake/orders-with-comment fake "o2"))) "and was not sent again")
    (is (= 5 (r/position router 1)))))

(deftest a-lost-request-is-resent-once-the-venue-shows-it-never-arrived
  (let [{:keys [fake router]} (rig)]
    (fake/fault! fake :place :timeout-before-accept)
    (is (= :unknown (:status (r/place! router (buy "o3" 5)))))
    (is (= 0 (count (fake/orders-with-comment fake "o3"))))
    (is (= :filled (:status (r/place! router (buy "o3" 5)))))
    (is (= 1 (count (fake/orders-with-comment fake "o3"))))))

(deftest when-the-venue-cannot-be-asked-nothing-is-sent
  (let [{:keys [fake router]} (rig)]
    (fake/fault! fake :place :timeout-after-accept)
    (r/place! router (buy "o4" 5))
    (fake/fault! fake :orders :unreachable)
    (let [res (r/place! router (buy "o4" 5))]
      (is (= :unknown (:status res)))
      (is (= :cannot-confirm (:reason res))))
    (is (= 1 (count (fake/orders-with-comment fake "o4"))) "no second order")
    (testing "history unreachable is just as unconfirmed"
      (fake/fault! fake :history :unreachable)
      (is (= :unknown (:status (r/place! router (buy "o4" 5)))))
      (is (= 1 (count (fake/orders-with-comment fake "o4")))))
    (testing "once it can be asked, the order is found"
      (is (= :filled (:status (r/place! router (buy "o4" 5)))))
      (is (= 1 (count (fake/orders-with-comment fake "o4")))))))

(deftest a-rejection-is-remembered
  (let [{:keys [fake router]} (rig)]
    (fake/fault! fake :place :reject)
    (is (= :rejected (:status (r/place! router (buy "o5" 5)))))
    (is (= :rejected (:status (r/place! router (buy "o5" 5))))
        "the same cid does not quietly retry a refusal")
    (is (= 0 (count (fake/orders-with-comment fake "o5"))))))

(deftest a-resting-order-does-not-count-as-position
  (let [{:keys [router]} (rig)]
    (is (= :resting (:status (r/place! router (buy "l1" 5 :price 108000)))))
    (is (= 0 (r/position router 1)))))

;; ── kill switch and limits ──────────────────────────────────────────────────

(deftest halt-blocks-exposure-but-not-closing
  (let [{:keys [fake router]} (rig)]
    (r/place! router (buy "h1" 10))
    (r/halt! router)
    (is (= :halted (:reason (r/place! router (buy "h2" 1)))))
    (is (= :halted (:reason (r/place! router {:cid "h3" :market 1 :side :sell :qty 1}))))
    (testing "a reduce-only close goes through"
      (is (= :filled (:status (r/place! router {:cid "h4" :market 1 :side :sell :qty 4
                                                :reduce-only? true}))))
      (is (= 6 (r/position router 1))))
    (testing "reduce-only must really reduce"
      (doseq [[cid side qty] [["h5" :buy 1] ["h6" :sell 7]]]
        (is (= :not-reducing
               (:reason (r/place! router {:cid cid :market 1 :side side :qty qty
                                          :reduce-only? true}))) cid)))
    (is (= 0 (count (fake/orders-with-comment fake "h2"))))
    (r/resume! router)
    (is (= :filled (:status (r/place! router (buy "h7" 1)))))))

(deftest limits-refuse-before-sending
  (let [{:keys [fake router]} (rig {1 {:max-order-qty 10 :max-position 15}})]
    (is (= :over-order-limit (:reason (r/place! router (buy "m1" 11)))))
    (is (= :filled (:status (r/place! router (buy "m2" 10)))))
    (is (= :over-position-limit (:reason (r/place! router (buy "m3" 6)))))
    (is (= :filled (:status (r/place! router (buy "m4" 5)))))
    (testing "the short side is bounded the same way (15 long -> 5 -> -5 -> -15 -> refused)"
      (is (= :filled (:status (r/place! router {:cid "m5" :market 1 :side :sell :qty 10}))))
      (is (= :filled (:status (r/place! router {:cid "m6" :market 1 :side :sell :qty 10}))))
      (is (= :filled (:status (r/place! router {:cid "m7" :market 1 :side :sell :qty 10}))))
      (is (= -15 (r/position router 1)))
      (is (= :over-position-limit
             (:reason (r/place! router {:cid "m8" :market 1 :side :sell :qty 1})))))
    (is (= 0 (count (fake/orders-with-comment fake "m1"))))
    (is (= 0 (count (fake/orders-with-comment fake "m3"))))))

;; ── reconciliation ──────────────────────────────────────────────────────────

(deftest agreement-is-ok
  (let [{:keys [router]} (rig)]
    (r/place! router (buy "r1" 7))
    (let [res (r/reconcile! router)]
      (is (:ok? res))
      (is (empty? (:diffs res)))
      (is (not (r/halted? router))))))

(deftest a-difference-halts
  (let [{:keys [fake router]} (rig)]
    (r/place! router (buy "r2" 7))
    (testing "the venue holds something we did not send"
      (swap! (:state fake) update-in [:positions "EURUSD"] + 3)
      (let [res (r/reconcile! router)]
        (is (not (:ok? res)))
        (is (= [{:market 1 :ours 7 :venue 10}] (:diffs res)))
        (is (r/halted? router))))))

(deftest an-unconfirmed-order-shows-up-as-a-difference
  (let [{:keys [fake router]} (rig)]
    (fake/fault! fake :place :timeout-after-accept)
    (r/place! router (buy "r3" 5))
    (let [res (r/reconcile! router)]
      (is (not (:ok? res)))
      (is (= [{:market 1 :ours 0 :venue 5}] (:diffs res)))
      (is (r/halted? router)))))

(deftest a-position-in-an-unmapped-symbol-halts
  (let [{:keys [fake router]} (rig)]
    (swap! (:state fake) assoc-in [:symbols "GBPUSD"] eurusd)
    (swap! (:state fake) assoc-in [:positions "GBPUSD"] 1)
    (let [res (r/reconcile! router)]
      (is (not (:ok? res)))
      (is (= ["GBPUSD"] (:unmapped res)))
      (is (r/halted? router)))))

(deftest an-unreadable-venue-halts
  (let [{:keys [fake router]} (rig)]
    (fake/fault! fake :positions :unreachable)
    (is (= {:ok? false :reason :venue-unreachable} (r/reconcile! router)))
    (is (r/halted? router))))

(deftest reconcile-sums-every-position-record-in-a-symbol
  ;; A hedging venue reports ONE RECORD PER POSITION: the same symbol can
  ;; appear several times in :positions. The comparison is against their SUM —
  ;; the last record standing is not the position.
  (let [multi (fn [& vols]
                (fn [] {:ok (mapv (fn [v] {:symbol "EURUSD" :volume v}) vols)}))]
    (testing "records 0.30 and -0.10 are the +20 lots we hold"
      (let [{:keys [router]} (rig)]
        (r/place! router (buy "s1" 20))
        (let [res (r/reconcile! (assoc-in router [:venue :positions]
                                          (multi "0.30" "-0.10")))]
          (is (:ok? res))
          (is (= [] (:diffs res)))
          (is (not (r/halted? router))))))
    (testing "a disagreement carried by the sum is still a disagreement"
      (let [{:keys [router]} (rig)]
        (r/place! router (buy "s2" 10))
        (let [res (r/reconcile! (assoc-in router [:venue :positions]
                                          (multi "0.30" "-0.10")))]
          (is (not (:ok? res)))
          (is (= [{:market 1 :ours 10 :venue 20}] (:diffs res)))
          (is (r/halted? router)))))
    (testing "one record off the lot grid poisons the whole position"
      (let [{:keys [router]} (rig)]
        (r/place! router (buy "s3" 20))
        (let [res (r/reconcile! (assoc-in router [:venue :positions]
                                          (multi "0.305" "-0.10")))]
          (is (not (:ok? res)))
          (is (= [{:market 1 :ours 20 :venue 20}] (:diffs res)))
          (is (r/halted? router)))))
    (testing "one unstateable record leaves the venue side unstated"
      (let [{:keys [router]} (rig)]
        (r/place! router (buy "s4" 20))
        (let [res (r/reconcile! (assoc-in router [:venue :positions]
                                          (multi "0.20" "junk")))]
          (is (not (:ok? res)))
          (is (= [{:market 1 :ours 20 :venue nil}] (:diffs res)))
          (is (r/halted? router)))))))

(deftest the-fake-conforms-to-the-contract
  (is (v/conforms? (:venue (:fake (rig)))))
  (is (not (v/conforms? (dissoc (:venue (:fake (rig))) :cancel)))))

;; ── the sums: every accumulator saturates at the domain edge ────────────────
;;
;; falsify-8's class, one port upstream. A raw `+` in an accumulator walks the
;; sum past 2^53 and the runtimes then hold different numbers (JVM exact, JS
;; rounded) with no throw anywhere — and these sums answer refusals and halt
;; the router. Every fold here goes through `torihiki.fixed/acc`: total, never
;; throws, one verdict at the edge on both runtimes. `position` folds the
;; ledger in cid order (the determinism contract's sorted fold) because a
;; saturating fold must have one order to have one answer.

(deftest the-fakes-position-sum-never-leaves-the-domain
  ;; one honest fill past the seeded edge lands on 2^53 + 1 — the falsify-13
  ;; crossing value, an odd number no double holds.
  (let [f (fake/make {"EURUSD" eurusd} {})
        place (:place (:venue f))]
    (swap! (:state f) assoc-in [:positions "EURUSD"] (- fx/i53-max 1))
    (is (= {:ok {:venue-order-id "V1" :status :filled}}
           (place {:symbol "EURUSD" :side :buy :volume "0.03" :comment "z1"})))
    (is (= fx/i53-max (get-in @(:state f) [:positions "EURUSD"])))
    (testing "the negative edge clamps the same way"
      (swap! (:state f) assoc-in [:positions "EURUSD"] (inc fx/i53-min))
      (place {:symbol "EURUSD" :side :sell :volume "0.03" :comment "z2"})
      (is (= fx/i53-min (get-in @(:state f) [:positions "EURUSD"]))))))

(deftest the-routers-position-sum-never-leaves-the-domain
  (testing "the long side clamps at the top edge (the true sum is 2^53 + 3)"
    (let [{:keys [router]} (rig)]
      (is (= :filled (:status (r/place! router (buy "z3" fx/i53-max)))))
      (is (= :filled (:status (r/place! router (buy "z4" 4)))))
      (is (= fx/i53-max (r/position router 1)))))
  (testing "the short side clamps at the bottom edge (the true sum is -(2^53 + 3))"
    (let [{:keys [router]} (rig)]
      (is (= :filled (:status (r/place! router {:cid "z5" :market 1 :side :sell
                                                :qty fx/i53-max}))))
      (is (= :filled (:status (r/place! router {:cid "z6" :market 1 :side :sell
                                                :qty 4}))))
      (is (= fx/i53-min (r/position router 1))))))

(deftest the-position-limit-door-sees-the-saturated-position
  ;; the refusal the clamp changes: at the edge `after` clamps, and the order
  ;; is judged against the bound the caller set — not against a sum the two
  ;; runtimes compute differently.
  (let [{:keys [router]} (rig {1 {:max-position fx/i53-max}})]
    (is (= :filled (:status (r/place! router (buy "z8" fx/i53-max)))))
    (is (= :filled (:status (r/place! router (buy "z9" 4)))))
    (is (= fx/i53-max (r/position router 1)))))

(deftest the-reconcile-sum-never-leaves-the-domain
  ;; two venue records whose sum crosses the edge: their SUM is compared
  ;; against ours, so both sides of the comparison fold through acc.
  (let [multi (fn [& vols]
                (fn [] {:ok (mapv (fn [v] {:symbol "EURUSD" :volume v}) vols)}))]
    (let [{:keys [router]} (rig)]
      (is (= :filled (:status (r/place! router (buy "z10" fx/i53-max)))))
      (let [res (r/reconcile! (assoc-in router [:venue :positions]
                                        (multi "90071992547409.91" "0.04")))]
        (is (:ok? res))
        (is (= [] (:diffs res)))
        (is (not (r/halted? router)))))))

;; ── the integer canon at the boundary: integers however typed ───────────────
;;
;; `integer?` is a TYPE test on the JVM (a Double is never an integer,
;; however whole) and a VALUE test on JS (every whole number is one) —
;; measured 2026-11-05 by evidence/probe-venue-integer-canon.cljk: the
;; SAME request with qty 3.0 was refused :bad-qty on the JVM and sent as
;; volume "0.03" on the JS leg, and price 3.0 met the same fork (:bad-
;; price vs "0.00003" sent). A request one runtime sends and the other
;; does not is two ledgers. The boundary judges torihiki.venue/int-like?
;; (provenance: api/int-like?, kotoba.spec.int-like) and computes on the
;; long — the same shape rule as every other door in the engine.

(deftest a-whole-double-qty-and-price-are-their-integers
  (is (= {:symbol "EURUSD" :side :buy :volume "0.03" :price "1.08500"
          :comment "t-1" :reduce-only? false}
         (v/->venue-order entry {:cid "t-1" :side :buy :qty 3.0 :price 108500}))
      "VALUE pin: qty 3.0 is 3 lots")
  (is (= "0.00003"
         (:price (v/->venue-order entry {:cid "t-1" :side :buy :qty 30 :price 3.0})))
      "VALUE pin: price 3.0 is 3 ticks")
  (testing "a fractional qty or price is refused whole (REASON pins)"
    (is (= {:error :bad-qty}
           (v/->venue-order entry {:cid "t-1" :side :buy :qty 2.5 :price 108500})))
    (is (= {:error :bad-price}
           (v/->venue-order entry {:cid "t-1" :side :buy :qty 30 :price 2.5})))))

(deftest the-value-guards-judge-whole-doubles-as-integers
  (is (= "0.03" (v/string-of 3.0 "0.01")) "VALUE pin: 3.0 whole units of 0.01")
  (is (= [] (v/check-entry {:market 1 :venue-symbol "EURUSD"
                            :tick-size "0.001" :lot-size "0.01"}
                           {:digits 3.0 :volume-step "0.01" :volume-min "0.01"
                            :volume-max "100.00" :trade-allowed? true}))
      "VALUE pin: digits 3.0 is a working digit count"))
