(ns torihiki.api-test
  "The property that matters most here is not that bad input is refused — it
  is that refusing it cannot stop the chain."
  (:require [kotoba.test :refer [deftest is testing]]
            [torihiki.book :as bk]
            [torihiki.clearing :as cl]
            [torihiki.api :as api]
            [torihiki.state :as st]
            [torihiki.auth :as auth]))

(def mkt (assoc (cl/market {:id 1 :max-leverage 40 :tick 1 :lot 1})
                :taker-fee-rate 350000 :maker-fee-rate 0))

(defn- fresh []
  (st/new-exchange {:market mkt :book-opts {:n-levels 4096 :cap 8192 :ev-cap 8192}}))

(defn- funded []
  (-> (fresh)
      (st/apply-tx {:tx :deposit :account 1 :amount 100000000})
      (st/apply-tx {:tx :deposit :account 2 :amount 100000000})
      (st/apply-tx {:tx :oracle :market 1 :price 1000})))

;; ── validation ──────────────────────────────────────────────────────────────

(deftest good-transactions-validate
  (let [ex (funded)]
    (doseq [t [{:tx :order :account 1 :market 1 :side 0 :level 999 :qty 5}
               {:tx :order :account 1 :market 1 :side 1 :level 1001 :qty 5 :flags 3}
               {:tx :cancel :market 1 :oid 12345}
               {:tx :deposit :account 1 :amount 10}
               {:tx :withdraw :account 1 :amount 10}
               {:tx :oracle :market 1 :price 1000}
               {:tx :funding-sample :market 1}
               {:tx :funding-settle :market 1}
               {:tx :liquidate :market 1}
               {:tx :trigger :account 1 :market 1 :trigger-price 900 :direction :below
                :order {:side 1 :level 0 :qty 5}}]]
      (is (nil? (api/validate ex t)) (str t)))))

(deftest every-rejection-is-in-the-closed-set
  (let [ex (funded)
        bad [{:tx :nonsense}
             {:tx :order :account 1 :market 99 :side 0 :level 1 :qty 1}
             {:tx :order :account "one" :market 1 :side 0 :level 1 :qty 1}
             {:tx :order :account 1 :market 1 :side 5 :level 1 :qty 1}
             {:tx :order :account 1 :market 1 :side 0 :level 1 :qty 0}
             {:tx :order :account 1 :market 1 :side 0 :level 1 :qty -3}
             {:tx :order :account 1 :market 1 :side 0 :level 999999 :qty 1}
             {:tx :order :account 1 :market 1 :side 0 :level -1 :qty 1}
             {:tx :order :account 1 :market 1 :side 0 :level 1 :qty 1 :flags 99}
             {:tx :deposit :account 1 :amount 0}
             {:tx :deposit :account 1 :amount -5}
             {:tx :cancel :market 1 :oid nil}
             {:tx :oracle :market 1 :price 0}
             {:tx :trigger :account 1 :market 1 :trigger-price 0 :direction :below
              :order {:side 1 :level 0 :qty 5}}
             {:tx :trigger :account 1 :market 1 :trigger-price 9 :direction :sideways
              :order {:side 1 :level 0 :qty 5}}
             {:tx :trigger :account 1 :market 1 :trigger-price 9 :direction :below
              :order {:side 1 :level 0 :qty 0}}]]
    (doseq [t bad]
      (let [r (api/validate ex t)]
        (is (some? r) (str "should be rejected: " t))
        (is (contains? api/reasons r)
            (str "reason " r " is outside the closed set, for " t))))))

;; ── the canon-collision door: refuse the merge, never perform it ───────────
;; Measured 2026-11-06 (probe ground truth in the 182x scoped record): on the
;; JVM, map keys whose CANON FORMS are `=` — `(into {} [[5 :a] [5.0 :b]])` —
;; are TWO distinct entries (Long 5 and Double 5.0 never merge at
;; construction), and `canon-tx`'s `(into {})` folds them into ONE with a
;; hash-order-local winner: one transaction, two successor states, decided by
;; iteration order, and `validate*` judges the ALREADY-MERGED tx — the loss
;; is invisible at every door. Same class at set elements and inside
;; composites. The fix is a door in front of the canon: a transaction whose
;; canon would lose an entry is refused `:canon-collision` and never merged.
;; On the JS legs the bare-vs-bare and composite classes collapse in the
;; CALLER (5 ≡ 5.0 at construction), so the same deftests pin the measured
;; VALUE answer there. The BigInt twin — untouched by the canon before the
;; BigInt door landed — collides like every other twin now: the wire refused
;; the pair while `validate` passed it (measured 2026-11-07,
;; evidence/probe-bigint-door.cljk — the validate/wire domain alignment is
;; the BigInt door's own), so every pair whose two entries survive
;; construction is `:canon-collision` on every leg. One `is` per line —
;; identical counters on all three legs.

(def ^:private collide-map
  "A map with two DISTINCT keys sharing one canon form. Constructed, never
  literal — the reader's duplicate-key check fires even in a skipped branch
  (log_test's `collide-map`, same construction, same reason) — and the
  constructible pair differs per runtime: the JVM keeps 5/5.0 apart while JS
  merges them at construction, leaving 5/(js/BigInt 5) as the JS pair (which
  the canon folds to one form like every other twin)."
  #?(:clj (into {} [[5 :a] [5.0 :b]])
     :cljs (into {} [[5 :a] [(js/BigInt 5) :b]])))

(def ^:private collide-set
  "The set twin of `collide-map`. Never a set literal: `#{5 5.0}` is a cljs
  reader error."
  #?(:clj (conj #{5} 5.0)
     :cljs (conj #{5} (js/BigInt 5))))

(deftest map-keys-that-collide-under-the-canon-are-refused-at-validate
  (let [ex (funded)]
    (is (= :canon-collision
           (api/validate ex {:tx :deposit :account 1 :amount 10 :extra collide-map}))
        "REASON literal — the two keys canonize to one form and (into {}) loses one")
    (is (= :canon-collision
           (api/validate ex {:tx :deposit :account 1 :amount 10
                             :extra (into {} [[5.0 :a]
                                              [#?(:clj (bigint 5) :cljs (js/BigInt 5)) :b]])}))
        "REASON literal — 5.0 and 5N are distinct keys on the JVM and canonize to one form")
    (is (= :canon-collision
           (api/validate ex (assoc collide-map :tx :deposit :account 1 :amount 10)))
        "REASON literal — a tx is a map: its own entry keys are judged at the same door")))

(deftest set-elements-that-collide-under-the-canon-are-refused-at-validate
  (is (= :canon-collision
         (api/validate (funded) {:tx :deposit :account 1 :amount 10 :extra collide-set}))
      "REASON literal — the set folds its colliding elements silently today"))

(deftest composite-keys-that-collide-under-the-canon-are-refused
  (is (= #?(:clj :canon-collision :cljs nil)
         (api/validate (funded) {:tx :deposit :account 1 :amount 10
                                 :extra (into {} [[[5] :a] [[5.0] :b]])}))
      "REASON literal — the vector keys [5] and [5.0] canonize to one form"))

(deftest collisions-are-refused-at-any-depth
  (let [ex (funded)]
    (is (= #?(:clj :canon-collision :cljs nil)
           (api/validate ex {:tx :deposit :account 1 :amount 10
                             :extra {:deep [(into {} [[5 :a] [5.0 :b]])]}}))
        "REASON literal — a colliding map inside a value is refused at the same door")
    (is (= #?(:clj :canon-collision :cljs nil)
           (api/validate ex {:tx :deposit :account 1 :amount 10
                             :extra {(into {} [[5 :a] [5.0 :b]]) :v}}))
        "REASON literal — a colliding map inside a KEY: the canon merges the key's own entries")))

(deftest clean-collections-still-validate
  ;; Over-refusal guard (VALUE pins, green from birth): only entries that
  ;; would actually MERGE are refused. NaN keys collide with nothing —
  ;; `(= ##NaN ##NaN)` is false and the canon merges nothing (the NaN pair
  ;; is refused at the no-wire-form door below, a different verdict for a
  ;; different reason — the wire THROWS on it).
  (let [ex (funded)]
    (is (nil? (api/validate ex {:tx :deposit :account 1 :amount 10 :extra {5 :a}}))
        "VALUE pin — a single key is never a collision")
    (is (nil? (api/validate ex {:tx :deposit :account 1 :amount 10 :extra {5 :a 6 :b}}))
        "VALUE pin — distinct canon forms pass")
    (is (nil? (api/validate ex {:tx :deposit :account 1 :amount 10 :extra #{5 6}}))
        "VALUE pin — distinct set elements pass")
    (is (nil? (api/validate ex {:tx :deposit :account 1 :amount 10
                                :extra {:m {5 :a} :v [[5] 5.0]}}))
        "VALUE pin — nested clean maps pass; a vector never merges its elements")))

(deftest the-canon-collision-reason-is-in-the-closed-set
  (is (contains? api/reasons :canon-collision)
      "the door's keyword joins the closed set — `reasons` is the whole list"))

(deftest a-colliding-transaction-is-rejected-never-a-halt
  (testing "the refusal is a rejection record — the apply path keeps its total contract"
    (let [ex (funded)
          ex' (st/apply-block ex {:height 1 :ts 1
                                  :txs [(assoc collide-map :tx :deposit :account 1 :amount 10)
                                        {:tx :order :account 2 :market 1 :side 0 :level 1001 :qty 5}
                                        {:tx :order :account 1 :market 1 :side 1 :level 1001 :qty 5}]})]
      (is (= [:canon-collision] (mapv :reason (:rejected ex'))))
      (is (= 5 (:size (cl/position (:clearing ex') 2 1)))
          "the good transactions on either side still executed")
      (is (= -5 (:size (cl/position (:clearing ex') 1 1)))))))

;; ── the BigInt door: one integer, one verdict ───────────────────────────────
;; Measured 2026-11-07 (evidence/probe-bigint-door.cljk, kbb + JVM): a true
;; BigInt is an INTEGER however the runtime types it — `clojure.lang.BigInt`
;; on the JVM, `js/BigInt` on the JS legs, where `(integer? (js/BigInt 5))` is
;; FALSE and `(number? ...)` is FALSE too. Before this door, `int-like?` (a
;; `number?`-shaped predicate) answered false for it on the JS legs, so the
;; SAME transaction was refused `:bad-quantity`/`:bad-amount` at one runtime's
;; validate and admitted at the other's (the JVM: `(integer? 5N)` is true) —
;; one transaction, two successor states, the falsify-6/7 class at the door.
;; And the wire (`torihiki.log/enc-val`, PR #109) encodes a BigInt bare or
;; under "u" digits on BOTH legs while `validate` refused it on the JS side:
;; the validate domain and the wire domain disagreed. This door aligns them —
;; `int-like?` accepts a true BigInt, the canon stores it as its long (exact
;; inside i53; `(long v)` THROWS on a SCI BigInt, measured — it converts
;; through `js/Number`), and the collision door's identity covers the twins
;; the wire refuses (numeric twins, in and out of i53) so no tx can pass
;; `validate` and then throw at the wire.

(def ^:private BI5 "BigInt 5 — the door's smallest integer, however typed."
  #?(:clj (bigint 5) :cljs (js/BigInt 5)))

(def ^:private BI10 #?(:clj (bigint 10) :cljs (js/BigInt 10)))

(def ^:private BI260 "2^60 — an integer, and outside every i53 door."
  #?(:clj (bigint 1152921504606846976) :cljs (js/BigInt 1152921504606846976)))

(def ^:private BI1e17 "BigInt 1e17 — whole, out of i53, exact digits."
  #?(:clj (bigint 1e17) :cljs (js/BigInt 1e17)))

(deftest a-bigint-is-judged-as-its-integer-at-every-door
  (let [ex (funded)]
    (is (nil? (api/validate ex {:tx :deposit :account 1 :amount BI10}))
        "VALUE pin — a BigInt amount is the integer 10 at the same door")
    (is (nil? (api/validate ex {:tx :order :account 1 :market 1 :side 0 :level 999 :qty BI5}))
        "VALUE pin — a BigInt qty is judged as 5, exactly like the long twin")))

(deftest the-canon-stores-a-bigint-as-its-long
  (is (= {:qty 5} (api/canon-tx {:qty BI5}))
      "VALUE pin — the stored form is the long; no BigInt reaches the slab")
  (is (= {:qty 2.5} (api/canon-tx {:qty 2.5}))
      "VALUE pin — a fractional double is untouched"))

(deftest out-of-domain-bigints-stay-refused-at-the-bounded-doors
  (let [ex (funded)]
    (is (= :bad-amount (api/validate ex {:tx :deposit :account 1 :amount BI260}))
        "REASON literal — 2^60 is out of i53 whatever type holds it")
    (is (= :bad-quantity (api/validate ex {:tx :order :account 1 :market 1 :side 0 :level 999 :qty BI260}))
        "REASON literal — the qty bound is a value bound, not a type bound")))

(deftest numeric-twins-the-wire-refuses-are-refused-at-validate
  ;; The validate/wire domain alignment, measured (probe-bigint-door): the
  ;; wire's collision doors refuse these pairs — its criterion is the decoded
  ;; canon form, where an out-of-domain whole number is its exact "u" digits —
  ;; while `validate` passed them and the throw surfaced AT THE WIRE, one
  ;; signed transaction from an apply-path halt. The collision door refuses
  ;; exactly the pairs whose canon forms are one form, in i53 (the BigInt twin
  ;; folds to its long) and out of it (the twins share their digits).
  (let [ex (funded)]
    (is (= :canon-collision
           (api/validate ex {:tx :deposit :account 1 :amount 10
                             :extra (into {} [[1e17 :a] [BI1e17 :b]])}))
        "REASON literal — 1e17 and its BigInt twin decode to one wire form")
    (is (= :canon-collision
           (api/validate ex {:tx :deposit :account 1 :amount 10
                             :extra (into #{} [1e17 BI1e17])}))
        "REASON literal — set elements at the same door")))

(deftest distinct-numeric-forms-still-validate
  ;; Over-refusal guard (VALUE pins, green from birth): twins refuse, distinct
  ;; forms pass — the door refuses exactly what the wire refuses.
  (let [ex (funded)]
    (is (nil? (api/validate ex {:tx :deposit :account 1 :amount 10
                                :extra (into {} [[1e17 :a] [2e17 :b]])}))
        "VALUE pin — distinct digits are distinct forms")
    (is (nil? (api/validate ex {:tx :deposit :account 1 :amount 10
                                :extra (into {} [[BI5 :a] [6 :b]])}))
        "VALUE pin — a BigInt key's neighbor pair is clean")))

(deftest a-bigint-transaction-is-applied-or-rejected-never-a-halt
  (testing "the BigInt door is a verdict like any other — the apply path keeps its total contract"
    (let [ex (funded)
          ex' (st/apply-block ex {:height 1 :ts 1
                                  :txs [{:tx :deposit :account 1 :amount BI10}
                                        {:tx :deposit :account 1 :amount BI260}
                                        {:tx :deposit :account 2 :amount 5}]})]
      (is (= [:bad-amount] (mapv :reason (:rejected ex')))
          "REASON literal — only the out-of-domain twin is refused, and as a record")
      (is (= 100000010 (get-in ex' [:clearing :accounts 1 :collateral]))
          "VALUE pin — the in-domain BigInt deposit applied, stored as its long")
      (is (= 100000005 (get-in ex' [:clearing :accounts 2 :collateral]))
          "VALUE pin — the good transaction on either side of the refusal still executed"))))

;; ── the no-wire-form door: what the wire cannot encode, validate refuses ───
;; Measured 2026-11-07 (the PR #111 carry): a value the wire could never
;; encode — NaN, a function, a symbol, a list, and on the JVM a Ratio or a
;; BigDecimal outside the bare route — passed `validate` and threw
;; "value has no wire form" AT THE WIRE (`torihiki.log/enc-val`), one signed
;; transaction from a halted commit. The wire's loud refusal is not a
;; validate verdict only because no door asked the question; the canon has
;; NOT made the value decision a Ratio's wire form would be (the
;; `torihiki.log/wire-number?` note), so the answer is the wire's own: the
;; value is refused, at validate, with a keyword from `reasons`. The door
;; judges the CANONIZED transaction — exactly the values `enc-val` will see
;; — so the canon's declared decisions survive: an in-domain whole value
;; however typed (5.0, BigDecimal 5, BigInt 5) becomes its long and passes.

(deftest a-value-with-no-wire-form-is-refused-at-validate
  (let [ex (funded)]
    (is (= :no-wire-form
           (api/validate ex {:tx :deposit :account 1 :amount 10 :extra ##NaN}))
        "REASON literal — NaN has no canonical form and the wire throws on it")
    (is (= :no-wire-form
           (api/validate ex {:tx :deposit :account 1 :amount 10 :extra (fn [] 1)}))
        "REASON literal — a function has no wire form")
    (is (= :no-wire-form
           (api/validate ex {:tx :deposit :account 1 :amount 10 :extra (symbol "x")}))
        "REASON literal — a symbol has no wire form")
    (is (= :no-wire-form
           (api/validate ex {:tx :deposit :account 1 :amount 10 :extra (list 1)}))
        "REASON literal — a list has no wire form (the wire takes vectors only)")
    (is (= #?(:clj :no-wire-form :cljs nil)
           (api/validate ex {:tx :deposit :account 1 :amount 10 :extra (/ 2 3)}))
        "REASON literal — a JVM Ratio has no wire form; the same source text
         is a fractional DOUBLE on the JS legs, which the wire encodes under \"d\"")
    (is (= #?(:clj :no-wire-form :cljs nil)
           (api/validate ex {:tx :deposit :account 1 :amount 10
                             :extra #?(:clj (bigdec "1.5") :cljs 1.5)}))
        "REASON literal — a fractional BigDecimal has no wire form; the JS
         stand-in is the double the wire carries under \"d\"")
    (is (= #?(:clj :no-wire-form :cljs nil)
           (api/validate ex {:tx :deposit :account 1 :amount 10
                             :extra #?(:clj (bigdec "1e17") :cljs 1e17)}))
        "REASON literal — whole, OUT of i53, and still no wire form: a
         BigDecimal is not `wire-number?`, so neither \"u\" nor \"d\" takes it
         (the int-like? trap — the JS double 1e17 rides \"u\" digits)")))

(deftest no-wire-form-is-refused-at-any-depth
  (let [ex (funded)]
    (is (= :no-wire-form
           (api/validate ex {:tx :deposit :account 1 :amount 10 :extra {:deep [(list 1)]}}))
        "REASON literal — nested inside a value, like the collision door")
    (is (= :no-wire-form
           (api/validate ex {:tx :deposit :account 1 :amount 10 :extra {(fn [] 1) :v}}))
        "REASON literal — a map KEY is encoded too; the walk covers keys")
    (is (= :no-wire-form
           (api/validate ex {:tx :deposit :account 1 :amount 10 :extra #{(symbol "x")}}))
        "REASON literal — a set element at the same door")
    (is (= :no-wire-form
           (api/validate ex {:tx :deposit :account 1 :amount 10
                             :extra (into {} [[##NaN :a] [##NaN :b]])}))
        "REASON literal — NaN keys collide with NOTHING (not :canon-collision)
         but the wire throws on them; they are refused here instead")))

(deftest values-with-wire-form-still-validate
  ;; Over-refusal guard (VALUE pins): the door refuses exactly the wire's
  ;; loud-refusal domain, nothing else.
  (let [ex (funded)]
    (is (nil? (api/validate ex {:tx :deposit :account 1 :amount 10 :extra 5.5}))
        "VALUE pin — a fractional double is the wire's \"d\" route")
    (is (nil? (api/validate ex {:tx :deposit :account 1 :amount 10 :extra 1e17}))
        "VALUE pin — an out-of-domain whole double is the wire's \"u\" route")
    (is (nil? (api/validate ex {:tx :deposit :account 1 :amount 10 :extra "s"}))
        "VALUE pin — strings, keywords, booleans and nil are bare wire forms")
    (is (nil? (api/validate ex {:tx :deposit :account 1 :amount 10
                                :extra {:k [1 "a" :b true nil 5.0 #{5}]}}))
        "VALUE pin — clean composites pass at every depth")
    (is (nil? (api/validate ex {:tx :deposit :account 1 :amount 10
                                :extra #?(:clj (bigint 5) :cljs (js/BigInt 5))}))
        "VALUE pin — a BigInt has a wire form (bare or \"u\", PR #111's door)")
    (is (nil? (api/validate ex {:tx :deposit :account 1 :amount 10
                                :extra #?(:clj (bigdec "5") :cljs 5)}))
        "VALUE pin — an in-domain whole BigDecimal is the canon's long; the
         canon's decision is honored and the stored form encodes")))

(deftest the-no-wire-form-reason-is-in-the-closed-set
  (is (contains? api/reasons :no-wire-form)
      "the door's keyword joins the closed set — `reasons` is the whole list"))

(deftest a-no-wire-form-transaction-is-rejected-never-a-halt
  (testing "the refusal is a rejection record — the apply path keeps its total contract"
    (let [ex (funded)
          ex' (st/apply-block ex {:height 1 :ts 1
                                  :txs [{:tx :deposit :account 2 :amount 5}
                                        {:tx :deposit :account 1 :amount 5 :extra (fn [] 1)}
                                        {:tx :deposit :account 2 :amount 7}]})]
      (is (= [:no-wire-form] (mapv :reason (:rejected ex')))
          "REASON literal — refused as a record, at the stated door")
      (is (= [1] (mapv :index (:rejected ex'))))
      (is (= 100000000 (get-in ex' [:clearing :accounts 1 :collateral]))
          "VALUE pin — the refused deposit credits nothing")
      (is (= 100000012 (get-in ex' [:clearing :accounts 2 :collateral]))
          "VALUE pin — the good transactions on either side of the refusal still executed"))))

;; ── the liveness property ───────────────────────────────────────────────────

(deftest a-malformed-transaction-cannot-halt-a-block
  (testing "the whole reason validation was pulled out of apply-tx"
    (let [ex (funded)
          block {:height 1 :ts 1
                 :txs [{:tx :order :account 1 :market 1 :side 1 :level 1001 :qty 5}
                       ;; a level far outside the ladder — this used to throw
                       {:tx :order :account 2 :market 1 :side 0 :level 99999999 :qty 5}
                       {:tx :nonsense :market 1}
                       {:tx :order :account 2 :market 1 :side 0 :level 1001 :qty 5}]}
          ex' (st/apply-block ex block)]
      (is (= 2 (count (:rejected ex'))) "both bad ones were refused")
      (is (= [:bad-price-level :unknown-tx] (mapv :reason (:rejected ex'))))
      (is (= [1 2] (mapv :index (:rejected ex')))
          "the index identifies which transaction was refused")
      (testing "and the good transactions on either side of them still executed"
        (is (= 5 (:size (cl/position (:clearing ex') 2 1))))
        (is (= -5 (:size (cl/position (:clearing ex') 1 1))))))))

(deftest a-block-of-nothing-but-garbage-still-produces-a-state
  (let [ex (funded)
        ex' (st/apply-block ex {:height 1 :ts 1
                                :txs (vec (repeat 50 {:tx :order :account 1 :market 1
                                                      :side 9 :level -7 :qty -1}))})]
    (is (= 50 (count (:rejected ex'))))
    (is (string? (st/state-root ex')))))

(deftest the-root-commits-to-what-was-refused
  (testing "a sequencer must not be able to drop a transaction invisibly"
    (let [ex (funded)
          good {:tx :order :account 1 :market 1 :side 1 :level 1001 :qty 5}
          bad {:tx :order :account 1 :market 1 :side 0 :level 99999999 :qty 5}
          with-bad (st/apply-block ex {:height 1 :ts 1 :txs [good bad]})
          without (st/apply-block (funded) {:height 1 :ts 1 :txs [good]})]
      (is (= 1 (count (:rejected with-bad))))
      (is (= 0 (count (:rejected without))))
      (is (not= (st/state-root with-bad) (st/state-root without))
          "identical executed effects, different rejections, different root"))))

;; ── read models ─────────────────────────────────────────────────────────────

(deftest book-snapshot-is-client-shaped
  (let [ex (-> (funded)
               (st/apply-tx {:tx :order :account 1 :market 1 :side 0 :level 998 :qty 30})
               (st/apply-tx {:tx :order :account 1 :market 1 :side 0 :level 999 :qty 10})
               (st/apply-tx {:tx :order :account 2 :market 1 :side 1 :level 1001 :qty 20}))
        snap (api/book-snapshot ex 1 5)]
    (is (= [999 998] (mapv :level (:bids snap))) "best first")
    (is (= [10 40] (mapv :cum (:bids snap))) "cumulative running total")
    (is (= [1001] (mapv :level (:asks snap))))
    (is (= 3 (:resting snap)))))

(deftest account-state-answers-can-i-open-this
  (let [ex (-> (funded)
               (st/apply-tx {:tx :order :account 2 :market 1 :side 1 :level 1001 :qty 50})
               (st/apply-tx {:tx :order :account 1 :market 1 :side 0 :level 1001 :qty 20}))
        a (api/account-state ex 1)]
    (is (= 1 (:account a)))
    (is (= 20 (get-in a [:positions 1 :size])))
    (is (pos? (:equity a)))
    (is (pos? (:initial-margin a)))
    (is (= (:free-collateral a)
           (max 0 (- (:equity a) (:initial-margin a))))
        "free collateral is equity less what open positions already consume")
    (is (false? (:liquidatable a)))))

(deftest account-state-surfaces-triggers
  (let [ex (-> (funded)
               (st/apply-tx {:tx :order :account 2 :market 1 :side 1 :level 1001 :qty 50})
               (st/apply-tx {:tx :order :account 1 :market 1 :side 0 :level 1001 :qty 20})
               (st/apply-tx {:tx :trigger :account 1 :market 1
                             :trigger-price 900 :direction :below
                             :order {:side 1 :level 0 :qty 20}}))
        a (api/account-state ex 1)]
    (is (= 1 (count (:triggers a))))
    (is (= 900 (:trigger-price (first (:triggers a)))))
    (is (= 1 (:market (first (:triggers a)))))))

(deftest market-info-has-no-internals
  (let [m (api/market-info (funded) 1)]
    (is (= 40 (:max-leverage m)))
    (is (pos? (:maintenance-margin-rate m)))
    (is (contains? m :mark))
    (is (contains? m :last))
    (is (not (contains? m :books)) "read models do not hand back the slab layout")))

;; ── open-interest cap ───────────────────────────────────────────────────────

(def capped (assoc (cl/market {:id 1 :max-leverage 40 :tick 1 :lot 1
                               :open-interest-cap 200})
                   :taker-fee-rate 0 :maker-fee-rate 0))

(defn- capped-ex []
  (-> (st/new-exchange {:market capped :book-opts {:n-levels 4096 :cap 8192 :ev-cap 8192}})
      (st/apply-tx {:tx :deposit :account 1 :amount 100000000})
      (st/apply-tx {:tx :deposit :account 2 :amount 100000000})
      (st/apply-tx {:tx :oracle :market 1 :price 1000})))

(deftest an-order-within-the-cap-is-allowed
  (is (nil? (api/validate (capped-ex)
                          {:tx :order :account 1 :market 1 :side 1 :level 1001 :qty 150}))))

(deftest an-order-that-could-breach-the-cap-is-refused
  (is (= :open-interest-cap
         (api/validate (capped-ex)
                       {:tx :order :account 1 :market 1 :side 1 :level 1001 :qty 500}))))

(deftest the-cap-counts-what-is-already-open
  (let [ex (-> (capped-ex)
               (st/apply-tx {:tx :order :account 1 :market 1 :side 1 :level 1001 :qty 150})
               (st/apply-tx {:tx :order :account 2 :market 1 :side 0 :level 1001 :qty 150}))]
    (is (= 150 (cl/open-interest (:clearing ex) 1)))
    (is (= :open-interest-cap
           (api/validate ex {:tx :order :account 1 :market 1 :side 1 :level 1002 :qty 60}))
        "150 open + 60 would pass 200")
    (is (nil? (api/validate ex {:tx :order :account 1 :market 1 :side 1 :level 1002 :qty 40})))))

(deftest a-market-without-a-cap-is-unconstrained
  (is (nil? (api/validate (funded)
                          {:tx :order :account 1 :market 1 :side 1 :level 1001 :qty 99999}))))

(deftest the-cap-blocks-a-block-rather-than-halting-it
  (let [ex (st/apply-block (capped-ex)
                           {:height 1 :ts 1
                            :txs [{:tx :order :account 1 :market 1 :side 1 :level 1001 :qty 500}
                                  {:tx :order :account 1 :market 1 :side 1 :level 1001 :qty 50}]})]
    (is (= [:open-interest-cap] (mapv :reason (:rejected ex))))
    (is (= 50 (bk/level-qty (get-in ex [:books 1]) bk/ask 1001))
        "the second order still executed")))

;; ── where collateral comes from ─────────────────────────────────────────────

(defn- bridged
  "An exchange whose only source of collateral is account 900."
  []
  (st/new-exchange {:market (cl/market {:id 1 :max-leverage 20 :tick 10 :lot 1})
                    :book-opts {:n-levels 4096 :cap 4096 :ev-cap 4096}
                    :bridge-authority 900}))

(deftest without-a-bridge-any-account-credits-itself
  (testing "the default, and the reason the default has to be stated: every
            margin, liquidation and ADL number is exact arithmetic over
            collateral that was conjured"
    (is (nil? (api/validate (fresh) {:tx :deposit :account 7 :amount 1000})))))

(deftest with-a-bridge-only-the-bridge-credits
  (let [ex (bridged)]
    (is (nil? (api/validate ex {:tx :deposit :account 900 :amount 1000})))
    (is (= :not-the-bridge (api/validate ex {:tx :deposit :account 7 :amount 1000}))
        "an account that can credit itself is not depositing, it is minting")))

(deftest the-bridge-does-not-get-to-skip-the-shape-checks
  (let [ex (bridged)]
    (is (= :bad-amount (api/validate ex {:tx :deposit :account 900 :amount 0})))
    (is (= :bad-amount (api/validate ex {:tx :deposit :account 900 :amount -5})))))

(deftest a-holder-still-withdraws-without-asking-the-bridge
  (testing "the signature is the whole authority for moving your own
            collateral out, and the clearinghouse already refuses to take more
            than is free"
    (let [ex (bridged)]
      (is (nil? (api/validate ex {:tx :withdraw :account 7 :amount 1000})))
      (is (= :bad-amount (api/validate ex {:tx :withdraw :account 7 :amount 0}))))))

(deftest a-refused-deposit-credits-nothing
  (testing "asserted through apply-block, because validate returning a keyword
            and the balance moving anyway is exactly the failure a shape test
            cannot see"
    (let [ex (st/apply-block (bridged)
                             {:height 1 :ts 1000
                              :txs [{:tx :deposit :account 7 :amount 5000}
                                    {:tx :deposit :account 900 :amount 5000}]})]
      (is (= [:not-the-bridge] (mapv :reason (:rejected ex))))
      (is (= 0 (get-in ex [:clearing :accounts 7 :collateral] 0)))
      (is (= 5000 (get-in ex [:clearing :accounts 900 :collateral] 0))))))

(deftest account-state-says-which-nonce-is-next-and-who-owns-the-id
  (testing "a client that tracks its own nonce drifts the moment a request is
            lost in flight, and one that cannot see the binding discovers it as
            a rejection after signing"
    (let [ex (fresh)]
      (is (= 1 (:next-nonce (api/account-state ex 7))))
      (is (nil? (:bound-key (api/account-state ex 7))))
      (let [ex (auth/accept ex {:account 7 :nonce 1 :pubkey "pk-7"})]
        (is (= 2 (:next-nonce (api/account-state ex 7))))
        (is (= "pk-7" (:bound-key (api/account-state ex 7))))
        (is (nil? (:bound-key (api/account-state ex 8))) "a different id is free")))))

;; ── the bridge pays somebody other than itself ──────────────────────────────

(deftest a-bridge-may-credit-another-account
  (let [ex (assoc (fresh) :bridge-authority 7)]
    (is (nil? (api/validate ex {:tx :deposit :account 7 :credit 42 :amount 100})))))

(deftest only-the-bridge-may-deposit-when-one-is-configured
  (let [ex (assoc (fresh) :bridge-authority 7)]
    (is (= :not-the-bridge
           (api/validate ex {:tx :deposit :account 9 :credit 9 :amount 100})))
    (is (= :not-the-bridge
           (api/validate ex {:tx :deposit :account 9 :credit 42 :amount 100})))))

(deftest without-a-bridge-an-account-may-only-pay-itself
  ;; Not a safety property on its own — with no authority anyone can mint
  ;; anyway — but crediting a stranger is a way to obscure where collateral
  ;; came from on a chain where the mint is meant to be the only source.
  (let [ex (fresh)]
    (is (nil? (api/validate ex {:tx :deposit :account 9 :amount 100})))
    (is (nil? (api/validate ex {:tx :deposit :account 9 :credit 9 :amount 100})))
    (is (= :not-the-bridge
           (api/validate ex {:tx :deposit :account 9 :credit 42 :amount 100})))))

(deftest a-credit-that-is-not-an-account-is-refused
  (let [ex (assoc (fresh) :bridge-authority 7)]
    (is (= :bad-account
           (api/validate ex {:tx :deposit :account 7 :credit "42" :amount 100})))))

(deftest order-id-zero-is-a-real-order
  ;; `bk/oid-of` is `slot * gen-mod + generation`, so the first order to occupy
  ;; slot 0 has id 0. `validate` required `pos?`, which made that order
  ;; uncancellable by anybody — seen on the deployed chain, where `/orders`
  ;; showed a resting order with `"oid":0`.
  (let [ex (st/new-exchange {:market mkt :book-opts {:n-levels 256 :cap 1024 :ev-cap 1024}})]
    (is (nil? (api/validate ex {:tx :cancel :account 1 :market 1 :oid 0}))
        "order id 0 must be accepted")
    (is (= :missing-field (api/validate ex {:tx :cancel :account 1 :market 1 :oid -1}))
        "and a negative id must still be refused")
    (is (= :missing-field (api/validate ex {:tx :cancel :account 1 :market 1 :oid "0"}))
        "and a non-integer id must still be refused")))

(deftest the-authority-may-open-an-unpriced-market-once
  ;; A market listed on a running chain arrives with no price, and nothing can
  ;; give it one: publishers MOVE a price, and the direct setter is shut when
  ;; publishers exist. Without this the market could be traded and never
  ;; margined, at a mark of zero.
  (let [ex (-> (st/new-exchange {:market mkt :book-opts {:n-levels 256 :cap 1024 :ev-cap 1024}})
               (assoc :oracle-publishers #{5 6 7} :bridge-authority 77))]
    (is (nil? (api/validate ex {:tx :oracle :account 77 :market 1 :price 500}))
        "the authority could not open an unpriced market")
    (is (= :oracle-is-aggregated
           (api/validate ex {:tx :oracle :account 78 :market 1 :price 500}))
        "a stranger opened it")
    ;; and once it has a price the door is shut again, for everybody
    (let [priced (st/apply-tx ex {:tx :oracle :account 77 :market 1 :price 500})]
      (is (= :oracle-is-aggregated
             (api/validate priced {:tx :oracle :account 77 :market 1 :price 9}))
          "the authority could set the price twice"))))
