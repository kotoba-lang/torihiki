(ns torihiki.log-test
  (:require [kotoba.test :refer [deftest is testing]]
            [chain.core :as chain]
            [ipld.core :as ipld]
            [torihiki.book :as bk]
            [torihiki.clearing :as cl]
            [torihiki.state :as st]
            [torihiki.log :as log]))

(def mkt (cl/market {:id 1 :max-leverage 40 :tick 1 :lot 1}))

(defn- fresh [] (st/new-exchange {:market mkt
                                  :book-opts {:n-levels 4096 :cap 8192 :ev-cap 8192}}))

(defn- store []
  (let [s (atom {})]
    {:put! (fn [cid bytes] (swap! s assoc cid bytes))
     :get-fn (fn [cid] (get @s cid))
     :raw s}))

(defn- blocks []
  [{:height 1 :ts 100
    :txs [{:tx :deposit :account 10 :amount 1000000}
          {:tx :deposit :account 11 :amount 1000000}]}
   {:height 2 :ts 200
    :txs [{:tx :order :account 10 :market 1 :side bk/ask :level 1000 :qty 5}
          {:tx :order :account 11 :market 1 :side bk/bid :level 1000 :qty 3}]}
   {:height 3 :ts 300
    :txs [{:tx :oracle :market 1 :price 1000}
          {:tx :order :account 11 :market 1 :side bk/bid :level 1000 :qty 2}]}])

;; ── wire codec ──────────────────────────────────────────────────────────────

(deftest wire-round-trip
  (doseq [tx (mapcat :txs (blocks))]
    (is (= tx (log/wire->tx (log/tx->wire tx))) (str "round trip " (:tx tx)))))

(deftest wire-covers-the-engine-vocabulary
  ;; The codec grew stale once already: it whitelisted eight kinds and ten
  ;; integer fields while `apply-tx` dispatched forty-plus kinds carrying
  ;; keywords, strings and nested maps. A `:trigger` never reached the wire
  ;; and its `:order` did not survive even when it did. These shapes are the
  ;; vocabulary the engine accepts today; every one must round-trip EXACTLY.
  (doseq [[label tx] [["trigger: nested :order, keyword :direction"
                       {:tx :trigger :account 1 :market 1 :trigger-price 900
                        :direction :below :order {:side 1 :level 0 :qty 5}}]
                      ["amend"
                       {:tx :amend :account 1 :market 1 :oid 3 :level 2 :qty 4}]
                      ["cancel-all"
                       {:tx :cancel-all :account 1 :market 1}]
                      ["list-market: nested :spec with keyword values"
                       {:tx :list-market :account 1 :market 7
                        :spec {:kind :perp :tick 10 :lot 2 :max-leverage 20}
                        :book-opts {:n-levels 1024 :cap 4096 :ev-cap 4096}}]
                      ["authorize-agent: string field"
                       {:tx :authorize-agent :account 1
                        :agent "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
                        :expires 100}]
                      ["anchor: string :cid"
                       {:tx :anchor :account 1 :cid "bafyfake"}]
                      ["fields the codec does not know survive untouched"
                       {:tx :deposit :account 1 :amount 5 :junk "x" :a/y 6}]]]
    (is (= tx (log/wire->tx (log/tx->wire tx))) (str "round trip " label))))

(deftest wire-round-trips-what-the-engine-rejects
  ;; FIDELITY, not validation: a refused transaction is part of the block's
  ;; outcome (`:rejected` lands in the state root), so the log must record it
  ;; exactly as submitted — and `commit-block!` wraps `apply-block`, whose
  ;; liveness contract ("never thrown from") the codec used to break one layer
  ;; up: one malformed tx and the sequencer could not commit the block at all.
  (doseq [tx [{:tx :not-a-real-kind :account 1}
              {:tx :deposit :account 1 :amount "lots"}
              ;; Both of these are :unknown-tx to the engine — and both must
              ;; still round-trip exactly. A bare string kind is what every
              ;; old committed block meant (a keyword kind), so a STRING
              ;; kind tags apart from it, and a namespaced keyword kind is
              ;; not `str`'s colon-prefixed form.
              {:tx "deposit" :account 1}
              {:tx :some.ns/kind :account 1}]]
    (is (= tx (log/wire->tx (log/tx->wire tx))) (str "round trip " (:tx tx)))))

(deftest wire-rejects-what-it-cannot-validate
  ;; What must not reach the wire is a value with NO wire form — anything the
  ;; codec cannot reproduce exactly. Everything EDN-shaped round-trips and is
  ;; refused (or applied) by `torihiki.api`, where refusals have reasons.
  (is (thrown? #?(:clj Exception :cljs :default)
               (log/tx->wire {:tx :deposit :account 1 :amount (fn [x] x)}))
      "a value with no wire form must not reach the wire"))

(deftest a-malformed-tx-is-rejected-into-the-root-not-thrown
  (let [{:keys [put! get-fn]} (store)
        r (log/commit-blocks! (fresh) put! get-fn nil
                              [{:height 1 :ts 100
                                :txs [{:tx :deposit :account 1 :amount "lots"}
                                      {:tx :not-a-real-kind :account 1}]}])]
    (is (= 1 (count (:roots r))) "the block commits — no throw at the codec")
    (is (= [{:index 0 :tx :deposit :reason :bad-amount}
            {:index 1 :tx :not-a-real-kind :reason :unknown-tx}]
           (:rejected (:exchange r)))
        "rejections are part of the outcome")
    (is (:ok (log/replay get-fn (:cid r) fresh))
        "replay agrees on the rejections")))

(deftest an-infinite-amount-is-rejected-into-the-root-not-thrown
  ;; The door predicate (`torihiki.api/int-like?`) judged whole-ness with
  ;; `rem` — which THROWS on an infinity on the JVM ("Infinite or NaN"; the
  ;; JVM's remainder is BigDecimal-backed) and lands on NaN on JS. One
  ;; signed tx with :amount ##Inf halted the JVM sequencer inside
  ;; apply-block ("never thrown from" broken at the door) while the JS leg
  ;; answered :bad-amount — falsify-6/7 class. A non-finite number is not
  ;; whole; that is answered BEFORE `rem`, identically on both runtimes.
  ;; End to end through the codec: the block COMMITS, each tx lands
  ;; :rejected into the root, replay agrees.
  (let [{:keys [put! get-fn]} (store)
        r (log/commit-blocks! (fresh) put! get-fn nil
                              [{:height 1 :ts 100
                                :txs [{:tx :deposit :account 1 :amount ##Inf}
                                      {:tx :deposit :account 1 :amount ##-Inf}]}])]
    (is (= 1 (count (:roots r)))
        "the block commits — no throw at the door or the codec")
    (is (= [{:index 0 :tx :deposit :reason :bad-amount}
            {:index 1 :tx :deposit :reason :bad-amount}]
           (:rejected (:exchange r)))
        "an infinity is a bad amount, like every out-of-range number")
    (is (:ok (log/replay get-fn (:cid r) fresh))
        "replay agrees on the rejections")))

;; ── producing and checking ──────────────────────────────────────────────────

(deftest log-is-well-formed-and-replays
  (let [{:keys [put! get-fn]} (store)
        r (log/commit-blocks! (fresh) put! get-fn nil (blocks))]
    (testing "the chain itself is intact"
      (is (chain/verify-chain get-fn (:cid r))))
    (testing "and replay agrees with every recorded root"
      (let [v (log/replay get-fn (:cid r) fresh)]
        (is (:ok v))
        (is (= 3 (:blocks v)))))
    (testing "the tip root matches what a replay recomputes"
      (is (= (log/tip-root get-fn (:cid r))
             (st/state-root (:exchange (log/replay get-fn (:cid r) fresh))))))
    (testing "the roots actually differ block to block"
      (is (= 3 (count (distinct (:roots r))))
          "identical roots would mean the blocks did nothing"))))

(deftest replay-catches-a-sequencer-that-invents-a-root
  (testing "a well-formed, untampered chain can still be a lie"
    (let [{:keys [put! get-fn raw]} (store)
          ;; the sequencer applies block 1 honestly, then publishes block 2
          ;; with a state root it did not compute
          ex1 (st/apply-block (fresh) (first (blocks)))
          cid1 (chain/commit! put! get-fn
                              (log/block->wire (first (blocks)) (st/state-root ex1) nil)
                              nil)
          cid2 (chain/commit! put! get-fn
                              (log/block->wire (second (blocks)) "deadbeef" nil)
                              cid1)]
      (is (chain/verify-chain get-fn cid2)
          "verify-chain passes — the log is internally consistent")
      (let [v (log/replay get-fn cid2 fresh)]
        (is (not (:ok v)) "but replay contradicts it")
        (is (= 2 (:height v)))
        (is (= "deadbeef" (:recorded v)))
        (is (not= "deadbeef" (:recomputed v))))
      (is (pos? (count @raw))))))

(deftest tampering-with-a-committed-block-breaks-the-chain
  (let [{:keys [put! get-fn raw]} (store)
        r (log/commit-blocks! (fresh) put! get-fn nil (blocks))
        entries (chain/chain get-fn (:cid r))
        victim (second entries)]
    (is (chain/verify-chain get-fn (:cid r)) "intact before tampering")
    ;; rewrite the stored bytes at an existing CID: a store that lies
    (swap! raw assoc (:cid victim)
           (ipld/encode {"state" (assoc (:state victim) "ts" 999999)
                         "prev" (some-> (:prev victim) ipld/link)
                         "seq" (:seq victim)}))
    (is (not (chain/verify-chain get-fn (:cid r)))
        "the CID no longer re-derives from its own bytes")))

;; ── signatures ──────────────────────────────────────────────────────────────
;;
;; A stand-in signer, not a cryptographic one. It is enough to prove the
;; PLUMBING — that what is signed is what is checked, that position is
;; covered, and that an unsigned block fails — without importing a JVM-only
;; crypto library into a namespace whose point is that a browser can run it.

(defn- fake-sign [payload] (str "sig:" (hash payload)))
(defn- fake-verify [payload sig] (= sig (fake-sign payload)))

(deftest signatures-verify-when-produced-honestly
  (let [{:keys [put! get-fn]} (store)
        r (log/commit-blocks! (fresh) put! get-fn nil (blocks) fake-sign)
        v (log/verify-signatures get-fn (:cid r) fake-verify)]
    (is (:ok v))
    (is (= 3 (:blocks v)))))

(deftest an-unsigned-block-is-a-failure-not-a-skip
  (let [{:keys [put! get-fn]} (store)
        r (log/commit-blocks! (fresh) put! get-fn nil (blocks))]  ; no sign-fn
    (let [v (log/verify-signatures get-fn (:cid r) fake-verify)]
      (is (not (:ok v)))
      (is (= :unsigned (:reason v)))
      (is (= 1 (:height v)) "it fails at the first unsigned block"))))

(deftest a-forged-signature-is-rejected
  (let [{:keys [put! get-fn]} (store)
        r (log/commit-blocks! (fresh) put! get-fn nil (blocks) (constantly "sig:garbage"))
        v (log/verify-signatures get-fn (:cid r) fake-verify)]
    (is (not (:ok v)))
    (is (= :bad-signature (:reason v)))))

(deftest the-signature-covers-the-parent-not-just-the-block
  (testing "the same block at a different position signs differently"
    (let [b (second (blocks))
          root "some-root"
          at-genesis (log/signing-payload (:height b) (:ts b) root nil (:txs b))
          at-parent (log/signing-payload (:height b) (:ts b) root "bafyfake" (:txs b))]
      (is (not= at-genesis at-parent)
          "otherwise a signed block could be spliced under any parent"))))

(deftest the-signature-covers-the-state-root
  (let [b (second (blocks))]
    (is (not= (log/signing-payload 2 200 "root-a" nil (:txs b))
              (log/signing-payload 2 200 "root-b" nil (:txs b)))
        "a signature that ignored the root would authenticate an invented one")))

;; ── the number canon ────────────────────────────────────────────────────────
;;
;; Every real number a transaction can carry has ONE canonical wire form and
;; ONE canonical signing rendering, byte-identical on both runtimes. `str` is
;; not that rendering: 1e17 prints "1.0E17" on the JVM and "100000000000000000"
;; on JS. The digit strings below are JVM ground truth (BigDecimal's exact
;; double constructor route — regenerate from evidence/wnc-jvm-lits.clj, never
;; hand-copy), validated byte-for-byte on kbb (evidence/wnc-kbb-probe.cljk).

(def u-1e17 "100000000000000000")
(def u-neg-2p5e18 "-2500000000000000000")
(def u-1p5e300 "")
(def d-5p5 "5.5")
(def d-neg-2p5 "-2.5")
(def d-2p5 "2.5")
(def d-0p1 "0.1000000000000000055511151231257827021181583404541015625")
(def d-0p1-plus-0p2 "0.3000000000000000444089209850062616169452667236328125")
(def d-1e-300 "0.")

(defn- amount-wire
  "The wire form of the :amount field of a deposit carrying `v`."
  [v]
  (get (log/tx->wire {:tx :deposit :account 1 :amount v}) "amount"))

(defn- amount-back
  "The decoded :amount after a full wire round trip."
  [v]
  (:amount (log/wire->tx (log/tx->wire {:tx :deposit :account 1 :amount v}))))

(deftest out-of-domain-whole-numbers-tag-u
  ;; Gap 1: a whole number outside the i53 domain threw "no wire form" on the
  ;; JVM (integer? is a TYPE test there) and encoded bare on kbb (integer? is
  ;; a VALUE test there) — one signed block, two logs, and the JVM sequencer
  ;; halted at the wire. Now: one wire form, both runtimes.
  (is (= ["u" u-1e17] (amount-wire 1e17)))
  (is (= ["u" u-neg-2p5e18] (amount-wire -2.5e18)))
  (is (= ["u" u-1p5e300] (amount-wire 1.5e300)))
  (is (= ["u" u-1e17]
         (get (log/tx->wire {:tx :withdraw-invalidate-attest :account 1 :claim 1e17})
              "claim"))
      "the tag follows the value, not the slot"))

(deftest fractional-numbers-tag-d
  ;; Gap 2: a fractional double threw "no wire form" on BOTH runtimes — a
  ;; block the engine had already handled (:bad-amount, recorded :rejected
  ;; into the root) could not be committed at all.
  (is (= ["d" d-5p5] (amount-wire 5.5)))
  (is (= ["d" d-neg-2p5] (amount-wire -2.5)))
  (is (= ["d" d-2p5] (amount-wire 2.5)))
  (is (= ["d" d-0p1] (amount-wire 0.1)))
  (is (= ["d" d-0p1-plus-0p2] (amount-wire (+ 0.1 0.2))))
  (is (= ["d" d-1e-300] (amount-wire 1e-300)))
  (is (= ["d" "Infinity"] (amount-wire ##Inf)))
  (is (= ["d" "-Infinity"] (amount-wire ##-Inf))))

(deftest in-domain-integral-numbers-stay-bare
  ;; Over-tightening guard: the canon must not touch what the wire format
  ;; always wrote bare.
  (is (= 5 (amount-wire 5)))
  (is (= 5 (amount-wire 5.0)) "an in-bounds integral double IS its integer")
  (is (= 0 (amount-wire -0.0)) "-0.0 is 0 on the wire")
  (is (= 0 (amount-back -0.0)) "and decodes as 0"))

(deftest nan-has-no-wire-form
  ;; (= ##NaN ##NaN) is false, so the round-trip law cannot hold for NaN — it
  ;; is refused loudly and symmetrically, on both runtimes, forever.
  (is (thrown? #?(:clj Exception :cljs :default)
               (log/tx->wire {:tx :deposit :account 1 :amount ##NaN}))
      "NaN has no wire form"))

(deftest the-wire-round-trip-is-idempotent
  ;; THE LAW, pinned at the wire level where it is runtime-independent:
  ;; encoding what decoding produced reproduces the same bytes. Never a
  ;; type-sensitive `=` across a submitted double and a decoded value.
  (doseq [v [1e17 -2.5e18 5.5 0.1 -0.0 1e-300 1.5e300 ##Inf ##-Inf]]
    (let [tx {:tx :deposit :account 1 :amount v}
          w (log/tx->wire tx)]
      (is (= w (log/tx->wire (log/wire->tx w)))
          (str "idempotent wire for " v)))))

(deftest decoded-numbers-recover-the-submitted-value
  (doseq [v [5.5 -2.5 2.5 0.1 (+ 0.1 0.2) 1e-300 ##Inf ##-Inf]]
    (is (= v (amount-back v)) (str "exact recovery " v)))
  ;; "u" values decode to the runtime's integer category (BigInt on the JVM,
  ;; Number on JS) and Clojure `=` is TYPE-sensitive across categories
  ;; (measured: (= 1e17 (bigint "100000000000000000")) is false on the JVM) —
  ;; the recovered value is pinned category-blind:
  (is (== 1e17 (amount-back 1e17)))
  (is (== -2.5e18 (amount-back -2.5e18)))
  (is (== 1.5e300 (amount-back 1.5e300))))

(deftest signing-payload-renders-numbers-through-the-number-canon
  ;; Gap 3: the signing payload printed `str`, which is "1.0E17" on the JVM
  ;; and "100000000000000000" on kbb — a signature produced on one runtime
  ;; could not verify against the other's payload computation.
  (is (= (str "torihiki/block\n"
              "height=1\n"
              "ts=100\n"
              "state-root=root-a\n"
              "prev=genesis\n"
              "ntx=1\n"
              "deposit:" u-1e17 ":::::::5.5:\n")
         (log/signing-payload 1 100 "root-a" nil
                              [{:tx :deposit :account 1e17 :amount 5.5}]))))

(deftest the-signing-kind-rendering-is-total
  ;; (name (:tx t)) threw on anything not a keyword and DROPPED the namespace
  ;; of a namespaced kind (:a/y printed "y"). One total helper now: keyword ->
  ;; name with the slash kept, string -> as-is, number -> canon digits,
  ;; anything else -> str. It never throws.
  (is (= (str "torihiki/block\n"
              "height=1\n"
              "ts=100\n"
              "state-root=root-a\n"
              "prev=genesis\n"
              "ntx=1\n"
              "5:::::::::\n")
         (log/signing-payload 1 100 "root-a" nil [{:tx 5}]))
      "a numeric kind renders as its digits — never a throw")
  (is (= (str "torihiki/block\n"
              "height=1\n"
              "ts=100\n"
              "state-root=root-a\n"
              "prev=genesis\n"
              "ntx=1\n"
              "a/y:::::::::\n")
         (log/signing-payload 1 100 "root-a" nil [{:tx :a/y}]))
      "a namespaced kind keeps its slash"))

;; ── the canon at EVERY rendering: wire sets, payload slots, payload coverage ─
;; Measured 2026-11-06 by evidence/probe-signing-canon.cljk on the JVM leg
;; (renamed copy, clojure -M) and the SCI leg (script/nbb-leg.sh): raw
;; printing (`pr-str`, `str`) is NOT a canon, and the payload line rendered
;; ten named slots and nothing else.

(def u-1e21 "1000000000000000000000")

(deftest a-set-folds-in-the-order-of-its-encoded-elements
  ;; The map branch sorts by the printed ENCODING of the key — "so two
  ;; runtimes that fold the same map produce the same bytes". The set branch
  ;; sorted by the RAW `pr-str`, and raw printing is runtime-local: measured,
  ;; #{1e21 15.0} folded [1e21 15] on the JVM ("1.0E21" < "15.0") and
  ;; [15 1e21] on kbb/nbb ("15" < "1e+21") — one transaction, two wire byte
  ;; strings, two CIDs, no throw. One order now: the encoded order.
  (is (= ["set" [15 ["u" u-1e21]]]
         (get (log/tx->wire {:tx :t :s #{1e21 15.0}}) "s")))
  (is (= ["set" [25 ["d" d-5p5] ["u" u-1e21]]]
         (get (log/tx->wire {:tx :t :s #{5.5 1e21 25.0}}) "s"))
      "encoded order: bare integers first, then tagged forms in tag order"))

(deftest the-signing-payload-commits-to-every-entry
  ;; The line rendered ten named slots and nothing else — measured: two
  ;; DIFFERENT :trigger transactions (different :trigger-price, different
  ;; :order) produced the IDENTICAL payload "trigger:1:2:::::::", so a
  ;; signature over one verified the other. Every entry of every transaction
  ;; now rides the line after the named slots, key=value in the encoded key
  ;; order (the map branch's sort rule). A transaction carrying only named
  ;; slots keeps its exact bytes (the pins above are unchanged).
  (is (= (str "torihiki/block\n"
              "height=1\n"
              "ts=100\n"
              "state-root=root-a\n"
              "prev=genesis\n"
              "ntx=1\n"
              ;; re-derived from the encoding rules (green leg 2026-11-06
              ;; 02:5x): ten fields joined by NINE colons — the empty-tx pin
              ;; "a/y:::::::::" carries all nine and the measured quote
              ;; "trigger:1:2:::::::" carries nine with two fields spent;
              ;; filling :account spends one colon on ":1", so eight
              ;; colons follow. The first pin here counted ten; the
              ;; implementation renders nine (every named-only pin unchanged).
              "trigger:1::::::::" ";trigger-price=500" "\n")
         (log/signing-payload 1 100 "root-a" nil
                              [{:tx :trigger :account 1 :trigger-price 500}])))
  (is (not= (log/signing-payload 1 100 "root-a" nil
                                 [{:tx :trigger :account 1 :trigger-price 500}])
            (log/signing-payload 1 100 "root-a" nil
                                 [{:tx :trigger :account 1 :trigger-price 999}]))
      "a different trigger price is a different payload")
  (is (not= (log/signing-payload 1 100 "root-a" nil
                                 [{:tx :slices :account 1 :qty 100
                                   :slices 4 :every 10}])
            (log/signing-payload 1 100 "root-a" nil
                                 [{:tx :slices :account 1 :qty 100
                                   :slices 99 :every 88888}]))
      "a different slicing is a different payload")
  (is (= (str "torihiki/block\n"
              "height=1\n"
              "ts=100\n"
              "state-root=root-a\n"
              "prev=genesis\n"
              "ntx=1\n"
              "t:::::::::" ";apple=2;zebra=1" "\n")
         (log/signing-payload 1 100 "root-a" nil
                              [{:tx :t :zebra 1 :apple 2}]))
      "extra entries sort by the encoded key — never hash order"))

(deftest composite-slot-values-render-through-the-canon
  ;; A composite slot value fell back to `str` — measured: `#{1e21 15.0}`
  ;; rendered "#{15 1.0E21}" on the JVM and "#{1e+21 15}" on kbb/nbb (the
  ;; number print AND the iteration order are runtime-local), and
  ;; {:a 1e17} rendered "{:a 1.0E17}" vs "{:a 100000000000000000}" — one
  ;; transaction, two signed payloads, a signature that cannot cross
  ;; runtimes. A composite renders through the WIRE canon now —
  ;; (pr-str (enc-val v)) — whose bytes are identical on both runtimes
  ;; because the encoding is.
  (is (= (str "torihiki/block\n"
              "height=1\n"
              "ts=100\n"
              "state-root=root-a\n"
              "prev=genesis\n"
              "ntx=1\n"
              "t:1:::::" "[\"set\" [15 [\"u\" \"" u-1e21 "\"]]]" ":::\n")
         (log/signing-payload 1 100 "root-a" nil
                              [{:tx :t :account 1 :flags #{1e21 15.0}}])))
  (is (= (str "torihiki/block\n"
              "height=1\n"
              "ts=100\n"
              "state-root=root-a\n"
              "prev=genesis\n"
              "ntx=1\n"
              "t:1:::::" "[\"m\" [[[\"k\" \"a\"] [\"u\" \"100000000000000000\"]]]]"
              ":::\n")
         (log/signing-payload 1 100 "root-a" nil
                              [{:tx :t :account 1 :flags {:a 1e17}}]))))

(deftest the-signing-payload-survives-the-wire-round-trip
  ;; verify-signatures recomputes the payload from DECODED transactions —
  ;; the payload a verifier derives must equal the payload the signer
  ;; signed, for every value space ("u" decodes to a different integer
  ;; CATEGORY on each runtime and still must render the same bytes).
  (doseq [tx [{:tx :trigger :account 1 :trigger-price 500
               :order {:tx :order :side :buy :qty 7.0 :price 1e17}}
              {:tx :t :account 1 :flags #{1e21 15.0}}
              {:tx :t :account 1 :flags {:a 1e17}}
              {:tx :deposit :account 1e17 :amount 5.5}
              {:tx :slices :account 1 :qty 100 :slices 4 :every 10}]]
    (is (= (log/signing-payload 1 100 "root-a" nil [tx])
           (log/signing-payload 1 100 "root-a" nil
                                [(log/wire->tx (log/tx->wire tx))]))
        (str "payload survives the wire round trip: " (:tx tx)))))

;; ── the key-collision canon: one decoded canon form, one key ───────────────
;; Measured 2026-11-06 (probe ground truth in the tick record): distinct map
;; keys with ONE decoded canon form (5 vs 5.0 — both bare 5 on the wire) TIE
;; the fold's sort (a sort with ties is no sort: the pair order falls back to
;; hash iteration — the determinism failure the enc-val docstring warns
;; about) and MERGE silently at every decode (`into`): the round trip LOSES
;; an entry, `(= tx (wire->tx (tx->wire tx)))` is false, no throw anywhere.
;; Same class as the NaN refusal: the wire cannot distinguish the entries,
;; so the codec refuses loudly rather than mangle. One criterion at every
;; door: two keys/elements collide iff their DECODED CANON FORMS are `=`
;; (`(= (dec-val (enc-val a)) (dec-val (enc-val b)))`). It subsumes
;; identical encodings (5 vs 5.0), decode-merge across wire forms (bare 5 vs
;; ["u" "5"] — different wire bytes, one decoded integer) and the re-encode
;; collision (["d" "5.0"] decodes to a 5.0 that is `=`-distinct from 5 on
;; the JVM yet canonizes to the same bare form).

(def ^:private collide-map
  "A map with two DISTINCT keys sharing one canon form. Constructed, never
  literal — `#?(:clj {5 :a 5.0 :b} ...)` died at READ time on the SCI leg
  (\"Map literal contains duplicate key: 5\": the reader's duplicate check
  fires even in the skipped branch, measured this tick) — and the
  constructible pair differs per runtime: the JVM keeps 5/5.0 apart (5/5N
  merges at construction) while JS merges 5/5.0 at construction
  (`(= 5 5n)` is FALSE on SCI, so 5/(js/BigInt 5) is the SCI-constructible
  pair)."
  #?(:clj (into {} [[5 :a] [5.0 :b]])
     :cljs (into {} [[5 :a] [(js/BigInt 5) :b]])))

(def ^:private collide-set
  "The set twin of `collide-map`. Never a set literal: `#{5 5.0}` is a cljs
  READER error (\"Set literal contains duplicate key: 5\")."
  #?(:clj (conj #{5} 5.0)
     :cljs (conj #{5} (js/BigInt 5))))

(defn- ex-msg
  "The ex-message `f` raises, or nil when it returns normally. kotoba.test's
  `is` has no `thrown-with-msg?` (see its README), so the REASON literal is
  pinned as a VALUE."
  [f]
  (try (f) nil (catch #?(:clj Exception :cljs :default) e (ex-message e))))

(deftest map-keys-that-collide-under-the-canon-are-refused
  (is (= "torihiki.log: map keys collide under the wire canon"
         (ex-msg #(log/tx->wire {:tx :t :flags collide-map})))
      "REASON literal — a nested map folds its colliding keys silently today")
  (is (= "torihiki.log: map keys collide under the wire canon"
         (ex-msg #(log/tx->wire (assoc collide-map :tx :t))))
      "REASON literal — a tx is a map: its entry keys are judged at the same door"))

(deftest set-elements-that-collide-under-the-canon-are-refused
  (is (= "torihiki.log: set elements collide under the wire canon"
         (ex-msg #(log/tx->wire {:tx :t :flags collide-set})))
      "REASON literal — the set folds its colliding elements silently today"))

(deftest wire-map-keys-that-collide-are-refused
  (is (= "torihiki.log: wire map keys collide"
         (ex-msg #(log/wire->tx {"tx" "t" "flags" ["m" [[5 "x"] [5 "y"]]]})))
      "REASON literal — same-form twin merges at `into` today")
  (is (= "torihiki.log: wire map keys collide"
         (ex-msg #(log/wire->tx {"tx" "t" "flags" ["m" [[5 "x"] [["u" "5"] "y"]]]})))
      "REASON literal — cross-form twin: bare 5 and \"u\" 5 decode to one integer")
  (is (= "torihiki.log: wire map keys collide"
         (ex-msg #(log/wire->tx {"tx" "t" "flags" ["m" [[5 "x"] [["d" "5.0"] "y"]]]})))
      "REASON literal — re-encode twin: 5 and 5.0 are distinct keys on the JVM and canonize to one form")
  (is (= "torihiki.log: wire map keys collide"
         (ex-msg #(log/wire->tx {"tx" "t" "_pairs" [[["k" "tx"] "x"]]})))
      "REASON literal — a crafted pairs key :tx overwrites the kind slot today")
  (is (= "torihiki.log: wire map keys collide"
         (ex-msg #(log/wire->tx {"tx" "t" "a" 5 "_pairs" [[["k" "a"] 6]]})))
      "REASON literal — flat key :a and pairs key :a merge today"))

(deftest wire-set-elements-that-collide-are-refused
  (is (= "torihiki.log: wire set elements collide"
         (ex-msg #(log/wire->tx {"tx" "t" "flags" ["set" [5 5]]})))
      "REASON literal — the decoded set loses one 5 today"))

(deftest keys-with-distinct-canon-forms-still-round-trip
  ;; Over-refusal guard: 5 and "5" share no canon form and must not be
  ;; touched; the single-key 5.0 ≡ 5 normalization the canon DECLARES stays —
  ;; only entries that would MERGE are refused.
  (let [m {5 :a "5" :b}]
    (is (= m (:flags (log/wire->tx (log/tx->wire {:tx :t :flags m}))))
        "5 and \"5\" share no canon form — both entries survive"))
  (is (= {"tx" "t" "flags" ["m" [[1 ["k" "a"]] [2 ["k" "b"]]]]}
         (log/tx->wire (log/wire->tx {"tx" "t" "flags"
                                      ["m" [[1 ["k" "a"]] [2 ["k" "b"]]]]})))
      "wire idempotence for distinct map keys")
  (is (= {"tx" "t" "flags" ["set" [1 2]]}
         (log/tx->wire (log/wire->tx {"tx" "t" "flags" ["set" [1 2]]})))
      "wire idempotence for distinct set elements")
  (is (= ["m" [[5 ["k" "a"]]]]
         (get (log/tx->wire {:tx :t :flags {5.0 :a}}) "flags"))
      "single-key {5.0 :a} keeps its wire — 5.0 ≡ 5 is the canon's own normalization"))
