(ns torihiki.order-margin-test
  "From protocol version 2, an order the account cannot back is refused, and
  what backs a resting order cannot be taken out from under it."
  (:require [kotoba.test :refer [deftest is testing]]
            [torihiki.fixed :as fx]
            [torihiki.book :as bk]
            [torihiki.clearing :as cl]
            [torihiki.api :as api]
            [torihiki.order-margin :as om]
            [torihiki.snapshot :as snap]
            [torihiki.state :as st]))

;; 40x: initial margin 2.5%, maintenance 1.25%. tick 1, lot 1, so notional =
;; level x qty and 1000 of collateral backs 40,000 of notional at the mark.
(def mkt (assoc (cl/market {:id 1 :max-leverage 40 :tick 1 :lot 1})
                :taker-fee-rate 0 :maker-fee-rate 0))
(def spot-mkt (assoc (cl/market {:id 3 :max-leverage 1 :tick 1 :lot 1})
                     :kind :spot :asset 77 :taker-fee-rate 0 :maker-fee-rate 0))

(defn- chain
  ([version] (chain version {}))
  ([version opts]
   (cond-> (st/new-exchange (merge {:markets [mkt spot-mkt]
                                    :book-opts {:n-levels 256 :cap 4096 :ev-cap 4096}}
                                   opts))
     (= 2 version) (assoc-in [:protocol :version] 2))))

(defn- block [ex h txs] (st/apply-block ex {:height h :ts h :txs txs} nil))
(defn- deposit [a n] {:tx :deposit :account a :amount n})
(defn- order [a side level qty & [flags]]
  {:tx :order :account a :market 1 :side side :level level :qty qty :flags (or flags 0)})
(defn- funded
  ([version] (funded version {}))
  ([version opts]
   (block (chain version opts) 1 [{:tx :oracle :market 1 :price 100}
                                  (deposit 1 1000) (deposit 2 1000) (deposit 3 100000)])))
(defn- rejected [ex] (set (map :reason (:rejected ex))))
(defn- resting [ex side level] (bk/level-qty (get-in ex [:books 1]) side level))
(defn- size [ex a] (:size (cl/position (:clearing ex) a 1)))
(defn- in-sync? [ex] (= (om/rebuild (:books ex) (:markets ex)) (or (:open-orders ex) {})))

;; ── version 1 ───────────────────────────────────────────────────────────────

(deftest version-1-is-what-it-was
  (let [ex (block (funded 1) 2 [(order 1 bk/bid 100 1000000)])]
    (is (= 1000000 (resting ex bk/bid 100)))
    (is (empty? (rejected ex)))))

(deftest no-order-can-halt-version-1
  ;; Review of #41: the cache kept notionals, and level x qty past 2^53 threw
  ;; inside apply-block — on version 1, where nothing reads the cache.
  (let [ex (block (funded 1) 2 [(order 1 bk/bid 255 40000000000000)])]
    (is (= 40000000000000 (resting ex bk/bid 255)))
    (is (in-sync? ex))
    (is (in-sync? (snap/restore (snap/capture ex))) "nor can a restore")))

;; ── version 2: what is refused ─────────────────────────────────────────────

(deftest an-order-the-account-cannot-back-is-refused
  (let [ex (funded 2)]
    (testing "400 x 100 = 40,000 notional is exactly 1000 at 2.5%"
      (is (nil? (api/validate ex (order 1 bk/bid 100 400))))
      (is (= :insufficient-margin (api/validate ex (order 1 bk/bid 100 401)))))
    (let [ex (block ex 2 [(order 1 bk/bid 100 401)])]
      (is (= #{:insufficient-margin} (rejected ex)))
      (is (zero? (resting ex bk/bid 100))))))

(deftest the-reproduction-from-the-devnet
  (let [ex (block (funded 2) 2 [(order 1 bk/bid 99 5000000)
                                (order 2 bk/ask 99 1000000)])]
    (is (= #{:insufficient-margin} (rejected ex)))
    (is (zero? (resting ex bk/bid 99)))
    (is (zero? (size ex 2)))))

(deftest an-aggressive-sell-is-priced-where-it-fills
  ;; Review of #41: counted at its limit (level 1), a sell into bids at 100
  ;; looked like 40,000 notional and opened a 4,000,000 short.
  (let [ex (block (funded 2) 2 [(order 3 bk/bid 100 40000)])]
    (is (= :insufficient-margin (api/validate ex (order 1 bk/ask 1 40000))))
    (is (zero? (size (block ex 3 [(order 1 bk/ask 1 40000)]) 1)))
    (is (nil? (api/validate ex (order 1 bk/ask 1 400))) "what 1000 backs at the mark still goes")))

(deftest a-resting-order-on-the-wrong-side-of-the-mark-counts-its-loss
  ;; Review of #41: an ask at level 1 with the mark at 100 loses 99 a lot the
  ;; instant it fills; a colluding taker collects it.
  (let [ex (funded 2)]
    (is (= :insufficient-margin (api/validate ex (order 1 bk/ask 1 40)))
        "99 x 40 = 3,960 of loss alone")
    (is (nil? (api/validate ex (order 1 bk/ask 95 100)))
        "5 x 100 = 500 of loss + 250 of margin")
    (is (= :insufficient-margin (api/validate ex (order 1 bk/ask 95 140)))
        "5 x 140 = 700 + 350")))

(deftest a-ladder-from-level-zero-is-refused-whole
  ;; Review of #41: a scale ask from level 0 opened a 72,000-lot short.
  (let [ex (funded 2)
        ladder {:tx :scale :account 1 :market 1 :side bk/ask :level 0 :qty 90000 :count* 2 :step 1}]
    (is (= :insufficient-margin (api/validate ex ladder)))
    (let [ex (block ex 2 [ladder])]
      (is (zero? (resting ex bk/ask 0)))
      (is (zero? (resting ex bk/ask 1)) "none of the rungs, not some"))))

(deftest a-twap-cannot-open-what-the-account-cannot-back
  ;; Review of #41: TWAP sell slices go in at level 0 without validation.
  (let [ex (block (funded 2) 2 [(order 3 bk/bid 100 100000)
                                {:tx :twap :account 1 :market 1 :side bk/ask :qty 90000
                                 :slices 3 :every 1}])
        ex (reduce (fn [e h] (block e h [])) ex (range 3 8))]
    (is (>= (size ex 1) -400) "nothing past what 1000 backs")
    (is (not (cl/liquidatable? (:clearing ex) 1 (:marks ex) (:markets ex))))))

(deftest resting-orders-add-up-on-one-side-not-across-sides
  (let [ex (block (funded 2) 2 [(order 1 bk/bid 100 300)])]
    (is (= {:bids {100 300}} (get-in ex [:open-orders 1 1])))
    (is (= :insufficient-margin (api/validate ex (order 1 bk/bid 90 120)))
        "300 + 120 bids could all fill: 42,000 at the mark")
    (is (nil? (api/validate ex (order 1 bk/ask 110 300)))
        "the asks can only fill if the bids do not")))

(deftest a-taker-is-priced-exactly
  (let [ex (block (funded 2) 2 [(order 2 bk/ask 100 400)])
        ex (block ex 3 [(order 1 bk/bid 100 400)])]
    (is (= 400 (size ex 1)))
    (is (= -400 (size ex 2)))
    (is (empty? (:open-orders ex)) "the maker's order was consumed; nothing rests")))

(deftest a-price-of-zero-is-not-a-price
  (is (= :bad-price-level (api/validate (funded 2) (order 1 bk/bid 0 1))))
  (is (nil? (api/validate (funded 1) (order 1 bk/bid 0 1))) "version 1 unchanged"))

;; ── version 2: what is never refused ────────────────────────────────────────

(defn- underwater
  "Account 1 long 300 from 100, a take-profit ask of 300 at 110 resting, and
  the mark down to 98: equity 400 is short of initial margin (735) but above
  maintenance (368), so it is not liquidated."
  []
  (-> (block (funded 2) 2 [(order 2 bk/ask 100 300) (order 1 bk/bid 100 300)
                           (order 1 bk/ask 110 300)])
      (block 3 [{:tx :oracle :market 1 :price 98}])))

(deftest closing-is-never-refused
  (let [ex (underwater)]
    (is (= 300 (size ex 1)) "still open")
    (is (zero? (om/free-collateral ex 1)))
    (is (= :insufficient-margin (api/validate ex (order 1 bk/bid 98 10))) "adding is refused")
    (is (nil? (api/validate ex (order 1 bk/ask 98 300)))
        "closing is not — with the take-profit already resting on that side (review of #41)")
    (is (nil? (api/validate ex (order 1 bk/ask 98 100))) "nor closing a part")
    (testing "reduce-only is exempt, and applies"
      (let [ex (block ex 4 [(order 3 bk/bid 98 300) (order 1 bk/ask 98 300 bk/flag-reduce-only)])]
        (is (zero? (size ex 1)))))))

(deftest a-fired-stop-is-never-refused
  ;; Review of #41: an aggressive stop counted at its limit "raised" the
  ;; requirement, was refused, and — removed before firing — was gone.
  (let [ex (-> (underwater)
               (block 4 [(order 3 bk/bid 95 300)
                         {:tx :trigger :account 1 :market 1 :trigger-price 97 :direction :below
                          :order {:side bk/ask :level 0 :qty 300}}])
               (block 5 [{:tx :oracle :market 1 :price 96}]))]
    (is (zero? (size ex 1)) "the stop closed the position")))

;; ── what backs an order stays put ───────────────────────────────────────────

(deftest what-backs-an-order-cannot-be-withdrawn
  (let [ex (block (funded 2) 2 [(order 1 bk/bid 100 300)])]
    (is (= 250 (om/free-collateral ex 1)) "1000 - 2.5% of 30,000")
    (let [ex (block ex 3 [{:tx :withdraw :account 1 :amount 251}])]
      (is (= 1000 (get-in ex [:clearing :accounts 1 :collateral])) "refused"))
    (let [oid (:oid (first (bk/level-orders (get-in ex [:books 1]) bk/bid 100)))
          ex (block ex 3 [{:tx :cancel :account 1 :market 1 :oid oid}
                          {:tx :withdraw :account 1 :amount 1000}])]
      (is (zero? (get-in ex [:clearing :accounts 1 :collateral] 0)) "cancelled, it is free again"))))

(deftest perp-margin-is-not-spent-again-on-spot
  ;; Review of #41: equity ignored spot commitments and the spot check ignored
  ;; perp reservations, so the same 1000 backed both.
  (let [ex (block (funded 2) 2 [(order 1 bk/bid 100 400)
                                {:tx :order :account 1 :market 3 :side bk/bid :level 10 :qty 100}])]
    (is (= 400 (resting ex bk/bid 100)))
    (is (zero? (bk/level-qty (get-in ex [:books 3]) bk/bid 10)) "the spot bid had nothing to commit"))
  (testing "and the other way round"
    (let [ex (block (funded 2) 2 [{:tx :order :account 1 :market 3 :side bk/bid :level 10 :qty 100}])]
      (is (= 1000 (get-in ex [:clearing :committed 1 0])))
      (is (= :insufficient-margin (api/validate ex (order 1 bk/bid 100 1)))))))

(deftest an-unaffordable-amend-leaves-the-order-alone
  (let [ex (block (funded 2) 2 [(order 1 bk/bid 100 300)])
        oid (:oid (first (bk/level-orders (get-in ex [:books 1]) bk/bid 100)))]
    (is (= :insufficient-margin
           (api/validate ex {:tx :amend :account 1 :market 1 :oid oid :level 100 :qty 500})))
    (is (nil? (api/validate ex {:tx :amend :account 1 :market 1 :oid oid :level 100 :qty 400}))
        "the order it replaces is not counted twice")
    (let [ex (block ex 3 [{:tx :amend :account 1 :market 1 :oid oid :level 100 :qty 500}])]
      (is (= 300 (resting ex bk/bid 100))))))

;; ── activation ──────────────────────────────────────────────────────────────

(deftest version-2-arrives-by-vote-and-withdraws-unbacked-orders-at-its-height
  (let [genesis (vec (for [[i w] (map-indexed vector ["w1" "w2" "w3" "w4"])]
                       {:witness w :pubkey (str "key-" w) :account (+ 100 i)}))
        ex (st/new-exchange {:markets [mkt] :book-opts {:n-levels 256 :cap 4096 :ev-cap 4096}
                             :validators {:genesis genesis :epoch-length 1000}
                             :protocol {:notice 100 :ttl 500}})
        ex (block ex 1 [{:tx :oracle :market 1 :price 100} (deposit 1 1000) (deposit 2 1000)
                        {:tx :upgrade-propose :account 100 :version 2 :activation 200}
                        {:tx :upgrade-vote :account 101 :proposal 1}
                        {:tx :upgrade-vote :account 102 :proposal 1}
                        (order 1 bk/bid 100 1000000)
                        (order 2 bk/bid 99 300)])]
    (is (= 1000000 (resting ex bk/bid 100)) "version 1: accepted unchecked")
    (is (= 1000000 (resting (block ex 199 []) bk/bid 100)) "still version 1")
    (let [ex (block ex 200 [(order 1 bk/bid 100 1000000)])]
      (is (= 2 (get-in ex [:protocol :version])))
      (is (zero? (resting ex bk/bid 100)) "withdrawn at the activation height")
      (is (= 300 (resting ex bk/bid 99)) "a backed order stays")
      (is (= #{:insufficient-margin} (rejected ex)) "and the same order is now refused")
      (is (in-sync? ex)))))

;; ── the cache ───────────────────────────────────────────────────────────────

(deftest the-cache-is-outside-the-root
  (let [ex (block (funded 2) 2 [(order 1 bk/bid 100 300)])]
    (is (= (st/state-root ex) (st/state-root (dissoc ex :open-orders))))))

(deftest a-snapshot-rebuilds-the-cache
  (let [ex (block (funded 2) 2 [(order 1 bk/bid 100 300) (order 2 bk/ask 120 30)])
        back (snap/restore (snap/capture ex))]
    (is (not (contains? (snap/capture ex) :open-orders)))
    (is (= (:open-orders ex) (:open-orders back)))))

(deftest an-overflowed-event-buffer-does-not-desync-the-cache
  ;; Review of #41: fills past ev-cap are not stored, and a cache kept from
  ;; fills drifted from the books — so a restored replica disagreed.
  (let [ex (funded 2 {:book-opts {:n-levels 256 :cap 4096 :ev-cap 4}})
        ex (block ex 2 (for [_ (range 6)] (order 3 bk/bid 100 10)))
        ex (block ex 3 [(order 1 bk/ask 100 60)])]
    (is (in-sync? ex))))

(deftest changing-a-market-kind-keeps-the-cache-in-step
  (let [ex (-> (funded 2) (assoc :bridge-authority 77))
        ex (block ex 2 [(order 1 bk/bid 100 30)
                        {:tx :amend-market :account 77 :market 1 :spec {:kind :spot :asset 5}}])]
    (is (in-sync? ex))))

(defn- lcg [seed] (mod (+ (* seed 1103515245) 12345) 2147483648))

(defn- random-tx [ex r]
  (let [pick (fn [n k] (mod (quot r k) n))
        a (inc (pick 3 1))
        side (pick 2 7)
        level (+ 90 (pick 21 13))
        qty (inc (pick 60 17))
        book (get-in ex [:books 1])
        mine (for [s [bk/bid bk/ask]
                   l (range 85 116)
                   o (bk/level-orders book s l)
                   :when (= a (:owner o))]
               (assoc o :level l))
        o (when (seq mine) (nth (vec mine) (pick (count mine) 29)))]
    (case (pick 11 101)
      (0 1 2 3) (order a side level qty (if (zero? (pick 5 37)) bk/flag-ioc 0))
      4 (if o {:tx :cancel :account a :market 1 :oid (:oid o)} (order a side level qty))
      5 (if o {:tx :amend :account a :market 1 :oid (:oid o) :level (:level o) :qty (max 1 (quot (:qty o) 2))}
            (order a side level qty))
      6 (if o {:tx :amend :account a :market 1 :oid (:oid o) :level level :qty qty} (order a side level qty))
      7 {:tx :cancel-all :account a :market 1}
      8 {:tx :oracle :market 1 :price (+ 90 (pick 21 41))}
      9 {:tx :liquidate :market 1}
      10 {:tx :scale :account a :market 1 :side side :level level :qty qty :count* 3 :step 2})))

(deftest the-cache-equals-a-rebuild-after-anything
  (doseq [version [1 2]
          ev-cap [4096 6]]
    (loop [ex (block (chain version {:book-opts {:n-levels 256 :cap 4096 :ev-cap ev-cap}}) 1
                     [{:tx :oracle :market 1 :price 100} (deposit 1 300) (deposit 2 300) (deposit 3 300)])
           h 2 r 42]
      (when (< h 150)
        (let [[txs r] (reduce (fn [[txs r] _] (let [r (lcg r)] [(conj txs (random-tx ex r)) r]))
                              [[] r] (range 4))
              ex (block ex h txs)]
          (is (in-sync? ex) (str "version " version ", ev-cap " ev-cap ", height " h ", after " (pr-str txs)))
          (recur ex (inc h) r))))))
