(ns torihiki.overflow-gates-test
  "The i53 overflow fix package, pinned by REASON and by VALUE.

  Everything here corresponds to a measured failure, not a hypothetical:
  falsify-6/7 (a throw inside apply-block halts every validator), falsify-8
  (stacked deposits past 2^53 fork the runtimes), falsify-9 through falsify-13
  (accumulators — :deficit, :funding-residue, :fees-collected, :insurance-fund,
  collateral — walked past 2^53 with honest traffic and produced two different
  state roots from one log, no throw anywhere), falsify-11's secondary finding
  (the reducing fill's `entry-notional x closed` product: bare overflow on the
  JVM, silent rounding on JS), and falsify-14 (the merkle-sum AGGREGATE over
  in-domain account collaterals: the node preimage stringifies the sum, so the
  root hash itself forked).

  The gates refuse with a keyword from `torihiki.api/reasons` or clamp to a
  pinned value. Nothing in this file may pass because something threw."
  (:require [kotoba.test :refer [deftest is testing]]
            [torihiki.fixed :as fx]
            [torihiki.clearing :as cl]
            [torihiki.funding :as fnd]
            [torihiki.liquidation :as liq]
            [torihiki.api :as api]
            [torihiki.state :as st]
            [torihiki.order-margin :as om]
            [torihiki.oracle :as oc]
            [torihiki.book :as bk]
            [torihiki.mark :as mk]
            [torihiki.validators :as vals]
            [torihiki.light :as light]
            [torihiki.commit :as cm]
            [merkle-sum.core :as ms]
            [kotoba.bytes :as b]
            [kotoba.bytes.sha256 :as sha]))

;; ── the accumulator primitive ───────────────────────────────────────────────

(deftest accumulation-saturates-instead-of-forking
  (testing "sadd is exact inside the domain and clamps at its edges"
    (is (= 5 (fx/sadd 2 3)))
    (is (= 0 (fx/acc nil 0)) "nil accumulates as 0, like (fnil + 0)")
    (is (= fx/i53-max (fx/sadd fx/i53-max 1)))
    (is (= fx/i53-max (fx/sadd fx/i53-max 1000000)))
    (is (= fx/i53-min (fx/sadd fx/i53-min -1))))
  (testing "the falsify-13 crossing value (2^53 + 1) can no longer be stored"
    (is (= fx/i53-max (fx/acc (- fx/i53-max 1) 2)))))

;; ── products ────────────────────────────────────────────────────────────────

(deftest mul-rate-computes-without-the-product
  (testing "exact where the old direct product was exact"
    (is (= 100000 (fx/mul-rate 1000000 (fx/pct 10))))
    (is (= 3 (fx/mul-rate 7 (fx/pct 50))) "floor, toward negative infinity")
    (is (= 0 (fx/mul-rate 3 1)) "below one unit, floored to zero"))
  (testing "floor semantics on the negative side"
    (is (= -1 (fx/mul-rate -3 1)))
    (is (= -100000 (fx/mul-rate -1000000 (fx/pct 10)))))
  (testing "the product of amount x rate-scale is exactly amount — this used
            to be a product of ~9e24: bare overflow on the JVM, rounding on JS"
    (is (= fx/i53-max (fx/mul-rate fx/i53-max fx/rate-scale)))
    (is (= 100000000000 (fx/mul-rate 100000000000 fx/rate-scale))))
  (testing "an out-of-domain RESULT is refused the same way on both runtimes,
            by the same :where, instead of overflowing one and rounding the other"
    (let [where (try (fx/mul-rate fx/i53-max (* 2 fx/rate-scale)) :no-throw
                     (catch #?(:clj Exception :cljs js/Error) e
                       (:where (ex-data e))))]
      (is (= :mul-rate where)))
    (let [where (try (fx/mul-rate (inc fx/i53-max) 0) :no-throw
                     (catch #?(:clj Exception :cljs js/Error) e
                       (:where (ex-data e))))]
      (is (= :mul-rate where) "an out-of-domain input is refused up front"))))

(deftest pmul-bounds-the-product-before-computing-it
  (is (= 12 (fx/pmul 3 4)))
  (is (= 0 (fx/pmul 0 999)))
  (testing "falsify-11's 7.2e14 x 1e12 clamps deterministically on both runtimes"
    (is (= fx/i53-max (fx/pmul 720000000000000 1000000000000)))
    (is (= fx/i53-min (fx/pmul -720000000000000 1000000000000)))))

;; ── the accumulators in the engine ──────────────────────────────────────────

(deftest fees-collected-never-leaves-the-domain
  ;; falsify-11: fees are small; the ACCUMULATOR crossed 2^53 and forked.
  (let [s (-> (cl/new-state)
              (cl/deposit 1 1000000)
              (assoc :fees-collected (- fx/i53-max 1)))
        s' (cl/apply-fill s 1 1 10 500 (fx/pct 10))]
    (is (= fx/i53-max (:fees-collected s')))))

(deftest funding-residue-never-leaves-the-domain
  ;; falsify-10: honest settles walked the residue to 2^53 + 1.
  (let [s (-> (cl/new-state)
              (assoc-in [:accounts 1 :positions 1] {:size 10 :entry-notional 5000})
              (assoc-in [:accounts 1 :collateral] 1000000)
              (assoc :funding-residue (- fx/i53-max 1)))
        s' (fnd/apply-funding s 1 500 (fx/pct 4))]
    (is (= fx/i53-max (:funding-residue s')))
    (is (fx/in-domain? (get-in s' [:accounts 1 :collateral])))))

(deftest insurance-fund-never-leaves-the-domain
  ;; falsify-13: stage-1 fees accumulated the fund to 2^53 + 1.
  (let [s (-> (cl/new-state)
              (cl/deposit 1 1000000)
              (assoc-in [:accounts 1 :positions 1] {:size 10 :entry-notional 5000})
              (assoc :insurance-fund (- fx/i53-max 1)))
        r (liq/liquidate s 1 1 600 1 {} liq/default-params
                         (fn [_delta _mark] [-10 600]))]
    (is (= fx/i53-max (:insurance-fund (:state r))) "stage 1 fee, saturated")
    (is (= :book (:stage r)))))

;; ── deposits: the falsify-8 regression ──────────────────────────────────────

(deftest deposit-refuses-rather-than-throws
  (let [s (cl/new-state)]
    (is (= s (cl/deposit s 1 (inc fx/i53-max)))
        "out-of-domain amount is a no-op, not a throw (falsify-6 class)")
    (is (= s (cl/deposit s 1 0)))
    (is (= s (cl/deposit s 1 -5)))))

(deftest deposits-cannot-stack-past-the-ceiling
  ;; falsify-8: two in-domain deposits took collateral to 2 x i53-max and the
  ;; runtimes then held different numbers. The gate refuses the deposit whose
  ;; credit would cross the ceiling.
  (let [s (-> (cl/new-state) (cl/deposit 1 (- fx/i53-max 100)))]
    (is (= (- fx/i53-max 100) (get-in s [:accounts 1 :collateral])))
    (is (= (- fx/i53-max 100)
           (get-in (cl/deposit s 1 200) [:accounts 1 :collateral]))
        "the overflowing deposit is refused whole")
    (is (= (- fx/i53-max 50)
           (get-in (cl/deposit s 1 50) [:accounts 1 :collateral]))
        "and a deposit that fits still lands")))

;; ── deficit: the falsify-12 halt regression ─────────────────────────────────

(deftest settle-deficit-moves-only-what-fits
  (testing "an ordinary hole moves whole, collateral lands at zero"
    (let [s (-> (cl/new-state) (assoc-in [:accounts 1 :collateral] -100))
          s' (cl/settle-deficit s 1)]
      (is (zero? (get-in s' [:accounts 1 :collateral])))
      (is (= 100 (get-in s' [:accounts 1 :deficit])))))
  (testing "an out-of-domain hole caps instead of throwing
            (falsify-12: fx/check :deficit halted apply-block mid-sweep)"
    (let [s (-> (cl/new-state) (assoc-in [:accounts 1 :collateral] (- fx/i53-max)))
          s' (cl/settle-deficit s 1)]
      (is (zero? (get-in s' [:accounts 1 :collateral])))
      (is (= fx/i53-max (get-in s' [:accounts 1 :deficit])))))
  (testing "a deficit already at the ceiling keeps the residue on collateral —
            total, deterministic, and the identity collateral - deficit holds"
    (let [s (-> (cl/new-state)
                (assoc-in [:accounts 1 :collateral] -100)
                (assoc-in [:accounts 1 :deficit] fx/i53-max))
          s' (cl/settle-deficit s 1)]
      (is (= -100 (get-in s' [:accounts 1 :collateral])))
      (is (= fx/i53-max (get-in s' [:accounts 1 :deficit]))))))

;; ── the reducing fill's product (falsify-11's secondary finding) ────────────

(deftest a-reducing-fill-on-a-huge-basis-does-not-halt
  (let [s (-> (cl/new-state)
              (assoc-in [:accounts 1 :positions 1]
                        {:size 2000000000000 :entry-notional 720000000000000})
              (assoc-in [:accounts 1 :collateral] 1000000000000))
        s' (cl/apply-fill s 1 1 -1000000000000 720 0)]
    (is (= 1000000000000 (:size (cl/position s' 1 1))))
    (is (fx/in-domain? (:entry-notional (cl/position s' 1 1))))
    (is (fx/in-domain? (get-in s' [:accounts 1 :collateral])))))

;; ── validate: every gate refuses with its reason ────────────────────────────

(defn- ex-for []
  {:markets {1 {:kind :perp}}
   :books {1 {:n-levels 64}}
   :clearing (cl/new-state)})

(deftest validate-caps-every-amount-price-and-qty
  (let [ex (ex-for)]
    (is (= :bad-amount (api/validate ex {:tx :deposit :account 1 :amount (inc fx/i53-max)})))
    (is (= :bad-amount (api/validate ex {:tx :deposit :account 1 :amount 0})))
    (is (= :bad-account (api/validate ex {:tx :deposit :account (inc fx/i53-max) :amount 5})))
    (is (= :bad-quantity
           (api/validate ex {:tx :order :account 1 :market 1 :side 0 :level 1
                             :qty (inc fx/i53-max)})))
    (is (= :bad-amount
           (api/validate ex {:tx :order :account 1 :market 1 :side 0 :level 2
                             :qty (inc (quot fx/i53-max 2))}))
        "level x qty would exceed the ceiling (falsify-7)")
    (is (= :bad-price-level
           (api/validate ex {:tx :oracle :account 1 :market 1 :price (inc fx/i53-max)})))
    (is (= :bad-trigger-price
           (api/validate ex {:tx :trigger :account 1 :market 1
                             :trigger-price (inc fx/i53-max) :direction :above
                             :order {:side 0 :level 1 :qty 1}})))
    (is (= :missing-field
           (api/validate ex {:tx :list-market :account 1 :market 2
                             :spec {:tick (inc fx/i53-max) :lot 1}})))
    (is (= :missing-field
           (api/validate ex {:tx :amend-market :account 1 :market 1
                             :spec {:max-leverage (inc fx/i53-max)}})))
    (is (nil? (api/validate ex {:tx :deposit :account 1 :amount 100})) "in-domain still passes")))

(deftest validate-refuses-a-deposit-past-the-balance-ceiling
  ;; falsify-8's gate at the boundary: the client is TOLD (:bad-amount), and
  ;; the engine refuses the same deposit as a no-op.
  (let [ex (-> (ex-for)
               (assoc-in [:clearing :accounts 1 :collateral] (- fx/i53-max 10)))]
    (is (= :bad-amount (api/validate ex {:tx :deposit :account 1 :amount 20})))
    (is (nil? (api/validate ex {:tx :deposit :account 1 :amount 5})))))

;; ── the merkle aggregate (falsify-14) ──────────────────────────────────────
;;
;; falsify-14 (frame 452): IN-DOMAIN account collaterals aggregated past the
;; ceiling inside the merkle-sum tree. Every node preimage stringifies its
;; children's sums, so an intermediate node sum of 2^53+1 — an odd value past
;; the ceiling — hashed as "9007199254740993" on the JVM and
;; "9007199254740992" on JS: the two runtimes hashed different preimages and
;; the ROOT HASH forked. Not a scalar field diverging quietly — the
;; authenticated log itself. The fold saturates now, like every accumulator.

(defn- agg-leaves
  "Three account leaves with the given collateral sums — falsify-14's shape."
  [s1 s2 s3]
  [{:id "04:01:0000000000000001" :bytes [1] :sum s1}
   {:id "04:01:0000000000000002" :bytes [2] :sum s2}
   {:id "04:01:0000000000000003" :bytes [3] :sum s3}])

(defn- thash
  "The hasher commit.cljk injects into merkle-sum — SHA-256 over the string.
  Re-declared here so the expected node hashes below are built from merkle-sum's
  own preimage spec, not from the code under test."
  [s]
  (sha/sha256-hex (b/utf8-encode s)))

(deftest the-merkle-aggregate-saturates-like-every-accumulator
  (testing "below the ceiling the tree is byte-identical to merkle-sum's own"
    (let [ls (agg-leaves 100 200 300)]
      (is (= (:root (ms/build-tree thash
                                   (mapv (fn [l] (assoc l :hash (cm/leaf-hash l)
                                                        :sum (:sum l 0)))
                                         ls)
                                   {:id->str identity}))
             (:root (cm/tree ls))))))
  (testing "the falsify-14 fork shape: the pair node's sum is 2^53+1, and that
            sum is what the ROOT preimage stringifies. It clamps now, so both
            runtimes hash the same preimage."
    (let [ls (agg-leaves fx/i53-max 2 1)
          [l1 l2 l3] ls
          h1 (cm/leaf-hash l1) h2 (cm/leaf-hash l2) h3 (cm/leaf-hash l3)
          ;; the clamped pair-node sum is a VALUE pin: it used to be
          ;; 9007199254740993 in the preimage on the JVM, 9007199254740992 on JS
          expected (ms/node-hash thash
                                 (ms/node-hash thash h1 fx/i53-max h2 2)
                                 fx/i53-max h3 1)]
      (is (= expected (cm/root ls)))
      (is (= fx/i53-max (:sum (:root (cm/tree ls)))))
      (is (every? (fn [node] (fx/in-domain? (:sum node)))
                  (mapcat identity (:levels (cm/tree ls))))
          "every node sum — leaf, internal, root — stays in the domain")))
  (testing "three full-size collaterals aggregate to the ceiling, not past it"
    (let [ls (agg-leaves fx/i53-max fx/i53-max fx/i53-max)]
      (is (= fx/i53-max (cm/reserves ls)) "was 27021597764222973")
      (is (= fx/i53-max (:sum (:root (cm/tree ls))))))))

(deftest reserves-and-shortfall-report-clamped-values
  (let [ls (agg-leaves fx/i53-max fx/i53-max fx/i53-max)]
    (is (= fx/i53-max (cm/shortfall ls 0)) "the total clamps before it subtracts")
    (is (= (- fx/i53-max 100) (cm/shortfall ls 100)))
    (is (= 0 (cm/shortfall ls (inc fx/i53-max)))
        "an attestation past the ceiling clamps into the domain first"))
  (testing "below the ceiling nothing changes"
    (let [ls (agg-leaves 100 200 300)]
      (is (= 600 (cm/reserves ls)))
      (is (= 450 (cm/shortfall ls 150)))
      (is (nil? (cm/shortfall ls nil)) "nil is still not zero"))))

(deftest a-clamped-trees-proofs-fail-closed
  (testing "an in-domain tree proves exactly as before"
    (let [ls (agg-leaves 100 200 300)
          p (cm/proof ls "04:01:0000000000000002")]
      (is (true? (cm/verify p {:hash (cm/root ls) :sum (cm/reserves ls)})))
      (is (true? (cm/verify p (cm/root ls))) "hash-only root, total from the proof")))
  (testing "a saturated tree refuses every proof on both runtimes alike —
            merkle-sum's verify recomputes with plain + and lands on the other
            side of every clamp the fold made, so the root hash cannot be
            re-derived. That is the right failure: the OLD tree VERIFIED here."
    (doseq [ls [(agg-leaves fx/i53-max fx/i53-max fx/i53-max)
                (agg-leaves fx/i53-max 2 1)]]
      (let [p (cm/proof ls "04:01:0000000000000002")]
        (is (false? (cm/verify p {:hash (cm/root ls) :sum (cm/reserves ls)})))
        (is (false? (cm/verify p (cm/root ls))))))))

;; ── rates and book sizing at the validate layer ─────────────────────────────
;;
;; The accumulator fix bounded every sum and made mul-rate exact, but two
;; VALIDATED transactions could still halt apply-block — the falsify-6/7
;; class, arriving through doors the earlier gates left open:
;;
;;   1. A market spec carrying a rate above 100%. Fee, margin and tier rates
;;      are multiplied against in-domain amounts (`torihiki.fixed/mul-rate`),
;;      and `amount x rate / rate-scale` for a rate past rate-scale leaves the
;;      domain — where mul-rate throws, mid-fill, inside the block.
;;   2. A `:list-market` whose `:book-opts` `new-book` rejects by THROWING
;;      (its n-levels/cap shape constraints) or by allocating (ev-cap reached
;;      no bound at all). The throw lands in apply-block from a transaction
;;      that passed validate.

(deftest rate-caps-refuse-above-the-ceiling
  (let [ex (ex-for)]
    (testing "a rate past 100% is refused with its REASON"
      (is (= :rate-too-high
             (api/validate ex {:tx :list-market :account 1 :market 2
                               :spec {:tick 1 :lot 1
                                      :taker-fee-rate (inc fx/rate-scale)}})))
      (is (= :rate-too-high
             (api/validate ex {:tx :list-market :account 1 :market 2
                               :spec {:tick 1 :lot 1
                                      :maintenance-margin-rate (* 2 fx/rate-scale)}})))
      (is (= :rate-too-high
             (api/validate ex {:tx :amend-market :account 1 :market 1
                               :spec {:fee-tiers [{:min-volume 0
                                                   :maker-fee-rate (inc fx/rate-scale)}]}}))
          "tiers are rates too, wherever they nest")
      (is (= :rate-too-high
             (api/validate ex {:tx :amend-market :account 1 :market 1
                               :spec {:taker-fee-rate (- (inc fx/rate-scale))}}))))
    (testing "the ceiling is a VALUE: exactly rate-scale (100%) passes, and so
              does a rebate of the same magnitude"
      (is (nil? (api/validate ex {:tx :list-market :account 1 :market 2
                                  :spec {:tick 1 :lot 1
                                         :taker-fee-rate fx/rate-scale}})))
      (is (nil? (api/validate ex {:tx :amend-market :account 1 :market 1
                                  :spec {:maker-fee-rate (- fx/rate-scale)}})))
      (is (nil? (api/validate ex {:tx :amend-market :account 1 :market 1
                                  :spec {:fee-tiers [{:min-volume 0
                                                      :taker-fee-rate (fx/bps 3)}]}}))))))

(deftest book-opts-the-engine-would-throw-on-are-refused-at-the-door
  (let [ex (assoc (ex-for) :bridge-authority 1)]
    (testing "REASON for every shape new-book rejects by throwing or allocating"
      (is (= :missing-field
             (api/validate ex {:tx :list-market :account 1 :market 2
                               :spec {:tick 1 :lot 1}
                               :book-opts {:n-levels -32}}))
          "a negative multiple of 32 clears new-book's rem check and dies in alloc")
      (is (= :missing-field
             (api/validate ex {:tx :list-market :account 1 :market 2
                               :spec {:tick 1 :lot 1}
                               :book-opts {:n-levels 33}})))
      (is (= :missing-field
             (api/validate ex {:tx :list-market :account 1 :market 2
                               :spec {:tick 1 :lot 1}
                               :book-opts {:n-levels (inc 1048576)}})))
      (is (= :missing-field
             (api/validate ex {:tx :list-market :account 1 :market 2
                               :spec {:tick 1 :lot 1}
                               :book-opts {:cap 40000000}})))
      (is (= :missing-field
             (api/validate ex {:tx :list-market :account 1 :market 2
                               :spec {:tick 1 :lot 1}
                               :book-opts {:ev-cap (inc fx/i53-max)}}))
          "ev-cap reached an allocation and nothing bounded it")
      (is (= :missing-field
             (api/validate ex {:tx :list-market :account 1 :market 2
                               :spec {:tick 1 :lot 1}
                               :book-opts {:n-levels 65536.5}}))
          "a float n-levels allocates one size on the JVM and another on JS")
      (is (= :missing-field
             (api/validate ex {:tx :list-market :account 1 :market 2
                               :spec {:tick 1 :lot 1}
                               :book-opts {:n-levels "65536"}}))))
    (testing "VALUE: no opts at all, and the documented bounds, still pass"
      (is (nil? (api/validate ex {:tx :list-market :account 1 :market 2
                                  :spec {:tick 1 :lot 1}})))
      (is (nil? (api/validate ex {:tx :list-market :account 1 :market 2
                                  :spec {:tick 1 :lot 1}
                                  :book-opts {:n-levels 1048576
                                              :cap 33554432
                                              :ev-cap 65536}}))))
    (testing "the engine's answer is the no-op safety net, not a throw"
      (is (= ex (st/apply-tx ex {:tx :list-market :account 1 :market 2
                                 :spec {:tick 1 :lot 1}
                                 :book-opts {:n-levels -32}}))))))

(deftest the-funding-sample-sum-is-an-accumulator-like-every-other
  (testing "below the ceiling folding is unchanged"
    (is (= {:sum 5 :n 2} (-> fnd/empty-accumulator
                             (fnd/sample 2)
                             (fnd/sample 3)))))
  (testing "VALUE: the sum saturates at the ceiling instead of crossing 2^53 —
            a (fnil + 0) walked out of the domain in every falsify-8..13 site"
    (is (= fx/i53-max (:sum (fnd/sample {:sum (- fx/i53-max 1) :n 0} 2)))))
  (testing "and at the floor"
    (is (= fx/i53-min (:sum (fnd/sample {:sum (inc fx/i53-min) :n 0} -2))))))

;; ── the accumulator sweep: no raw fold remains ─────────────────────────────
;;
;; The fix package above routed the six measured falsify-8..13 sites through
;; `fx/acc`. The same `(fnil + 0)` class survived that sweep in more folds:
;; bonds, vault shares, open interest, spot reservations, spot balances,
;; rolling volume, the deficit pay-down, the slash path (delegator collateral
;; and the OTHER writer of :insurance-fund — falsify-13's own field), and the
;; funding sample count — plus the two derived spot-commitment sums in
;; torihiki.state. Every one of them crosses 2^53 by honest folding and then
;; holds a value JS cannot mirror: one more (fnil + 0), one more fork. All of
;; them go through `torihiki.fixed/acc` now. The pins are VALUES (the clamp);
;; there are no refusals here because a clamp is total.

(deftest bonds-saturate-at-the-ceiling
  (let [s (cl/bond (cl/new-state) 1 2 (- fx/i53-max 1) fx/i53-max)
        s' (cl/bond s 1 2 2 fx/i53-max)]
    (is (= (- fx/i53-max 1) (get-in s [:bonds 1 2])) "below the ceiling, unchanged")
    (is (= fx/i53-max (get-in s' [:bonds 1 2]))
        "was i53-max + 1 — one more (fnil + 0), one more fork")
    (is (fx/in-domain? (get-in s' [:bonds 1 2])))))

(deftest vault-shares-saturate-like-every-accumulator
  ;; total-shares and per-account shares are two more folds of the same class.
  (let [s (-> (cl/new-state)
              (assoc-in [:accounts 1 :collateral] 100)
              (assoc-in [:vaults 2 :total-shares] (- fx/i53-max 1))
              (assoc-in [:vaults 2 :shares 1] (- fx/i53-max 1)))
        s' (cl/vault-deposit s 1 2 2)]
    (is (= fx/i53-max (get-in s' [:vaults 2 :total-shares])))
    (is (= fx/i53-max (get-in s' [:vaults 2 :shares 1])))
    (is (fx/in-domain? (get-in s' [:vaults 2 :shares 1])))))

(deftest open-interest-saturates-at-the-ceiling
  (let [s (-> (cl/new-state)
              (assoc-in [:accounts 1 :collateral] 1000000)
              (assoc-in [:open-interest 1] (- fx/i53-max 1)))
        s' (cl/apply-fill s 1 1 2 10 0)]
    (is (= fx/i53-max (get-in s' [:open-interest 1])))))

(deftest spot-reservations-saturate-in-both-directions
  (is (= fx/i53-max
         (get-in (cl/commit-spot (assoc-in (cl/new-state) [:committed 1 0]
                                           (- fx/i53-max 1))
                                 1 0 2)
                 [:committed 1 0]))
      "was i53-max + 1")
  (is (= fx/i53-min
         (get-in (cl/release-spot (assoc-in (cl/new-state) [:committed 1 0]
                                            (inc fx/i53-min))
                                  1 0 2)
                 [:committed 1 0]))
      "was i53-min - 1"))

(deftest spot-balances-saturate-in-both-directions
  (let [s (-> (cl/new-state)
              (assoc-in [:balances 1 7] (- fx/i53-max 1))
              (assoc-in [:balances 2 7] (inc fx/i53-min))
              (assoc-in [:accounts 1 :collateral] 1000000)
              (assoc-in [:accounts 2 :collateral] 1000000))
        s' (cl/spot-fill s 1 2 7 2 10 0 0)]
    (is (= fx/i53-max (get-in s' [:balances 1 7])) "buyer's credit, clamped")
    (is (= fx/i53-min (get-in s' [:balances 2 7])) "seller's debit, clamped")))

(deftest rolling-volume-saturates-at-the-ceiling
  (let [s (assoc-in (cl/new-state) [:volume 1] {:epoch 0 :cur (- fx/i53-max 1) :prev 0})]
    (is (= fx/i53-max (:cur (get-in (cl/add-volume s 1 0 2) [:volume 1])))
        "the running fold was i53-max + 1")))
(deftest rolling-volume-clamps-on-the-way-in-too
  (is (= fx/i53-max (:cur (get-in (cl/add-volume (cl/new-state) 1 0 (inc fx/i53-max))
                                  [:volume 1])))
      "the first write is an accumulator write like any other")
  (is (= 12 (:cur (get-in (-> (cl/new-state) (cl/add-volume 1 0 5) (cl/add-volume 1 0 7))
                          [:volume 1])))
      "below the ceiling folding is unchanged"))

(deftest the-slash-path-fund-is-an-accumulator-too
  ;; falsify-13's field has a SECOND writer: the slash path folds
  ;; `total - reward` into :insurance-fund. It crossed 2^53 exactly like the
  ;; liquidation stage-1 fee did, with no throw anywhere.
  (let [cl0 (-> (cl/new-state)
                (assoc :insurance-fund (- fx/i53-max 1))
                (assoc-in [:bonds 103 102] 1000)
                (assoc-in [:accounts 103 :collateral] 1000))
        ex {:clearing cl0 :validators {"w3" {:account 102}} :height 5}
        ex' (vals/slash ex {:account 500 :witness "w3" :evidence-height 4 :view 7})]
    (is (= fx/i53-max (get-in ex' [:clearing :insurance-fund]))))
  (testing "below the ceiling the slash accounting is unchanged"
    (let [cl0 (-> (cl/new-state)
                  (assoc-in [:bonds 103 102] 1000)
                  (assoc-in [:accounts 103 :collateral] 1000))
          ex {:clearing cl0 :validators {"w3" {:account 102}} :height 5}
          ex' (vals/slash ex {:account 500 :witness "w3" :evidence-height 4 :view 7})]
      (is (= 1000 (get-in ex' [:clearing :insurance-fund])) "reporter reward is 0 here")
      (is (zero? (get-in ex' [:clearing :accounts 103 :collateral]))))))

(deftest the-funding-sample-count-is-gated-too
  (is (= fx/i53-max (:n (fnd/sample {:sum 0 :n fx/i53-max} 1)))
      "a counter is an accumulator; it folds one more (inc) at the wall")
  (is (= 3 (:n (-> fnd/empty-accumulator (fnd/sample 1) (fnd/sample 1) (fnd/sample 1))))))

(deftest derived-spot-commitment-sums-saturate
  ;; The two derived sums in torihiki.state — the per-account view and the
  ;; rebuild that WRITES :clearing :committed (so it enters the state root) —
  ;; fold backing amounts with plain +. One owner, two resting sells: honest
  ;; book, and the sum crosses 2^53.
  (let [b (bk/new-book {:n-levels 64 :cap 64 :ev-cap 64})
        _ (bk/place! b bk/ask 10 (- fx/i53-max 1) 0 1)
        _ (bk/place! b bk/ask 11 2 0 1)
        ex {:markets {1 {:kind :spot :asset 7}} :books {1 b}}
        ex' (st/rebuild-spot-commitments ex)]
    (is (= {7 fx/i53-max} (st/spot-resting-backing ex 1 1)))
    (is (= fx/i53-max (get-in ex' [:clearing :committed 1 7]))))
  (testing "below the ceiling the rebuild is unchanged"
    (let [b (bk/new-book {:n-levels 64 :cap 64 :ev-cap 64})
          _ (bk/place! b bk/ask 10 5 0 1)
          _ (bk/place! b bk/ask 11 7 0 1)
          ex {:markets {1 {:kind :spot :asset 7}} :books {1 b}}
          ex' (st/rebuild-spot-commitments ex)]
      (is (= {7 12} (st/spot-resting-backing ex 1 1)))
      (is (= 12 (get-in ex' [:clearing :committed 1 7]))))))

;; ── the residual i53 caps: every integer that lands in state is storable ────
;;
;; The falsify-8 class arriving through the fields the earlier caps missed.
;; `validate` checked these with `integer?`/`pos?` alone: an out-of-i53 integer
;; it accepted was then STORED — an :anchors entry, a :sub-of key, a twap
;; schedule's :every, a reserve attestation's :amount/:as-of, an upgrade
;; proposal's :version/:activation — and the two runtimes held different
;; numbers from one transaction: root divergence, no throw anywhere. And
;; `:scale`'s :level feeds `(+ level (* dir i step))` inside apply-block.
;; Refused at validate with its REASON from `torihiki.api/reasons`; the engine
;; answers the same transactions with a no-op, not a store.

(deftest validate-caps-every-integer-that-lands-in-state
  (let [ex (ex-for)]
    (testing "REASON for every field the i53 caps missed"
      (is (= :bad-account
             (api/validate ex {:tx :anchor :account (inc fx/i53-max) :cid "bafytest"})))
      (is (= :bad-account
             (api/validate ex {:tx :create-sub-account :account 1 :sub (inc fx/i53-max)})))
      (is (= :bad-price-level
             (api/validate ex {:tx :scale :account 1 :market 1 :side 0
                               :level (inc fx/i53-max) :qty 1 :count* 2 :step 1})))
      (is (= :missing-field
             (api/validate ex {:tx :twap :account 1 :market 1 :side 0
                               :qty 10 :slices 2 :every (inc fx/i53-max)})))
      (is (= :bad-amount
             (api/validate ex {:tx :attest-reserves :account 1 :amount (inc fx/i53-max)})))
      (is (= :missing-field
             (api/validate ex {:tx :attest-reserves :account 1 :amount 5
                               :height* (inc fx/i53-max)})))
      (is (= :missing-field
             (api/validate ex {:tx :upgrade-propose :account 1
                               :version (inc fx/i53-max) :activation 100})))
      (is (= :missing-field
             (api/validate ex {:tx :upgrade-propose :account 1
                               :version 2 :activation (inc fx/i53-max)})))
      (is (= :bad-quantity
             (api/validate ex {:tx :vault-withdraw :account 1 :vault 2
                               :shares (inc fx/i53-max)}))))
    (testing "VALUE: the documented bounds still pass"
      (is (nil? (api/validate ex {:tx :anchor :account 1 :cid "bafytest"})))
      (is (nil? (api/validate ex {:tx :create-sub-account :account 1 :sub 2})))
      (is (nil? (api/validate ex {:tx :scale :account 1 :market 1 :side 0
                                  :level 0 :qty 1 :count* 2 :step 1})))
      (is (nil? (api/validate ex {:tx :twap :account 1 :market 1 :side 0
                                  :qty 10 :slices 2 :every 5})))
      (is (nil? (api/validate ex {:tx :attest-reserves :account 1 :amount 5 :height* 100})))
      (is (nil? (api/validate ex {:tx :upgrade-propose :account 1 :version 2 :activation 100})))
      (is (nil? (api/validate ex {:tx :vault-withdraw :account 1 :vault 2 :shares 5}))))))

;; ── the weight sums: falsify-14's class at a DECISION ───────────────────────
;;
;; Per-key stakes and member weights are in-domain. Their AGGREGATES are not:
;; three stakes of i53-max, two delegator bonds of i53-max — the fold crosses
;; 2^53 and then holds one number on the JVM and another on JS (falsify-8's
;; divergence rule in falsify-14b's multi-account shape). In the accumulators
;; that was a FIELD. Here it is a VERDICT: the light client's 2/3 root
;; threshold, the validator set's supermajority, the oracle's weighted-median
;; walk and its freshness threshold, and the slash path's taken total (recorded
;; in :slashed and debited from :insurance-fund). Same log, two answers.
;;
;; And the thresholds themselves: `(* 3 have)` with an in-domain `have` above
;; ~3e15 is not a double — JS rounds it to the nearest even integer while `(* 2
;; total)`, always even and always below 2^54, stays exact — so the comparison
;; decided differently on the two runtimes at ORDINARY in-domain values, long
;; before any sum left the domain. Measured live in the RED run: 3 x
;; 3002399751580331 = 2^53 + 1 rounds DOWN to 2^53 on JS, and `3h > 2t` with 2t
;; = 2^53 flipped from true to false. All sums fold through `fx/sadd` now, and
;; every 3x threshold reads as its exact 2x form — `3h > 2t` is `h > 2(t − h)`
;; and `3w > t` is `2w > t − w` — where every operand is in-domain (weights are
;; non-negative and a partial sum never exceeds the total), so every product
;; here is twice an in-domain integer, exactly representable on both runtimes,
;; and the verdict is one number.
;;
;; Pins are VALUEs: the clamp, and the verdict. The clamp pins (like every
;; clamp in this file) state the precision loss rather than hide it: past the
;; ceiling the verdict is read from saturated sums and the two runtimes read
;; the SAME saturated sums.

(defn- wsign [k payload] (str k "|" payload))
(defn- wverify [k payload sig] (= sig (wsign k payload)))

(deftest light-attested-weights-saturate-at-the-ceiling
  ;; Two members, weights (i53-max - 1) + 2: the aggregate was 2^53 + 1 —
  ;; exact on the JVM, 2^53 on JS — and :total and :weight both carry it out
  ;; of `attested-root` into whatever the caller does next.
  (let [members {"w1" {:pubkey "k1" :weight (- fx/i53-max 1)}
                 "w2" {:pubkey "k2" :weight 2}}
        att (fn [w] {:witness w :height 10 :root "00"
                     :sig (wsign (:pubkey (get members w))
                                 (light/root-payload "c" 0 10 "00"))})
        a (light/attested-root [(att "w1") (att "w2")] members "c" 0 wverify)]
    (is (= fx/i53-max (:total a)) "the sum was 2^53 + 1")
    (is (= fx/i53-max (:weight a))))
  (testing "below the ceiling the attestation is unchanged"
    (let [members {"w1" {:pubkey "k1" :weight 40}
                   "w2" {:pubkey "k2" :weight 35}
                   "w3" {:pubkey "k3" :weight 25}}
          att (fn [w] {:witness w :height 10 :root "00"
                       :sig (wsign (:pubkey (get members w))
                                   (light/root-payload "c" 0 10 "00"))})
          a (light/attested-root [(att "w1") (att "w2")] members "c" 0 wverify)]
      (is (= 100 (:total a)))
      (is (= 75 (:weight a))))))

(deftest light-threshold-decides-identically-at-the-double-boundary
  ;; 3 x 3002399751580331 = 2^53 + 1 is not a double: JS rounds it to 2^53
  ;; and the comparison against 2 x total = 2^53 then answers FALSE where the
  ;; exact arithmetic answers TRUE. The same signatures, two different roots.
  (let [h 3002399751580331
        t 4503599627370496                       ; 2t = 2^53
        members {"w1" {:pubkey "k1" :weight h}
                 "w2" {:pubkey "k2" :weight (- t h)}}
        att (fn [w] {:witness w :height 10 :root "00"
                     :sig (wsign (:pubkey (get members w))
                                 (light/root-payload "c" 0 10 "00"))})]
    (is (= "00" (:root (light/attested-root [(att "w1")] members "c" 0 wverify)))
        "w1 alone: 3h = 2^53 + 1 > 2t = 2^53 — exactly, and on both runtimes")
    (is (nil? (light/attested-root [(att "w2")] members "c" 0 wverify))
        "w2 alone: 3(t − h) = 2^53 − 3 is not over two thirds")))

(deftest oracle-weighted-median-walks-saturated-stake
  ;; The running sum crossed 2^53 between p1 and p2. Clamped, the walk reaches
  ;; "half the stake" at p1 on both runtimes; raw, it walked past and picked
  ;; p2 (a third stake of 1 made the total 2 x i53-max + 1 — the JVM's number,
  ;; and JS rounded it).
  (let [sorted [["p1" 10] ["p2" 20] ["p3" 30]]
        stake {"p1" fx/i53-max "p2" fx/i53-max "p3" 1}]
    (is (= 10 (oc/weighted-median sorted #(get stake %)))))
  (testing "below the ceiling the walk is unchanged"
    (let [sorted [["p1" 10] ["p2" 20] ["p3" 30]]
          stake {"p1" 1 "p2" 1 "p3" 1}]
      (is (= 20 (oc/weighted-median sorted #(get stake %)))))))

(deftest oracle-aggregate-weighted-reads-a-saturated-total
  ;; One fresh publisher of three, each stake i53-max: the raw total was 3 x
  ;; i53-max and the raw comparison said STALE. The clamped total is the
  ;; ceiling, the clamped ratio is what both runtimes read, and the same
  ;; verdict comes out of both.
  (let [weights {"p1" fx/i53-max "p2" fx/i53-max "p3" fx/i53-max}
        subs {"p1" {:price 100 :ts 0}}
        r (oc/aggregate-weighted subs weights 10 60)]
    (is (false? (:stale? r)))
    (is (= 100 (:price r))))
  (testing "below the ceiling the threshold is unchanged — and still strict"
    (let [weights {"p1" 3 "p2" 4 "p3" 3}]
      (is (false? (:stale? (oc/aggregate-weighted {"p1" {:price 100 :ts 0}
                                                   "p2" {:price 100 :ts 0}}
                                                  weights 10 60))))
      (is (true? (:stale? (oc/aggregate-weighted {"p1" {:price 100 :ts 0}}
                                                 weights 10 60)))
          "one of three is stale at any weight"))))

(deftest supermajority-reads-saturated-stakes
  ;; Three operators at i53-max: the raw total was 3 x i53-max and one of
  ;; three read as a minority. Clamped, have = total = ceiling, and both
  ;; runtimes read the same minority-or-supermajority from the same sums.
  (let [ex {:epoch {:set [{:account 1 :stake fx/i53-max}
                          {:account 2 :stake fx/i53-max}
                          {:account 3 :stake fx/i53-max}]}}]
    (is (true? (vals/supermajority? ex [1]))))
  (testing "the 3 x weight product is not a double above 2^53 — the verdict
            must not depend on which runtime rounded it"
    (let [h 3002399751580331                        ; 3h = 2^53 + 1
          t 4503599627370496                        ; 2t = 2^53
          ex {:epoch {:set [{:account 1 :stake h}
                            {:account 2 :stake (- t h)}]}}]
      (is (true? (vals/supermajority? ex [1]))
          "3h = 2^53 + 1 > 2t = 2^53 exactly — and identically on both runtimes")
      (is (false? (vals/supermajority? ex [2]))
          "3(t − h) = 2^53 − 3 is not over two thirds")))
  (testing "below the ceiling the verdict is unchanged"
    (let [ex {:epoch {:set [{:account 1 :stake 3}
                            {:account 2 :stake 4}
                            {:account 3 :stake 3}]}}]
      (is (true? (vals/supermajority? ex [1 2])))
      (is (false? (vals/supermajority? ex [1]))))))

(deftest slash-path-taken-total-saturates
  ;; Two delegators backing one validator, falsify-14b's shape: per-key
  ;; in-domain, aggregate past the ceiling. The raw total was 2^53 + 1 — the
  ;; JVM's number, and 2^53 on JS — and it is RECORDED in :slashed and
  ;; debited from :insurance-fund: the same evidence, two different books.
  (let [cl0 (-> (cl/new-state)
                (assoc-in [:bonds 103 102] fx/i53-max)
                (assoc-in [:accounts 103 :collateral] fx/i53-max)
                (assoc-in [:bonds 104 102] 2)
                (assoc-in [:accounts 104 :collateral] 2))
        ex {:clearing cl0 :validators {"w3" {:account 102}} :height 5}
        ex' (vals/slash ex {:account 500 :witness "w3"
                            :evidence-height 4 :view 7})]
    (is (= fx/i53-max (get-in ex' [:slashed ["w3" 4 7] :amount]))
        "the taken total was 2^53 + 1")
    (is (= fx/i53-max (get-in ex' [:clearing :insurance-fund]))
        "the debited total clamps with the recorded one"))
  (testing "below the ceiling the slash accounting is unchanged"
    (let [cl0 (-> (cl/new-state)
                  (assoc-in [:bonds 103 102] 1000)
                  (assoc-in [:accounts 103 :collateral] 1000)
                  (assoc-in [:bonds 104 102] 500)
                  (assoc-in [:accounts 104 :collateral] 500))
          ex {:clearing cl0 :validators {"w3" {:account 102}} :height 5}
          ex' (vals/slash ex {:account 500 :witness "w3"
                              :evidence-height 4 :view 7})]
      (is (= 1500 (get-in ex' [:slashed ["w3" 4 7] :amount])))
      (is (= 1500 (get-in ex' [:clearing :insurance-fund]))))))

(deftest the-engine-says-no-op-not-a-store
  (testing "an out-of-i53 value that never met validate is refused, not stored —
            the same safety net `cl/deposit` keeps, for the same reason"
    (let [b (bk/new-book {:n-levels 64 :cap 64 :ev-cap 64})
          ex (-> (ex-for) (assoc :books {1 b} :height 10))]
      (is (= ex (st/apply-tx ex {:tx :anchor :account (inc fx/i53-max) :cid "bafytest"})))
      (is (= ex (st/apply-tx ex {:tx :create-sub-account :account 1 :sub (inc fx/i53-max)})))
      (is (= ex (st/apply-tx ex {:tx :twap :account 1 :market 1 :side 0
                                 :qty 10 :slices 2 :every (inc fx/i53-max)})))
      (let [exb (assoc ex :bridge-authority 1)]
        (is (= exb (st/apply-tx exb {:tx :attest-reserves :account 1
                                     :amount (inc fx/i53-max)})))))))

;; ── notional money math is total (the mark-to-market path) ──────────────────
;;
;; `fx/notional` was `(check :notional (* price size))`: the product computed
;; first, then checked. In-domain factors with an out-of-domain product reach
;; it from every valuation site — unrealized PnL (mark x ACCUMULATED size), a
;; flipping fill's realized PnL, the order-margin loss terms — and then either
;; threw mid-apply (a halted chain, falsify-6/7's class) or, past 2^63, threw
;; a bare overflow on the JVM while JS rounded silently (falsify-9/11
;; secondary). And the SUMS and DIFFERENCES of notional terms were raw `+`/`-`
;; : two in-domain terms leaving the domain fork the runtimes with no throw
;; anywhere (falsify-8..13's class). Notional is now a saturated product, its
;; differences go through fx/sadd, and its sums through fx/acc.

(deftest notional-saturates-instead-of-throwing
  (testing "exact where the product is in the domain"
    (is (= 12 (fx/notional 3 4)))
    (is (= 20000 (fx/notional 100 200)))
    (is (= 1440000000000000 (fx/notional 720000 2000000000)))
    (is (= fx/i53-max (fx/notional fx/i53-max 1)))
    (is (= 0 (fx/notional 0 fx/i53-max))))
  (testing "VALUE: an out-of-domain product clamps deterministically — it used
            to throw :notional mid-apply (a halted chain)"
    (is (= fx/i53-max (fx/notional fx/i53-max fx/i53-max)))
    (is (= fx/i53-max (fx/notional fx/i53-max 2)))
    (is (= fx/i53-min (fx/notional (- fx/i53-max) 2)))
    (is (= fx/i53-min (fx/notional 2 (- fx/i53-max))))
    (is (= fx/i53-max (fx/notional (- fx/i53-max) (- fx/i53-max))))))

(deftest unrealized-is-a-saturated-difference
  (testing "exact inside the domain"
    (is (= 1000 (cl/unrealized {:size 10 :entry-notional 1000} 200))))
  (testing "VALUE: the product clamps before the difference is taken"
    (is (= (dec fx/i53-max)
           (cl/unrealized {:size 2 :entry-notional 1} fx/i53-max))))
  (testing "VALUE: a difference of two in-domain values that leaves the domain
            clamps — 2^54 - 2 is a raw long on the JVM and a rounded double on
            JS (falsify-8's class), from an honest mark on a large position"
    (is (= fx/i53-max
           (cl/unrealized {:size 1 :entry-notional (- fx/i53-max)} fx/i53-max)))))

(deftest a-flip-fill-clamps-realized-and-the-fresh-basis
  ;; Notional 720000 x 2e12 is 1.44e18: the OLD fx/notional threw :notional
  ;; here, in the middle of a fill, after the book had already traded.
  (let [s (-> (cl/new-state)
              (assoc-in [:accounts 1 :positions 1]
                        {:size -2000000000000 :entry-notional -1440000000000000}))
        s' (cl/apply-fill s 1 1 3000000000000 720000 0)]
    (is (= 1000000000000 (:size (cl/position s' 1 1))))
    (is (= fx/i53-max (:entry-notional (cl/position s' 1 1)))
         "the fresh basis is the clamped notional")
    (is (= -7567199254740991 (get-in s' [:accounts 1 :collateral]))
         "VALUE: realized = clamp(-1.44e18) - (-1.44e15), saturated")))

(deftest a-reducing-fill-realizes-a-saturated-difference
  (let [s (-> (cl/new-state)
              (assoc-in [:accounts 1 :positions 1]
                        {:size 2 :entry-notional (- fx/i53-max)}))
        s' (cl/apply-fill s 1 1 -1 fx/i53-max 0)]
    (is (= 1 (:size (cl/position s' 1 1))))
    (is (= -4503599627370495 (:entry-notional (cl/position s' 1 1)))
         "VALUE: entry basis minus the pro-rated closed basis, saturated")
    (is (= fx/i53-max (get-in s' [:accounts 1 :collateral]))
         "VALUE: realized = i53-max - (-4.5e15), saturated")))

(deftest order-margin-requirement-saturates-at-every-sum
  (let [clearing (cl/new-state)
        ;; 2^53 + 1 of loss across two bid levels: the falsify-13 crossing value
        oo {1 {1 {:bids {2 4503599627370495 3 2251799813685249}}}}
        markets {1 {:initial-margin-rate (fx/pct 10)}}]
    (testing "VALUE: the mark branch — the loss terms sum past 2^53 and clamp,
              and the requirement sum of margin + loss clamps too"
      (is (= fx/i53-max (om/requirement clearing oo 1 {1 1} markets))))
    (testing "VALUE: the no-mark branch — the order-notional sum (1.57e16)
              clamps BEFORE mul-rate sees it; the raw sum fed mul-rate's input
              check and threw mid-apply (falsify-6/7 class)"
      (is (= 900719925474099 (om/requirement clearing oo 1 {1 0} markets))))))

(deftest equity-and-margin-fold-through-acc
  (let [s (-> (cl/new-state)
              (assoc-in [:accounts 1 :collateral] 0)
              (assoc-in [:accounts 1 :positions]
                        {1 {:size 1 :entry-notional (- fx/i53-max)}
                         2 {:size 1 :entry-notional (- fx/i53-max)}}))]
    (testing "VALUE: two in-domain unrealized terms sum to 2^55 - 4 raw; the
              fold clamps (falsify-8's class on a root-visible total)"
      (is (= fx/i53-max (cl/equity s 1 {1 fx/i53-max 2 fx/i53-max})))))
  (testing "in-domain requirements are byte-identical to the old raw folds"
    (let [s (-> (cl/new-state)
                (assoc-in [:accounts 1 :positions]
                          {1 {:size 1 :entry-notional 0}
                           2 {:size 1 :entry-notional 0}}))
          markets {1 {:initial-margin-rate (fx/pct 10)
                      :maintenance-margin-rate (fx/pct 5)}
                   2 {:initial-margin-rate (fx/pct 10)
                      :maintenance-margin-rate (fx/pct 5)}}]
      (is (= 900719925474098 (cl/maintenance-margin s 1 {1 fx/i53-max 2 fx/i53-max} markets)))
      (is (= 1801439850948198 (cl/initial-margin s 1 {1 fx/i53-max 2 fx/i53-max} markets))))))

;; ── the exact quotient: floor(a x b / c) without the product ─────────────────
;;
;; The product-then-divide class (falsify-11's secondary finding and its
;; siblings): `entry-notional x closed / size`, the vault share price, the ADL
;; leverage and score, the oracle deviation. The PRODUCT overflows 2^53 while
;; the quotient is in the domain (7.2e14 x 1e12 / 2e12 = 3.6e14), and then the
;; two runtimes divide different numbers — the JVM the promoted exact integer
;; (or a bare overflow throw past 2^63), JS a rounded double. `fx/fmul` folds
;; the division into the multiplication and never forms the product.

(deftest fmul-is-the-exact-floor-quotient
  (testing "exact small cases, floor semantics on every sign"
    (is (= 2 (fx/fmul 3 4 5)))
    (is (= 8 (fx/fmul 7 5 4)))
    (is (= -2 (fx/fmul -3 2 4)) "floor, toward negative infinity")
    (is (= -2 (fx/fmul 3 -2 4)))
    (is (= 1 (fx/fmul -3 -2 4))))
  (testing "the product is never formed"
    (is (= 1000000000000 (fx/fmul 1000000000000 1000000000000 1000000000000)))
    (is (= fx/i53-max (fx/fmul fx/i53-max fx/i53-max fx/i53-max))))
  (testing "VALUE: a quotient past the ceiling clamps like pmul, never throws"
    (is (= fx/i53-max (fx/fmul fx/i53-max fx/i53-max 1)))
    (is (= fx/i53-min (fx/fmul (- fx/i53-max) fx/i53-max 1))))
  (testing "the odd-carry core case: residues folded by comparison carry"
    (is (= 4503599627370495
           (fx/fmul 4503599627370497 4503599627370495 4503599627370496)))))

(deftest vault-shares-price-with-an-exact-quotient
  (testing "VALUE: minted = floor(amount x total / pool); the product is 1.8e16,
            past the ceiling, the quotient under it"
    (let [s (-> (cl/new-state)
                (assoc-in [:accounts 1 :collateral] 3807572383388538)
                (assoc-in [:accounts 2 :collateral] 1940371675451696)
                (assoc-in [:vaults 2 :total-shares] 2503842113501302))
          s' (cl/vault-deposit s 1 2 3807572383388538)]
      (is (= 4913264919471391 (get-in s' [:vaults 2 :shares 1])))))
  (testing "VALUE: payout = floor(shares x pool / total); the product is 3.3e16"
    (let [s (-> (cl/new-state)
                (assoc-in [:accounts 2 :collateral] 6450328040642089)
                (assoc-in [:vaults 2] {:total-shares 6317976265679753
                                       :shares {1 5056245340839859}}))
          s' (cl/vault-withdraw s 1 2 5056245340839859 6450328040642089)]
      (is (= 5162165815587510 (get-in s' [:accounts 1 :collateral]))))))

(deftest a-reducing-fill-retires-the-exact-closed-basis
  ;; The product is 7.2e26; the quotient 3.6e14 is in the domain. The old
  ;; pmul clamp retired a basis of 4503599 and mispriced the position.
  (let [s (-> (cl/new-state)
              (assoc-in [:accounts 1 :positions 1]
                        {:size 2000000000000 :entry-notional 720000000000000}))
        s' (cl/apply-fill s 1 1 -1000000000000 720 0)]
    (is (= 360000000000000 (:entry-notional (cl/position s' 1 1)))
         "VALUE: the pro-rated closed basis, exact")
    (is (= 360000000000000 (get-in s' [:accounts 1 :collateral]))
         "VALUE: realized = price x closed - closed-basis")))

(deftest adl-scores-with-an-exact-quotient
  ;; leverage = floor(notional x rate-scale / base) is a 3.7e24 product and
  ;; the score floor(profit x leverage / rate-scale) a 1.5e24 product; both
  ;; quotients are in the domain.
  (let [s (-> (cl/new-state)
              (assoc-in [:accounts 3 :positions 3]
                        {:size 9349941134 :entry-notional 615628472864798})
              (assoc-in [:accounts 3 :collateral] 4595685917346004))
        r (liq/adl-ranking s 3 400273 -1)]
    (is (= 1 (count r)))
    (is (= 3 (:account (first r))))
    (is (= 1515362229667056 (:score (first r))) "VALUE: the exact score")))

(deftest oracle-deviation-clamps-its-quotient
  (is (= 100000000 (oc/deviation 110 100)) "10% off, in rate-scale units")
  (is (= 500000000 (oc/deviation 5 10)) "below the reference is not negative")
  (is (= 0 (oc/deviation 110 0)) "no reference, no deviation")
  (testing "VALUE: the quotient of a 5e24 product clamps to the ceiling —
            it used to return 7.1e23, out of the domain, from a monitoring path"
    (is (= fx/i53-max (oc/deviation 5000000000000007 7)))))

;; ── the folds that feed a root or a decision saturate ───────────────────────
;;
;; The accumulator sweep routed every `(fnil + 0)` through `fx/acc` and the
;; notional package every money sum through `fx/sadd`/`fx/acc` — but the RAW
;; `+`/`reduce +` folds were not in those sweeps, and four of them are read
;; into a root or a decision:
;;
;; - position `:size` is folded per fill with `(+ size delta)` and is ROOT-
;;   ENCODED (torihiki.state encode-clearing-account's sibling — the position
;;   leaf). Two honest fills walk it past 2^53: the runtimes hold different
;;   sizes (falsify-8's class) and the liquidation slices then feed an
;;   out-of-domain qty to `place!`.
;; - `stake-of` (whose word a validator's vote carries) and `bonded` (what
;;   `free-collateral` subtracts) are DERIVED sums of in-domain per-key values
;;   that cross 2^53 in aggregate — the falsify-14 class at a decision.
;; - `volume-of`'s `(cur + prev)` is the fee tier's own read of two writes
;;   that are each clamped — the sum is not.
;; - the ROOT PREIMAGE: encode-clearing-account folds the bonds and unbonding
;;   sums with raw `reduce + 0` into the account leaf bytes. This is falsify-
;;   14's exact mechanism one layer down: the preimage stringifies the sum, so
;;   the root hash itself forks with no throw anywhere.
;;
;; And one store door of the same class: `trg/valid?` was shape-only, so a raw
;; :trigger with an out-of-i53 :trigger-price was STORED by the engine even
;; though validate refuses it (:bad-trigger-price). Pins are VALUES (clamps
;; and state-identical no-ops) — a clamp is total.

(deftest position-size-saturates-at-the-ceiling
  ;; :size is a root-encoded accumulator; (+ size delta) was the one fold the
  ;; sweeps missed. VALUE: the clamp.
  (let [s (-> (cl/new-state)
              (assoc-in [:accounts 1 :collateral] 1000000)
              (assoc-in [:accounts 1 :positions 1]
                        {:size (- fx/i53-max 1) :entry-notional 0 :isolated nil}))
        s' (cl/apply-fill s 1 1 10 0 0)]
    (is (= fx/i53-max (:size (cl/position s' 1 1)))
        "was i53-max + 9 = 2^53 + 8, held by no two runtimes alike")
    (is (fx/in-domain? (:size (cl/position s' 1 1)))))
  (testing "and at the floor"
    (let [s (-> (cl/new-state)
                (assoc-in [:accounts 1 :collateral] 1000000)
                (assoc-in [:accounts 1 :positions 1]
                          {:size (inc fx/i53-min) :entry-notional 0 :isolated nil}))
          s' (cl/apply-fill s 1 1 -10 0 0)]
      (is (= fx/i53-min (:size (cl/position s' 1 1))) "was i53-min - 9")))
  (testing "below the ceiling folding is unchanged"
    (let [s (-> (cl/new-state)
                (assoc-in [:accounts 1 :collateral] 1000000)
                (assoc-in [:accounts 1 :positions 1]
                          {:size 5 :entry-notional 0 :isolated nil}))]
      (is (= 15 (:size (cl/position (cl/apply-fill s 1 1 10 0 0) 1 1)))))))

(deftest stake-of-saturates-at-the-ceiling
  ;; The validator's weight is a derived sum of in-domain per-account bonds.
  (let [s (assoc (cl/new-state) :bonds {1 {9 (- fx/i53-max 1)} 2 {9 2}})]
    (is (= fx/i53-max (cl/stake-of s 9))
        "was 2^53 — the weight left the domain and the runtimes disagreed"))
  (testing "and at the floor"
    (is (= fx/i53-min
           (cl/stake-of (assoc (cl/new-state)
                               :bonds {1 {9 (inc fx/i53-min)} 2 {9 -2}})
                        9))))
  (testing "below the ceiling folding is unchanged"
    (is (= 12 (cl/stake-of (assoc (cl/new-state)
                                  :bonds {1 {9 5} 2 {9 7}})
                           9)))))

(deftest bonded-saturates-at-every-sum
  ;; bonds + unbonding: two inner folds and their outer +. All three clamp.
  (let [s (-> (cl/new-state)
              (assoc-in [:bonds 1] {10 (- fx/i53-max 1) 11 2})
              (assoc-in [:unbonding 1] [{:amount 5 :at 100}]))]
    (is (= fx/i53-max (cl/bonded s 1)) "was 2^53 + 6"))
  (testing "the outer + clamps too — each part in-domain, the total not"
    (let [s (-> (cl/new-state)
                (assoc-in [:bonds 1] {10 (- fx/i53-max 3) 11 2})
                (assoc-in [:unbonding 1] [{:amount 5 :at 100}]))]
      (is (= fx/i53-max (cl/bonded s 1)) "was i53-max + 4")))
  (testing "below the ceiling folding is unchanged"
    (let [s (-> (cl/new-state)
                (assoc-in [:bonds 1] {10 7})
                (assoc-in [:unbonding 1] [{:amount 5 :at 100}]))]
      (is (= 12 (cl/bonded s 1))))))

(deftest rolling-volume-read-sum-saturates
  ;; :cur and :prev are each clamped on the way in; the FEE TIER's read of
  ;; their sum was raw.
  (let [s (assoc-in (cl/new-state) [:volume 1] {:epoch 0 :cur (- fx/i53-max 1)
                                                :prev 2})]
    (is (= fx/i53-max (cl/volume-of s 1 0))
        "was 2^53 — one tier decision per runtime"))
  (testing "below the ceiling folding is unchanged"
    (is (= 12 (cl/volume-of (assoc-in (cl/new-state) [:volume 1]
                                      {:epoch 0 :cur 5 :prev 7})
                            1 0)))))

(defn- root-ex
  "A full genesis exchange (state-root walks the governance and market
  encodings too) with its clearing swapped for the one under test."
  [cl]
  (assoc (st/new-exchange {:market (cl/market {:id 1 :max-leverage 40 :tick 1 :lot 1})
                           :book-opts {:n-levels 64 :cap 64 :ev-cap 64}})
         :clearing cl))

(deftest root-preimage-sums-saturate
  ;; falsify-14's mechanism in the account leaf bytes: the bonds and unbonding
  ;; sums go into the preimage with raw `reduce + 0`. Two states that differ
  ;; only past the ceiling must hash to ONE root, not two.
  (let [clA (-> (cl/new-state)
                (assoc-in [:accounts 1 :collateral] 0)
                (assoc-in [:bonds 1] {9 (- fx/i53-max 1) 10 2}))
        clB (-> (cl/new-state)
                (assoc-in [:accounts 1 :collateral] 0)
                (assoc-in [:bonds 1] {9 (- fx/i53-max 1) 10 1}))]
    (is (= (st/state-root (root-ex clA))
           (st/state-root (root-ex clB)))
        "the preimage sums clamp to one value — one root, not two"))
  (testing "the unbonding sum is the same preimage fold"
    (let [clA (-> (cl/new-state)
                  (assoc-in [:accounts 1 :collateral] 0)
                  (assoc-in [:unbonding 1] [{:amount (- fx/i53-max 1) :at 100}
                                            {:amount 2 :at 100}]))
          clB (-> (cl/new-state)
                  (assoc-in [:accounts 1 :collateral] 0)
                  (assoc-in [:unbonding 1] [{:amount (- fx/i53-max 1) :at 100}
                                            {:amount 1 :at 100}]))]
      (is (= (st/state-root (root-ex clA))
             (st/state-root (root-ex clB))))))
  (testing "below the ceiling the root still notices a changed bond"
    (let [clA (-> (cl/new-state)
                  (assoc-in [:accounts 1 :collateral] 0)
                  (assoc-in [:bonds 1] {9 5 10 2}))
          clB (-> (cl/new-state)
                  (assoc-in [:accounts 1 :collateral] 0)
                  (assoc-in [:bonds 1] {9 5 10 1}))]
      (is (not= (st/state-root (root-ex clA))
                (st/state-root (root-ex clB)))))))

(deftest the-trigger-store-door-is-gated-too
  ;; validate refuses an out-of-i53 :trigger-price with :bad-trigger-price;
  ;; the engine's own gate (trg/valid?) was shape-only and STORED the same
  ;; trigger. The safety net must answer with a no-op, not a store.
  (let [ex (ex-for)]
    (is (= ex (st/apply-tx ex {:tx :trigger :account 1 :market 1
                               :trigger-price (inc fx/i53-max) :direction :above
                               :order {:side 0 :level 1 :qty 1}}))
        "VALUE: state-identical no-op — was a store of a value no runtime mirrors"))
  (testing "in-domain still stores"
    (is (some? (get-in (st/apply-tx (ex-for) {:tx :trigger :account 1 :market 1
                                              :trigger-price 100 :direction :above
                                              :order {:side 0 :level 1 :qty 1}})
                       [:triggers 1])))))

;; ── division by zero ────────────────────────────────────────────────────────

(deftest a-zero-divisor-saturates-the-same-way-everywhere
  ;; `fdiv` is the single floor-division primitive of the determinism contract.
  ;; With a zero divisor the two runtimes used to fail DIFFERENTLY: the JVM
  ;; threw a bare ArithmeticException out of Math/floorDiv — a halted chain
  ;; wherever it was reached — while JS divided to Infinity and kept computing
  ;; (falsify-6's shape one primitive down: one runtime halts, the other forks).
  ;; Saturation is the total answer, the same clamp family as `sadd`.
  (testing "VALUE pins: the sign of the dividend picks the ceiling"
    (is (= fx/i53-max (fx/fdiv 1 0)))
    (is (= fx/i53-max (fx/fdiv fx/i53-max 0)))
    (is (= fx/i53-min (fx/fdiv -1 0)))
    (is (= 0 (fx/fdiv 0 0)) "zero over nothing is not a sign case"))
  (testing "fmod keeps its identity a = b*q + r with b = 0: q saturates, b*q = 0"
    (is (= 7 (fx/fmod 7 0)))
    (is (= -7 (fx/fmod -7 0))))
  (testing "regression guards — the non-zero path keeps exact floor semantics
            (these pass on both engines today; they pin the rewrite above)"
    (is (= -1 (fx/fdiv -1 2)) "floor, toward negative infinity — not quot")
    (is (= -2 (fx/fdiv -3 2)))
    (is (= 4503599627370495 (fx/fdiv fx/i53-max 2)))
    (is (= 1 (fx/fdiv fx/i53-max 4503599627370496))
        "2^53-1 over 2^52: the quotient sits a half-ulp below 2 and must floor
         to 1, not round up to 2")
    (is (= -2 (fx/fdiv fx/i53-min 4503599627370496)))))

(deftest a-zero-priced-level-is-affordable-not-a-division
  ;; Level 0 is a VALID ladder level — `validate-order-shape` admits it
  ;; (`int-in? level 0 (dec n-levels)`) and a resting order at level 0 is a
  ;; legal signed transaction. `bk/impact-price` divided the reference notional
  ;; by the level to see how many lots it could afford: `(fx/fdiv left level)`
  ;; with level = 0 is an ArithmeticException on the JVM INSIDE the
  ;; funding-premium walk — a legal tx series halting every validator at the
  ;; same place, falsify-6's class — while JS took the whole level at a
  ;; price of nothing. A zero-priced level is affordable, not a division.
  (let [b (bk/new-book {:n-levels 4096 :cap 1024 :ev-cap 64})]
    (bk/place! b bk/bid 5 10 0 1)
    (bk/place! b bk/bid 0 10 0 2)
    (is (= -1 (bk/impact-price b bk/bid 60))
        "VALUE: unspent notional at a zero-priced level is the all-or-nothing
         refusal (-1), identical on both engines — not a throw on one of them"))
  (testing "regression guard — a book with no zero level prices as before"
    (let [b (bk/new-book {:n-levels 4096 :cap 1024 :ev-cap 64})]
      (bk/place! b bk/bid 5 10 0 1)
      (bk/place! b bk/bid 3 10 0 2)
      (is (= 4 (bk/impact-price b bk/bid 60))
          "59 spent over 13 filled at levels 5 and 3, floor 4 — pre-existing
           behavior, unchanged by this package"))))

;; ── fdiv's inputs: the last raw +/- into a decision ─────────────────────────
;;
;; 2026-10-26 16:20 measurement (kbb probes): `fdiv` itself is EXACT for
;; in-domain inputs — the "cljs fdiv rounds past 2^52" hypothesis is
;; exonerated. The fork was raw `+`/`-` FEEDING fdiv (falsify-8's class, one
;; step earlier): the true difference 2^53+3 is an odd number no f64 holds,
;; so JS rounds it to 2^53+4 before the division runs and the quotient lands
;; one high — `(fx/fdiv (- 9007199254740991 -4) 2)` returned 4503599627370498
;; on kbb against JVM floorDiv's 4503599627370497. Same signed input, two
;; chains. `fdiv-diff` divides FIRST and combines the pieces; the difference
;; is never formed.

(deftest fdiv-diff-divides-without-forming-the-difference
  (testing "exact where the raw difference was exact — byte-identical results"
    (is (= 2 (fx/fdiv-diff 7 1 3)))
    (is (= -2 (fx/fdiv-diff 1 7 3)))
    (is (= 1 (fx/fdiv-diff 7 2 3)))
    (is (= -3 (fx/fdiv-diff -7 1 3)))
    (is (= -2 (fx/fdiv-diff 7 1 -3)))
    (is (= 0 (fx/fdiv-diff 5 5 7))))
  (testing "floor semantics, toward negative infinity, on both sides of zero"
    (is (= -1 (fx/fdiv-diff 3 4 3)))
    (is (= -2 (fx/fdiv-diff 5 2 -2)) "floor, not trunc: 3/-2 rounds down")
    (is (= 2 (fx/fdiv-diff -7 1 -3)) "and -8/-3 rounds down to 2, not up")
    (is (= 4503599627370495 (fx/fdiv 9007199254740991 2))
        "invariant pin (green always): fdiv itself is exact in-domain —
         the 2026-10-26 exoneration of the rounding hypothesis"))
  (testing "the measured boundary values: floor((2^53+3)/2), never formed"
    (is (= 4503599627370497 (fx/fdiv-diff 9007199254740991 -4 2))
        "the raw difference rounds to 2^53+4 on JS; the quotient came out …498")
    (is (= 4503599627370497 (fx/fdiv-diff -9007199254740991 4 -2))
        "short twin: floor((-(2^53+3))/-2), the same exact value"))
  (testing "a quotient past the ceiling clamps like pmul, not forks"
    (is (= fx/i53-max (fx/fdiv-diff 9007199254740991 -2 1))
        "true quotient 2^53+1")
    (is (= fx/i53-min (fx/fdiv-diff -9007199254740991 2 1))
        "true quotient -(2^53+1)")))

(deftest bankruptcy-price-divides-a-difference-it-never-forms
  ;; The liquidation sweep's decision price. Out-of-domain INPUTS were never
  ;; needed: entry-notional i53-max against collateral -4 is two in-domain
  ;; numbers whose DIFFERENCE is not.
  (testing "small exact cases are unchanged"
    (is (= 200 (liq/bankruptcy-price {:size 10 :entry-notional 5000} 3000)))
    (is (= 0 (liq/bankruptcy-price {:size 0 :entry-notional 5000} 3000))))
  (testing "the measured boundary: floor((2^53+3)/2)"
    (is (= 4503599627370497 (liq/bankruptcy-price {:size 2 :entry-notional 9007199254740991} -4))
        "RED before the fix on kbb (…498); JVM floorDiv was already exact")
    (is (= 4503599627370497 (liq/bankruptcy-price {:size -2 :entry-notional -9007199254740991} 4))
        "short twin, same value, same two-runtime split"))
  (testing "a true quotient past the ceiling clamps on both runtimes"
    (is (= fx/i53-max (liq/bankruptcy-price {:size 1 :entry-notional 9007199254740991} -2))
        "true quotient 2^53+1 — RED on ALL legs before the fix
         (JVM returned 2^53+1, JS its rounding)")
    (is (= fx/i53-min (liq/bankruptcy-price {:size 1 :entry-notional -9007199254740991} 2))
        "true quotient -(2^53+1)")))

(deftest cancel-all-total-saturates
  ;; The return-total fold of cancel-all! (the item PR #68 deferred): two raw
  ;; `+` accumulations of cancelled quantities.
  (testing "below the ceiling the total is unchanged"
    (let [b (bk/new-book {:n-levels 1024 :cap 4096 :ev-cap 4096})]
      (bk/place! b bk/bid 10 5 0 7)
      (bk/place! b bk/bid 11 7 0 7)
      (bk/place! b bk/ask 12 3 0 7)
      (bk/place! b bk/ask 13 4 0 8)
      (is (= 15 (bk/cancel-all! b 7)) "owner 8's ask is not ours")
      (is (= 0 (bk/cancel-all! b 7)) "second call finds nothing")))
  (testing "two cancelled bids summing to 2^53+1 clamp to the ceiling"
    (let [b (bk/new-book {:n-levels 1024 :cap 4096 :ev-cap 4096})]
      (bk/place! b bk/bid 10 4503599627370496 0 7)
      (bk/place! b bk/bid 11 4503599627370497 0 7)
      (is (= fx/i53-max (bk/cancel-all! b 7))
          "true total 2^53+1 — RED on ALL legs before the fix"))))

(deftest impact-mid-divides-a-sum-it-never-forms
  ;; Same class in the mark path. Currently unreachable at the boundary
  ;; (impact prices stay below n-levels) — pinned as an invariant shape, not
  ;; a red-green claim: the midpoint divides the pair through fdiv-diff.
  (let [b (bk/new-book {:n-levels 65536 :cap 8192 :ev-cap 8192})]
    (dotimes [i 10]
      (bk/place! b bk/bid (- 1000 1 i) 500 0 1)
      (bk/place! b bk/ask (+ 1000 1 i) 500 0 2))
    (let [pb (bk/impact-price b bk/bid 20000)
          pa (bk/impact-price b bk/ask 20000)]
      (is (pos? pb) "the book absorbs the reference size on both sides")
      (is (pos? pa))
      (is (= (fx/fdiv-diff pa (- pb) 2) (mk/impact-mid b 20000))
          "the midpoint is floor((pa - (-pb))/2) — the sum never forms"))))

;; ── the tier-shape door (2026-10-26 20:27 measurement) ──────────────────────
;;
;; `:margin-tiers` / `:fee-tiers` entries were stored RAW by `:list-market` /
;; `:amend-market` and only range-checked — completeness was never checked.
;; A tier in the shape `cl/market` itself documents (`{:max-notional n
;; :max-leverage l}` — the rates are derived at GENESIS but NOT at listing)
;; passed validate, and the first read threw mid-apply, inside apply-block:
;;   `tier-for`:        `:max-notional` missing     → `(<= notional nil)`
;;   `rates-for`:       the two rates missing       → `mul-rate`'s `check` on
;;                       nil, and `initial-margin-rate-for`'s `(max nil …)`
;;   `fee-rates-for`:   `:min-volume` missing       → `(<= nil v)`
;; One bridge-signed transaction, every validator halts at the same place —
;; falsify-6/7's class through a door the earlier gates left open. The gate
;; refuses the tier WHOLE (`:missing-field`) and the engine answers with a
;; no-op. And a NEGATIVE margin rate passed `rates-ok?`'s symmetric ±100%
;; range: a negative requirement is not a requirement, it is free leverage.

(deftest tier-shape-gate-refuses-incomplete-tiers
  (let [ex (ex-for)]
    (testing "REASON: a tier missing a field its reader derefs is :missing-field"
      (is (= :missing-field
             (api/validate ex {:tx :list-market :account 1 :market 2
                               :spec {:tick 1 :lot 1
                                      :margin-tiers [{:max-notional 100
                                                      :max-leverage 10}]}}))
          "the shape cl/market documents — rates are derived at genesis, not at
           listing; this PASSED validate and threw in the first sweep")
      (is (= :missing-field
             (api/validate ex {:tx :list-market :account 1 :market 2
                               :spec {:tick 1 :lot 1
                                      :margin-tiers [{:max-notional 100
                                                      :initial-margin-rate 25000}]}}))
          ":maintenance-margin-rate missing — mul-rate's check on nil, mid-margin")
      (is (= :missing-field
             (api/validate ex {:tx :list-market :account 1 :market 2
                               :spec {:tick 1 :lot 1
                                      :margin-tiers [{:initial-margin-rate 25000
                                                      :maintenance-margin-rate 12500}]}}))
          ":max-notional missing — tier-for's (<= notional nil)")
      (is (= :missing-field
             (api/validate ex {:tx :amend-market :account 1 :market 1
                               :spec {:fee-tiers [{:taker-fee-rate 100}]}}))
          ":min-volume missing — fee-rates-for's (<= nil v)")
      (is (= :missing-field
             (api/validate ex {:tx :list-market :account 1 :market 2
                               :spec {:tick 1 :lot 1 :margin-tiers 5}}))
          "a schedule that is not a collection — (seq 5) is itself a throw"))
    (testing "VALUE: a complete schedule passes (invariant pins — green from birth)"
      (is (nil? (api/validate ex {:tx :list-market :account 1 :market 2
                                  :spec {:tick 1 :lot 1
                                         :margin-tiers [{:max-notional 100
                                                         :initial-margin-rate 25000
                                                         :maintenance-margin-rate 12500}]
                                         :fee-tiers [{:min-volume 0
                                                      :taker-fee-rate 50}]}})))
      (is (nil? (api/validate ex {:tx :amend-market :account 1 :market 1
                                  :spec {:margin-tiers []}}))
          "an empty schedule is 'no schedule', not a missing field")
      (is (nil? (api/validate ex {:tx :amend-market :account 1 :market 1
                                  :spec {:fee-tiers [{:min-volume 1000000}]}}))
          "tier rates are optional — fee-rates-for falls back to the flat rates"))))

(deftest negative-margin-rates-are-refused
  (let [ex (ex-for)]
    (testing "REASON: a margin rate below zero is :rate-too-high"
      (is (= :rate-too-high
             (api/validate ex {:tx :list-market :account 1 :market 2
                               :spec {:tick 1 :lot 1
                                      :margin-tiers [{:max-notional 100
                                                      :initial-margin-rate -25000
                                                      :maintenance-margin-rate 12500}]}})))
      (is (= :rate-too-high
             (api/validate ex {:tx :amend-market :account 1 :market 1
                               :spec {:maintenance-margin-rate -1}}))))
    (testing "a fee may still be negative — a rebate is a fee with a sign"
      (is (nil? (api/validate ex {:tx :amend-market :account 1 :market 1
                                  :spec {:taker-fee-rate (- fx/rate-scale)}})))
      (is (nil? (api/validate ex {:tx :amend-market :account 1 :market 1
                                  :spec {:fee-tiers [{:min-volume 0
                                                      :maker-fee-rate -25000}]}}))))
    (testing "VALUE: zero is a requirement of nothing, and passes"
      (is (nil? (api/validate ex {:tx :list-market :account 1 :market 2
                                  :spec {:tick 1 :lot 1
                                         :margin-tiers [{:max-notional 100
                                                         :initial-margin-rate 0
                                                         :maintenance-margin-rate 0}]}}))))))

(deftest tier-shape-gate-is-a-no-op-in-the-engine-too
  ;; The validate-layer gate answers with its REASON; the engine's own net —
  ;; the one a direct `apply-tx` caller meets — answers with a no-op, so a
  ;; malformed tier can never be stored and read back as a throw mid-apply.
  ;; Market 1 carries a real book here because `:amend-market` rebuilds the
  ;; resting-order cache over it.
  (let [ex (-> (ex-for)
               (assoc :bridge-authority 1)
               (assoc-in [:books 1] (bk/new-book {:n-levels 64 :cap 32 :ev-cap 32})))]
    (testing "VALUE: state-identical no-op — was a store whose first read threw"
      (is (= ex (st/apply-tx ex {:tx :list-market :account 1 :market 2
                                 :spec {:tick 1 :lot 1
                                        :margin-tiers [{:max-notional 100
                                                        :max-leverage 10}]}})))
      (is (= ex (st/apply-tx ex {:tx :amend-market :account 1 :market 1
                                 :spec {:fee-tiers [{:taker-fee-rate 100}]}}))))
    (testing "a complete schedule stores, and reads through the function that threw"
      (let [ex' (st/apply-tx ex {:tx :list-market :account 1 :market 2
                                 :spec {:tick 1 :lot 1
                                        :margin-tiers [{:max-notional 100
                                                        :initial-margin-rate 25000
                                                        :maintenance-margin-rate 12500}]}})]
        (is (= [25000 12500] (cl/rates-for (get-in ex' [:markets 2]) 50)))
        (is (= [25000 12500] (cl/rates-for (get-in ex' [:markets 2]) 500000))
            "past the last tier the last tier applies — a position does not
             escape the schedule by being bigger than anyone anticipated")))))

;; ── the flat spec-shape door (2026-10-27 08:2x audit) ───────────────────────
;;
;; The tier gate judged the SCHEDULES; the FLAT spec beside them was judged
;; only by `spec-ok?`, which caps integers to the i53 domain and waves every
;; non-integer through ("they are judged where they are used"). They are used
;; in two places that cannot judge them:
;;
;;   1. `encode-market-spec` folds `:tick`, `:lot`, `:max-leverage`,
;;      `:open-interest-cap` and every tier's `:max-leverage` RAW into the
;;      STATE ROOT through `enc-int`, whose whole contract is "one i53 as 8
;;      bytes". A float folds to bytes no other runtime reproduces and a
;;      string dies in `(neg? v)` — the falsify-14 class, in the authenticated
;;      encoding itself. A spot `:asset` is worse: it becomes a KEY in
;;      `:balances`/`:committed`, and `encode-clearing-account` folds the keys.
;;   2. Two readers COMPARE them: `cl/set-leverage`'s `(> lev (:max-leverage
;;      market 1))` (a string is a ClassCastException on the JVM and a silent
;;      coercion on JS — falsify-6/7's halt class through one bridge-signed
;;      `:list-market`, then the first `:set-leverage`) and `api/validate`'s
;;      open-interest-cap `>`, which runs INSIDE apply-block.
;;
;; A float `:max-leverage` compares fine and stores badly — the tier gate's
;; own words for `:max-notional` — and a float past 2^53 lets a stored
;; `:set-leverage` value through that JS cannot mirror (falsify-8). So every
;; flat field is shaped where it enters, exactly like the tiers: refused
;; `:missing-field` at `torihiki.api/validate`, no-op in `apply-tx` — the
;; readers stay total by contract, not by luck.

(deftest flat-spec-shape-gate-refuses-unstorable-values
  (let [ex (ex-for)]
    (testing "REASON: :max-leverage is a count, not a string and not a fraction"
      (is (= :missing-field
             (api/validate ex {:tx :list-market :account 1 :market 2
                               :spec {:tick 1 :lot 1 :max-leverage "20"}}))
          "cl/set-leverage compares it — (> lev \"20\") is a ClassCastException
           on the JVM and a string coercion on JS")
      (is (= :missing-field
             (api/validate ex {:tx :list-market :account 1 :market 2
                               :spec {:tick 1 :lot 1 :max-leverage 2.5}}))
          "compares fine and stores badly")
      (is (= :missing-field
             (api/validate ex {:tx :list-market :account 1 :market 2
                               :spec {:tick 1 :lot 1 :max-leverage 0}})))
      (is (= :missing-field
             (api/validate ex {:tx :amend-market :account 1 :market 1
                               :spec {:max-leverage -5}}))
          "in-domain and meaningless — spec-ok? waved it through"))
    (testing "REASON: the cap is compared at validate and folded into the root"
      (is (= :missing-field
             (api/validate ex {:tx :list-market :account 1 :market 2
                               :spec {:tick 1 :lot 1 :open-interest-cap 4.5e17}}))
          "an integral double past 2^53 — and spec-ok?'s (integer? v) is TRUE
           here (JS: an integral double) and FALSE on the JVM (a Double), so
           the two runtimes answered THIS transaction differently at the door:
           :missing-field on one, a store on the other")
      (is (= :missing-field
             (api/validate ex {:tx :amend-market :account 1 :market 1
                               :spec {:open-interest-cap "abc"}}))))
    (testing "REASON: a spot :asset is a balance KEY — the encoder folds the keys"
      (is (= :missing-field
             (api/validate ex {:tx :list-market :account 1 :market 2
                               :spec {:tick 1 :lot 1 :kind :spot :asset "XAU"}})))
      (is (= :missing-field
             (api/validate ex {:tx :list-market :account 1 :market 2
                               :spec {:tick 1 :lot 1 :kind :spot :asset 7.5}}))))
    (testing "REASON: a tier :max-leverage is folded raw by the encoder too —
              the tier gate shaped :max-notional and the rates and left it out"
      (is (= :missing-field
             (api/validate ex {:tx :list-market :account 1 :market 2
                               :spec {:tick 1 :lot 1
                                      :margin-tiers [{:max-notional 100
                                                      :max-leverage 2.5
                                                      :initial-margin-rate 25000
                                                      :maintenance-margin-rate 12500}]}}))))
    (testing "REASON: the amend path drops :tick/:lot but still stores the rest
              of the spec — a float tick is junk at either door"
      (is (= :missing-field
             (api/validate ex {:tx :amend-market :account 1 :market 1
                               :spec {:tick 2.5}}))))
    (testing "VALUE: shaped fields pass (invariant pins — green from birth)"
      (is (nil? (api/validate ex {:tx :list-market :account 1 :market 2
                                  :spec {:tick 1 :lot 1 :max-leverage 20
                                         :open-interest-cap 1000000
                                         :kind :spot :asset 7}})))
      (is (nil? (api/validate ex {:tx :list-market :account 1 :market 2
                                  :spec {:tick 1 :lot 1 :max-leverage 20
                                         :open-interest-cap 0}}))
          "zero is storable and total — a market that allows no open interest")
      (is (nil? (api/validate ex {:tx :list-market :account 1 :market 2
                                  :spec {:tick 1 :lot 1
                                         :margin-tiers [{:max-notional 100
                                                         :max-leverage 10
                                                         :initial-margin-rate 25000
                                                         :maintenance-margin-rate 12500}]}}))
          "a tier's :max-leverage is optional and, when present, a count"))))

(deftest flat-spec-shape-gate-is-a-no-op-in-the-engine-too
  ;; The validate-layer gate answers with its REASON; the engine's own net —
  ;; the one a direct `apply-tx` caller meets — answers with a no-op, so an
  ;; unstorable field can never be stored and folded into the root later.
  (let [ex (-> (ex-for)
               (assoc :bridge-authority 1)
               (assoc-in [:books 1] (bk/new-book {:n-levels 64 :cap 32 :ev-cap 32})))]
    (testing "VALUE: state-identical no-op — was a store the encoder would fold"
      (is (= ex (st/apply-tx ex {:tx :list-market :account 1 :market 2
                                 :spec {:tick 1 :lot 1 :max-leverage "20"}})))
      (is (= ex (st/apply-tx ex {:tx :amend-market :account 1 :market 1
                                 :spec {:open-interest-cap "abc"}}))))
    (testing "VALUE: shaped fields store (invariant pin — green from birth)"
      (let [ex' (st/apply-tx ex {:tx :list-market :account 1 :market 2
                                 :spec {:tick 1 :lot 1 :max-leverage 20
                                        :open-interest-cap 1000000
                                        :kind :spot :asset 7}})]
        (is (= 20 (get-in ex' [:markets 2 :max-leverage])))
        (is (= 7 (get-in ex' [:markets 2 :asset])))))))
