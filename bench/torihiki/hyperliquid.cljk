(ns torihiki.hyperliquid
  "The execution layer measured on the axis Hyperliquid publishes.

  `torihiki.bench` times the order book alone. Hyperliquid's ~200k orders/sec
  is not a book figure: its own documentation says the bottleneck is
  EXECUTION, i.e. the whole state machine. So this drives the whole state
  machine — `torihiki.state/apply-block` with validation, margin, fees, the
  end-of-block liquidation sweep — and times it in four stages:

    :execution             apply-block, unauthenticated (a replay of an
                           already-agreed log)
    :execution+auth        the same blocks as signed Ed25519 envelopes,
                           verified by `torihiki.auth` on every transaction
    :execution+pauth       the same, with each block's signatures verified in
                           parallel before the block is applied (see
                           `pre-verify` for why that is sound)
    :execution+pauth+root  plus the SHA-256 state root every block, which is
                           what a validator signs and votes on

  What is NOT here, and is therefore never compared: consensus rounds,
  networking, persistence. Per-block latency is the replica's compute share of
  a block, so beside Hyperliquid's end-to-end latency it is a LOWER bound on
  torihiki's, and it is printed as one.

  ## The workload is generated by the engine it measures

  Cancels must name live orders, and an order id exists only once the book
  has assigned it. So the tape is built block by block against a generation
  run of the engine (untimed): each block's cancels pick from what was resting
  after the previous block, issued by the account that placed it. The timed
  stages then replay those blocks from genesis. Because the engine is
  deterministic the replay must end on the generation run's state root, and
  the run refuses to report if it does not.

  ## It refuses to report a number it did not earn

  - a replay whose root differs from generation: nondeterminism, not speed
  - any `:bad-signature`: the auth stage measured refusals
  - authentication changing which transactions were rejected
  - parallel pre-verification ending on a different root than sequential auth
  - no fill, or no cancel: the mix degenerated into a book that only grows
  - more than 5% of transactions rejected: it would be timing the refusal path

  Each refusal prints its reason and exits 1. A clean run prints one
  `MEASURED` line per stage so the evidence carries its own denominator."
  (:require [kotoba.bytes :as kbytes] [kotoba.lang.edn :as edn]
            [clojure.java.io :as io]
            [torihiki.auth :as auth]
            [torihiki.book :as bk]
            [torihiki.clearing :as cl]
            [torihiki.fixed :as fx]
            [torihiki.state :as st])
  (:import
           [java.security KeyFactory KeyPair KeyPairGenerator Signature]
           [java.security.spec X509EncodedKeySpec]
           [java.util Arrays HashMap]))

(set! *warn-on-reflection* true)

(def ^:const mid 32768)
(def ^:const scan-band 64)
(def chain-id "torihiki-bench-hl-1")

(def market
  (assoc (cl/market {:id 1 :max-leverage 40 :tick 1 :lot 1})
         :taker-fee-rate (fx/bps 3)
         :maker-fee-rate 0))

(defn- genesis []
  (st/new-exchange {:market market
                    :book-opts {:n-levels 65536 :cap 2097152 :ev-cap 1048576}}))

(defn- lcg ^long [^long s]
  (bit-and (unchecked-add (unchecked-multiply s 25214903917) 11) 281474976710655))

(defn- reference []
  (edn/read-string (slurp (io/resource "torihiki/hyperliquid-reference.edn"))))

;; ── workload ────────────────────────────────────────────────────────────────

(defn- resting-near
  "Live orders within `scan-band` ticks of the mid, both sides. Cancels are
  drawn from here, so every cancel names an order that existed when its block
  was built."
  [ex]
  (let [b (get-in ex [:books 1])]
    (vec (for [side [bk/bid bk/ask]
               lvl (range (- mid scan-band) (+ mid scan-band 1))
               o (bk/level-orders b side lvl)]
           o))))

(defn- quote-tx [acct sd spread q]
  {:tx :order :account acct :market 1 :side sd :qty q :flags 0
   :level (if (zero? sd) (- mid 1 spread) (+ mid 1 spread))})

(defn- gen-block
  "One block of `n` transactions: 43% cancels of resting orders, 45% passive
  quotes a few ticks off the mid, 12% IOC takers priced through the spread —
  the mix `torihiki.bench` uses, which reaches a steady resting depth rather
  than a book that only grows. Returns [txs seed']."
  [ex seed n n-accounts]
  (let [resting (resting-near ex)
        nr (count resting)]
    (loop [i 0 s (long seed) txs (transient []) used (transient #{})]
      (if (= i n)
        [(persistent! txs) s]
        (let [s1 (lcg s) s2 (lcg s1) s3 (lcg s2)
              r (rem (bit-shift-right s1 16) 100)
              spread (rem (bit-shift-right s2 16) 40)
              sd (rem (bit-shift-right s3 16) 2)
              acct (+ 100 (rem (bit-shift-right s2 24) n-accounts))
              q (inc (rem (bit-shift-right s3 20) 20))
              target (when (and (< r 43) (pos? nr))
                       (nth resting (rem (bit-shift-right s3 8) nr)))]
          (cond
            (and target (not (contains? used (:oid target))))
            (recur (inc i) s3
                   (conj! txs {:tx :cancel :account (:owner target) :market 1
                               :oid (:oid target)})
                   (conj! used (:oid target)))

            (and (>= r 43) (< r 55))
            (recur (inc i) s3
                   (conj! txs {:tx :order :account acct :market 1 :side sd
                               :qty (inc (rem q 12)) :flags bk/flag-ioc
                               :level (if (zero? sd) (+ mid 30) (- mid 30))})
                   used)

            :else
            (recur (inc i) s3 (conj! txs (quote-tx acct sd spread q)) used)))))))

(defn- funding-block [n-accounts]
  (vec (for [a (range 100 (+ 100 n-accounts))]
         {:tx :deposit :account a :amount 100000000000})))

(defn- generate
  "Blocks 0..n-blocks: block 0 funds the accounts, the rest trade. Returns
  {:blocks [...] :root <generation root>}."
  [n-blocks block-size n-accounts]
  (loop [h 1 ex (st/apply-block (genesis) {:height 0 :ts 0 :txs (funding-block n-accounts)})
         seed 12345
         blocks [{:height 0 :ts 0 :txs (funding-block n-accounts)}]]
    (if (> h n-blocks)
      {:blocks blocks :root (st/state-root ex)}
      (let [[txs seed'] (gen-block ex seed block-size n-accounts)
            block {:height h :ts (* h 200) :txs txs}]
        (recur (inc h) (st/apply-block ex block) (long seed') (conj blocks block))))))

;; ── signatures ──────────────────────────────────────────────────────────────
;;
;; JDK Ed25519 (java.security, no dependency). Public keys travel as base64 of
;; the X.509 encoding; the verifier decodes each key once and caches it, which
;; is what a validator holding a key registry does too. Signing is the
;; client's cost and happens before any clock starts.

(defn- keypairs [n-accounts]
  (let [g (KeyPairGenerator/getInstance "Ed25519")]
    (into {} (for [a (range 100 (+ 100 n-accounts))] [a (.generateKeyPair g)]))))

(defn- b64 ^String [^bytes b] (kbytes/base64-encode b))

(defn- utf8 ^bytes [^String s] (kbytes/utf8-bytes s))

(defn- sign-blocks
  "Wrap every transaction in a signed envelope with the account's next nonce."
  [blocks kps]
  (let [signer (Signature/getInstance "Ed25519")
        pubs (into {} (for [[a ^KeyPair kp] kps] [a (b64 (.getEncoded (.getPublic kp)))]))]
    (first
     (reduce
      (fn [[out nonces] block]
        (let [[txs nonces]
              (reduce (fn [[acc nonces] t]
                        (let [a (:account t)
                              n (inc (get nonces a 0))
                              ^KeyPair kp (kps a)]
                          (.initSign signer (.getPrivate kp))
                          (.update signer (utf8 (auth/signing-payload chain-id a n t)))
                          [(conj acc {:tx t :account a :nonce n :pubkey (pubs a)
                                      :sig (.sign signer)})
                           (assoc nonces a n)]))
                      [[] nonces] (:txs block))]
          [(conj out (assoc block :txs txs)) nonces]))
      [[] {}] blocks))))

(defn- verifier []
  (let [kf (KeyFactory/getInstance "Ed25519")
        v (Signature/getInstance "Ed25519")
        cache (HashMap.)]
    (fn [^String pub ^String payload sig]
      (let [pk (or (.get cache pub)
                   (let [k (.generatePublic kf (X509EncodedKeySpec.
                                                (kbytes/base64-decode-bytes pub)))]
                     (.put cache pub k)
                     k))]
        ;; Total, like the state machine it serves: the JDK THROWS
        ;; (SignatureException from decodeAffinePoint) on a signature whose
        ;; bytes do not decode to a curve point, instead of answering false.
        ;; Uncaught, one malformed signature would throw out of apply-block —
        ;; a halted chain, the thing `torihiki.api` exists to prevent. Found
        ;; by this benchmark's own corrupted-signature check.
        (try
          (.initVerify v ^java.security.PublicKey pk)
          (.update v (utf8 payload))
          (.verify v ^bytes sig)
          (catch java.security.SignatureException _ false))))))

;; ── timing ──────────────────────────────────────────────────────────────────

;; ── parallel pre-verification ───────────────────────────────────────────────
;;
;; Whether a signature is valid does not depend on the exchange state: the
;; signed payload is built from the envelope alone (chain id, account, nonce,
;; tx). So a replica may verify a whole block's signatures in parallel BEFORE
;; applying it, and the sequential application then only has to look the
;; answer up. What stays sequential — and must — is everything that does read
;; state: is this the key bound to the account, is this the expected nonce.
;; `torihiki.auth/check` still makes those checks, in block order; only the
;; curve arithmetic moves.
;;
;; The lookup is keyed by the signature array's identity and also compares the
;; payload string, so a verdict can only be reused for exactly the bytes it was
;; computed over.

(def ^:private threads (.availableProcessors (Runtime/getRuntime)))

(defn- pre-verify
  "Verify every envelope in `txs` on `threads` threads. Returns a verify-fn
  that answers from those verdicts, and refuses anything it was not asked."
  [txs]
  (let [v (vec txs)
        n (count v)
        chunk (max 1 (quot (+ n (dec threads)) threads))
        parts (partition-all chunk v)
        futs (mapv (fn [part]
                     (future
                       (let [verify (verifier)]
                         (mapv (fn [{:keys [account nonce tx pubkey sig]}]
                                 (let [p (auth/signing-payload chain-id account nonce tx)]
                                   [sig p (boolean (verify pubkey p sig))]))
                               part))))
                   parts)
        verdicts (java.util.IdentityHashMap.)]
    (doseq [f futs [sig p ok] @f] (.put verdicts sig [p ok]))
    (fn [_pub payload sig]
      (let [[p ok] (.get verdicts sig)]
        (and (some? p) (= p payload) ok)))))

(defn- run-stage
  "Apply every block from genesis. Block 0 (funding) is applied untimed; each
  trading block is timed individually — including, for `:parallel-auth?`, the
  parallel pre-verification of that block. Returns the final exchange,
  per-block nanoseconds, and per-block rejection vectors."
  [blocks {:keys [auth? parallel-auth? root?]}]
  (let [seq-opts (when auth? {:verify-fn (verifier) :chain-id chain-id})
        opts-for (fn [b] (cond parallel-auth? {:verify-fn (pre-verify (:txs b)) :chain-id chain-id}
                               :else seq-opts))
        ex0 (st/apply-block (genesis) (first blocks) (opts-for (first blocks)))
        trading (rest blocks)
        ns (long-array (count trading))]
    (loop [i 0 ex ex0 bs trading rejected [] events 0]
      (if-let [b (first bs)]
        (let [t0 (System/nanoTime)
              ex' (st/apply-block ex b (opts-for b))
              _ (when root? (st/state-root ex'))
              t1 (System/nanoTime)]
          (aset ns i (- t1 t0))
          (recur (inc i) ex' (rest bs) (conj rejected (:rejected ex'))
                 (+ (long events) (long (bk/event-count (get-in ex' [:books 1]))))))
        {:ex ex :ns ns :rejected rejected :events events}))))

(defn- pct ^double [^longs sorted p]
  (let [n (alength sorted)]
    (/ (aget sorted (min (dec n) (long (Math/floor (* p (dec n)))))) 1e6)))

(defn- summarize [stage {:keys [ns]} n-txs]
  (let [^longs sorted (Arrays/copyOf ^longs ns (alength ^longs ns))
        _ (Arrays/sort sorted)
        total (reduce + 0 (seq ns))
        secs (/ (double total) 1e9)]
    {:stage stage :txs n-txs :total-ns total
     :tps (/ n-txs secs) :p50-ms (pct sorted 0.5) :p99-ms (pct sorted 0.99)}))

(defn- refuse! [reason detail]
  (println (str "REFUSED: " reason))
  (when detail (println (str "  " detail)))
  (System/exit 1))

(defn- fmt [x] (format "%,.0f" (double x)))

(defn -main [& args]
  (let [[n-blocks block-size n-accounts] (map #(Long/parseLong %) args)
        n-blocks (or n-blocks 40) block-size (or block-size 2000) n-accounts (or n-accounts 64)
        _ (println (format "generating %d blocks x %d txs over %d accounts..."
                           n-blocks block-size n-accounts))
        {:keys [blocks root]} (generate n-blocks block-size n-accounts)
        trading-txs (reduce + 0 (map (comp count :txs) (rest blocks)))
        kinds (frequencies (for [b (rest blocks) t (:txs b)]
                             (if (= :cancel (:tx t)) :cancel
                                 (if (pos? (bit-and (:flags t 0) bk/flag-ioc)) :ioc :quote))))
        _ (println "signing" (fmt trading-txs) "transactions (client cost, untimed)...")
        signed (sign-blocks blocks (keypairs n-accounts))
        _ (println "warming up (JIT)...")
        _ (dotimes [_ 2]
            (run-stage blocks {}) (run-stage signed {:auth? true})
            (run-stage signed {:auth? true :parallel-auth? true}))
        _ (System/gc)
        a (run-stage blocks {})
        b (run-stage signed {:auth? true})
        p (run-stage signed {:auth? true :parallel-auth? true})
        c (run-stage signed {:auth? true :parallel-auth? true :root? true})
        rej-a (mapv count (:rejected a))
        authed [b p c]
        bad-sig (count (for [s authed r (:rejected s) x r :when (= :bad-signature (:reason x))] x))
        reasons (frequencies (for [r (:rejected a) x r] (:reason x)))
        n-rejected (reduce + 0 rej-a)]
    ;; ── refusals before any number is printed ──
    (when (not= root (st/state-root (:ex a)))
      (refuse! "replay root differs from generation root — nondeterminism, not speed" nil))
    (when (pos? bad-sig)
      (refuse! "signatures refused in the auth stage" (str bad-sig " :bad-signature")))
    (when (some #(not= rej-a (mapv count (:rejected %))) authed)
      (refuse! "authentication changed which transactions were rejected" nil))
    ;; Parallel pre-verification is only an optimisation if it changes nothing
    ;; a validator would sign: its final state must equal sequential auth's.
    (when (not= (st/state-root (:ex b)) (st/state-root (:ex p)))
      (refuse! "parallel pre-verification reached a different state root than sequential auth" nil))
    (when (zero? (:events a))
      (refuse! "no fills — the tape never crossed" nil))
    (when (zero? (get kinds :cancel 0))
      (refuse! "no cancels in the tape — a book that only grows" nil))
    (when (> (* 20 n-rejected) trading-txs)
      (refuse! "more than 5% of transactions rejected — this would time the refusal path"
               (pr-str reasons)))
    (let [rows [(summarize :execution a trading-txs)
                (summarize :execution+auth b trading-txs)
                (summarize :execution+pauth p trading-txs)
                (summarize :execution+pauth+root c trading-txs)]
          ref (reference)
          by-id (into {} (map (juxt :id identity)) (:figures ref))
          hl-tps (:value (by-id :throughput))
          hl-p50 (* 1000 (:value (by-id :latency-median)))
          hl-p99 (* 1000 (:value (by-id :latency-p99)))
          resting (bk/resting-count (get-in (:ex a) [:books 1]))]
      (println)
      (println (format "  workload   %s txs in %d blocks of %d · %s cancels / %s quotes / %s IOC"
                       (fmt trading-txs) n-blocks block-size
                       (fmt (get kinds :cancel 0)) (fmt (get kinds :quote 0)) (fmt (get kinds :ioc 0))))
      (println (format "             %s book events · %s rejected %s · %s resting at end"
                       (fmt (:events a)) (fmt n-rejected) (pr-str reasons) (fmt resting)))
      (println (format "  root       %s (replay = generation)" root))
      (println (format "  host       %d cores (pauth = signatures pre-verified on all of them)" threads))
      (println)
      (println "  stage                  txs/sec      block p50    block p99")
      (doseq [{:keys [stage tps p50-ms p99-ms]} rows]
        (println (format "  %-21s %10s   %8.2f ms  %8.2f ms" (name stage) (fmt tps) p50-ms p99-ms)))
      (println)
      (println (str "  Hyperliquid (" (:source/url ref) ", read " (:source/read-on ref) ")"))
      (println (format "    throughput %s orders/sec — \"%s\"" (fmt hl-tps)
                       (:bottleneck-quote (by-id :throughput))))
      (doseq [{:keys [stage tps]} rows]
        (println (format "      %-21s %.2fx" (name stage) (/ tps hl-tps))))
      (println (format "    latency p50 %.0f ms / p99 %.0f ms, end-to-end from a co-located client"
                       hl-p50 hl-p99))
      (let [{:keys [p50-ms p99-ms]} (last rows)]
        (println (format "      torihiki replica compute alone: p50 %.2f ms / p99 %.2f ms" p50-ms p99-ms))
        (println "      — a LOWER bound on torihiki end-to-end: consensus and network UNMEASURED here"))
      (println (str "    caveat: " (:caveat (by-id :throughput))))
      (println)
      (doseq [{:keys [stage txs total-ns p50-ms p99-ms]} rows]
        (println (str "MEASURED\t" (name stage) "\t" txs "\t" total-ns "\t"
                      (format "%.3f" p50-ms) "\t" (format "%.3f" p99-ms)))))))
