(ns torihiki.api
  "The request surface: validation, a stated rejection taxonomy, and the read
  models a client actually needs.

  Pure. No transport, no sockets, no serialization format — a Worker, an nbb
  process or a test calls `validate` and `query` directly. What lives here is
  the CONTRACT; how bytes reach it is somebody else's problem.

  ## Why validation is not the state machine's job to throw about

  `apply-tx` used to throw on a price level outside the ladder. Inside a block
  that is not a rejected order, it is a HALTED CHAIN: one malformed
  transaction, submitted by anyone, and every validator stops at the same
  place. Liveness dies to a typo.

  So validation is separated from application, and it is total: every
  transaction either passes `validate` and is applied, or fails it and is
  recorded as a rejection. Nothing in between, and nothing that throws.

  This is the difference between a program that refuses bad input and a
  protocol that survives it.

  ## The taxonomy is closed on purpose

  Rejection reasons are keywords from a fixed set. A free-text reason would be
  a string a client parses, which makes every future rewording a breaking
  change — and, worse, tempts an implementation into putting internal state in
  it. `reasons` is the whole list."
  (:require [torihiki.principal :as pr]
            [torihiki.book :as bk]
            [torihiki.clearing :as cl]
            [torihiki.fixed :as fx]
            [torihiki.order-margin :as om]
            [torihiki.governance :as gov]
            [torihiki.auth :as auth]
            [torihiki.oracle :as orc]
            [torihiki.validators :as vals]))

(def reasons
  "Every rejection this API can produce. Closed set — see the ns docstring."
  #{:unknown-tx
    :unknown-market
    :missing-field
    :bad-account
    :bad-quantity
    :bad-price-level
    :bad-side
    :bad-flags
    :bad-amount
    :bad-trigger-direction
    :bad-trigger-price
    :bad-trigger-order
    :builder-fee-too-high
    :rate-too-high
    :open-interest-cap
    :insufficient-margin
    :book-full
    :not-a-publisher
    :oracle-is-aggregated
    :not-the-bridge
    :bad-cid
    :malformed-principal})

(defn int-in?
  "A slab-storable integer in `[lo, hi]`. Public because the engine's store
  doors (`torihiki.state/apply-tx`) judge the same fields with the same
  words — one shape rule, two doors."
  [v lo hi] (and (integer? v) (<= lo v) (<= v hi)))

(defn account-ok?
  "An account id must be a slab-storable i53 integer. The book keeps owners in
  an i53 slab (`torihiki.slab`), so an id outside the domain cannot be stored
  and the rejection must happen HERE, as `:bad-account`, rather than deeper in
  the engine as a throw — one malformed transaction would otherwise halt every
  validator at the same place (the `validate` contract at the top of this
  namespace)."
  [id]
  (and (integer? id) (fx/in-domain? id)))

(defn- spec-ok?
  "Every INTEGER a market spec carries must be slab-storable. A spec value
  outside the domain is a tick, lot or rate the engine will multiply later,
  and the product check in `torihiki.fixed` is the wrong place to find out.
  Non-integer numbers pass through here — they are judged where they are
  used; this only caps what would be stored in an i53 field."
  [v]
  (cond
    (number? v) (or (not (integer? v)) (fx/in-domain? v))
    (map? v) (every? spec-ok? (vals v))
    (or (vector? v) (set? v)) (every? spec-ok? v)
    :else true))

(def ^:private fee-rate-keys
  "Spec keys whose values are FEES, as rates against `torihiki.fixed/rate-scale`.
  A fee may be negative — a rebate is a fee with a sign — so the range is
  symmetric: at most 100%, at most -100% back."
  #{:taker-fee-rate :maker-fee-rate})

(def ^:private margin-rate-keys
  "Spec keys whose values are margin REQUIREMENTS, and the asymmetry with fees
  above is the whole point. A negative requirement is not a requirement: it is
  free leverage — every position it covers is under-collateralised by
  construction, and the hole is paid by the insurance fund or by ADL.
  Solvency-breaking though perfectly deterministic, which is the worst kind:
  nothing throws, every number is locally correct, and the exchange is quietly
  insolvent."
  #{:initial-margin-rate :maintenance-margin-rate})

(defn- rates-ok?
  "Every rate a market spec carries is a fraction of `torihiki.fixed/rate-scale`
  — a fee at most ±100% (a rebate is legitimate), a margin requirement at most
  100% and never below zero (`margin-rate-keys` — see `fee-rate-keys` for why
  the ranges differ). The engine multiplies rates against in-domain amounts
  (`torihiki.fixed/mul-rate`), and a rate above the scale takes
  `amount x rate / rate-scale` out of the domain, where mul-rate throws
  mid-fill: one listed market, one fill, every validator halts at the same
  place (the falsify-6/7 class). A fee is a fraction; past 100% it is not one.
  Walks the whole spec, so `:fee-tiers` are judged wherever they nest."
  [v]
  (cond
    (map? v) (every? (fn [[k val]]
                       (cond
                         (contains? fee-rate-keys k)
                         (and (integer? val) (<= (- fx/rate-scale) val fx/rate-scale))
                         (contains? margin-rate-keys k)
                         (and (integer? val) (<= 0 val fx/rate-scale))
                         :else (rates-ok? val)))
                     v)
    (or (vector? v) (set? v)) (every? rates-ok? v)
    :else true))

(defn tier-leverage-ok?
  "A tier's `:max-leverage` is OPTIONAL (the rates are the contract) but when
  present it is a COUNT: 1..i53-max. `encode-market-spec` folds it RAW into
  the state root like `:max-notional`, so a fraction or a string there is
  bytes no two runtimes agree on or a throw in `enc-int`'s `(neg? v)` — the
  same door `:max-notional` keeps, one field to the right.

  This clause is the piece of `cl/margin-tiers-ok?` (PR #72/#73) the kotoba
  monorepo extraction (PR #74) took with it: the core copy at the pinned sha
  shapes `:max-notional` and the rates and leaves `:max-leverage` out. It is
  re-homed here, at the door that judges the request, beside `flat-spec-ok?`
  — same loss, same recovery."
  [tiers]
  (or (nil? tiers)
      (and (sequential? tiers)
           (every? (fn [t]
                     (or (nil? (:max-leverage t))
                         (and (integer? (:max-leverage t))
                              (<= 1 (:max-leverage t) fx/i53-max))))
                   tiers))))

(defn flat-spec-ok?
  "Whether the spec's FLAT fields are shaped like the two places that read
  them. All optional (the readers default); when present:

    `:tick` `:lot` `:max-leverage`  a count — integer 1..i53-max
    `:open-interest-cap`            integer 0..i53-max (0 allows no interest)
    `:asset`                        integer 0..i53-max (a balance key)

  Two readers cannot judge these and both are hurt by junk:

  1. `torihiki.state/encode-market-spec` folds every one of them RAW into the
     STATE ROOT through `enc-int`, whose whole contract is \"one i53 as 8
     bytes\". A fraction folds to bytes no other runtime reproduces and a
     string dies in `(neg? v)` — the falsify-14 class, in the authenticated
     encoding itself. `:asset` is worse: it becomes a KEY in `:balances` /
     `:committed`, and `encode-clearing-account` folds the keys.
  2. Two readers COMPARE them: `set-leverage`'s `(> lev (:max-leverage
     market 1))` — a string there is a ClassCastException on the JVM and a
     silent coercion on JS, one bridge-signed `:list-market` and then the
     first `:set-leverage` (the falsify-6/7 class) — and
     `torihiki.api/validate`'s open-interest-cap `>`, which runs INSIDE
     apply-block.

  Shapes as well as ranges, and the shape check is the cross-runtime one:
  `spec-ok?` caps integers and waves non-integers through (\"they are judged
  where they are used\"), and `(integer? 4.5e17)` is TRUE on JS — an integral
  double — and FALSE on the JVM — a Double — so the two runtimes answered the
  same transaction differently at the DOOR: one refused it, one stored it and
  forked later. A count is an integer everywhere; anything else is refused
  here, on both runtimes, by the same rule.

  `:tick` and `:lot` are judged here too although `:amend-market` drops them
  (they are immutable): junk in a transaction is refused at the door, not
  silently discarded — the same answer `spec-ok?` already gives an
  out-of-domain tick on an amend.

  Provenance: this gate landed as `cl/flat-spec-ok?` (PR #73) and was lost
  with the core move — PR #74 extracted `torihiki.clearing` to the kotoba
  monorepo from a tree that predated it, so HEAD called a predicate the
  pinned core does not carry and the engine failed to LOAD (measured:
  `Unable to resolve symbol: cl/flat-spec-ok?`, analysis phase, every leg).
  Re-homed here: `torihiki.api` is where spec judgment already lives
  (`spec-ok?`, `rates-ok?`), and `torihiki.state`'s no-op nets already
  require this namespace."
  [spec]
  (let [count-ok? (fn [v lo] (or (nil? v) (int-in? v lo fx/i53-max)))]
    (and (count-ok? (:tick spec) 1)
         (count-ok? (:lot spec) 1)
         (count-ok? (:max-leverage spec) 1)
         (count-ok? (:open-interest-cap spec) 0)
         (count-ok? (:asset spec) 0))))

(defn market-exists?
  "Public for the same reason as `int-in?`: the engine's store doors ask it."
  [ex m] (contains? (:markets ex) m))

(defn- publishers [ex] (vals/publishers ex))

(defn- n-levels
  "How many price levels market `m`'s book has — 0 when there is no book.
  The default matters: `(dec nil)` is a throw, and every level check in this
  namespace funnels through here, so a market that exists without a book used
  to answer a shape question with an exception at the door."
  [ex m]
  (or (:n-levels (get-in ex [:books m])) 0))

(defn- validate-order-shape
  "Shared by `:order` and by a trigger's embedded order — the same fields mean
  the same things in both, and checking them in one place is what keeps them
  from drifting apart."
  [ex market {:keys [side level qty flags]}]
  (cond
    (not (int-in? side 0 1)) :bad-side
    (not (int-in? qty 1 fx/i53-max)) :bad-quantity
    (not (int-in? level 0 (dec (n-levels ex market)))) :bad-price-level
    ;; The notional a fill will compute is `level x qty` (`torihiki.fixed/
    ;; notional`), so it is capped HERE rather than discovered inside a fill:
    ;; two in-domain orders crossing at a high level produced an out-of-domain
    ;; notional mid-apply (falsify-7), where a throw is a halted chain.
    ;; Division, not multiplication — `level x qty` may itself overflow.
    (and (pos? level) (> qty (quot fx/i53-max level))) :bad-amount
    (not (int-in? (or flags 0) 0 7)) :bad-flags
    :else nil))

;; ── the apply-path shape gates ───────────────────────────────────────────────
;;
;; What `torihiki.state/apply-tx` asks before it touches a book. The engine
;; takes transactions that never met `validate` — a trigger's embedded order
;; when the mark arms it, TWAP slices, a scale's rungs, an amend's
;; re-dispatch — and until these existed it trusted every field: `(long 2.5)`
;; cancelled somebody's live order, `(long nil)` threw inside `apply-block`
;; (a halted chain — the falsify-6/7 class), and an off-ladder level threw
;; from `bk/place!`. These are the SAME judgments `validate` makes, in the
;; same order, answering with the same keyword from `reasons` — one shape
;; rule, two doors. A refusal at the engine is a NO-OP: the transaction is
;; dropped whole and the exchange is returned unchanged. Nothing here throws.

(defn order-tx-shape
  "nil when this order may be applied, otherwise its `reasons` keyword.

  The full order door: the market, the account, and the resting shape
  (`validate-order-shape` — side, quantity, ladder level, the notional a fill
  will compute, the flags). Used by `apply-tx :order` before anything is
  destructured arithmetically, and by `fire-triggers` on a trigger's raw
  embedded order before `reducing-qty` computes with it."
  [ex {:keys [account market] :as t}]
  (cond
    (not (market-exists? ex market)) :unknown-market
    (not (account-ok? account)) :bad-account
    :else (validate-order-shape ex market t)))

(defn amend-tx-shape
  "nil when this amend may be applied, otherwise its `reasons` keyword.

  The id must be a NATURAL integer — `slot * gen-mod + generation`
  (`bk/oid-of`), so 0 names a live order and a fraction names nothing. The
  engine used to answer `(long 2.5)` with the order at slot 2, amending (or
  cancelling) an order the transaction never named; `(long \"oid\")` was a
  throw on one runtime and a NaN no-op on the other. After the id, the NEW
  resting shape has to be a legal order in its own right — the same check
  `:order` gets, because an amend that cannot keep its place in the queue
  becomes exactly that (and the engine re-dispatches it as one)."
  [ex {:keys [account market oid] :as t}]
  (cond
    (not (market-exists? ex market)) :unknown-market
    (not (account-ok? account)) :bad-account
    (not (nat-int? oid)) :missing-field
    :else (validate-order-shape ex market (assoc t :side 0 :flags 0))))

(defn cancel-tx-shape
  "nil when this cancel may be applied, otherwise its `reasons` keyword.

  Strictly shape: the market exists, the signer is a slab-storable account,
  the id is a natural integer (see `amend-tx-shape`). Whose order it is is
  the book's answer (`bk/cancel!` compares owners), not this function's —
  but a cancel whose OWN fields cannot be read must be refused before the
  engine compares anything, because the comparison itself used to be the
  throw: `(long nil)` on the JVM, `(long \"one\")` as NaN on JS naming slot 0."
  [ex {:keys [account market oid]}]
  (cond
    (not (market-exists? ex market)) :unknown-market
    (not (account-ok? account)) :bad-account
    (not (nat-int? oid)) :missing-field
    :else nil))

(defn trigger-tx-shape
  "nil when this trigger may be stored, otherwise its `reasons` keyword.

  Mirrors `validate`'s `:trigger` clause exactly — including the report
  mapping: a bad embedded order is a bad TRIGGER (`:bad-trigger-order`)
  except a price level, which is reported as itself, because the client asked
  for a trigger, not for an order. The embedded order is judged by the same
  `validate-order-shape` the engine will judge it with again when the mark
  arms it."
  [ex {:keys [account market trigger-price direction order]}]
  (cond
    (not (market-exists? ex market)) :unknown-market
    (not (account-ok? account)) :bad-account
    (not (int-in? trigger-price 1 fx/i53-max)) :bad-trigger-price
    (not (contains? #{:above :below} direction)) :bad-trigger-direction
    (not (map? order)) :bad-trigger-order
    :else (when-let [r (validate-order-shape ex market order)]
            (if (= r :bad-price-level) :bad-price-level :bad-trigger-order))))

;; ── the schedule shape gates ─────────────────────────────────────────────────
;;
;; What `torihiki.state/apply-tx` asks before it computes with a schedule's
;; fields. A scale ranges `count*` and adds `step` into `level` — a throw on
;; a string on one runtime, a silent rung on the other (the asymmetric
;; class) — and a TWAP's fields are folded into `:next-at` and divided at
;; fire time. These are the SAME judgments `validate` makes, in the same
;; order, answering with the same keyword from `reasons` — one shape rule,
;; two doors. A refusal at the engine is a NO-OP: the schedule is dropped
;; whole and the exchange is returned unchanged. Nothing here throws.

(defn- scale-basics
  "The ladder's own shape, before its rungs are judged: the market, the
  signer, and the fields the rung walk computes with. Shared by
  `scale-tx-shape` and `validate`'s `:scale` clause — the same judgments in
  the same order, so the two doors cannot drift."
  [ex {:keys [account market] :as t}]
  (cond
    (not (account-ok? account)) :bad-account
    (not (market-exists? ex market)) :unknown-market
    (not (contains? #{0 1} (:side t))) :bad-side
    (not (int-in? (:qty t) 1 fx/i53-max)) :bad-quantity
    ;; :level is folded into rung prices — `(+ level (* dir i step))` — so
    ;; it is capped like the order's level, not merely signed.
    (not (int-in? (:level t) 0 fx/i53-max)) :bad-price-level
    ;; A ladder of one is an order, and this is not the way to send one.
    (not (and (integer? (:count* t)) (> (:count* t) 1) (<= (:count* t) 50)))
    :missing-field
    ;; A step of zero stacks every rung on one level, which is an order for
    ;; count x qty wearing a ladder's clothes.
    (not (int-in? (:step t) 1 fx/i53-max)) :missing-field
    :else nil))

(defn- scale-rungs
  "The rung mirror. The engine gate judges every rung as an order the moment
  the ladder is placed (`torihiki.state/apply-tx :scale` dispatches each
  rung through `:order`), so what `validate-order-shape` would refuse for a
  rung has to be refused at BOTH doors — or the gate would drop rungs one
  door passed and a ladder would arrive silently short. Same rungs, same
  judgment: out-of-bounds rungs are skipped by the engine (a scale that ran
  past the end of the book does not take the rungs that fit with it), so
  they are skipped here too. Only reached with `scale-basics` answered nil —
  the walk ranges over `count*` and adds `step`."
  [ex {:keys [market] :as t}]
  (let [dir (if (= (:side t) bk/bid) -1 1)
        n (n-levels ex market)]
    (some (fn [i]
            (let [l (+ (:level t) (* dir i (:step t)))]
              (when (and (<= 0 l) (< l n))
                (validate-order-shape ex market
                                      {:side (:side t) :level l
                                       :qty (:qty t) :flags (:flags t)}))))
          (range (:count* t)))))

(defn scale-tx-shape
  "nil when this scale may be applied, otherwise its `reasons` keyword.

  The ladder door: `scale-basics` (the market, the signer, the fields the
  rung walk computes with) then `scale-rungs` (every rung judged as the
  order it will be dispatched as). Used by `apply-tx :scale` before
  `(range count*)` computes with anything. Margin is NOT here: the engine
  judges affordability per rung as it dispatches (`torihiki.order-margin`),
  and a ladder `validate` refused for margin is refused at `validate`."
  [ex t]
  (or (scale-basics ex t) (scale-rungs ex t)))

(defn twap-tx-shape
  "nil when this schedule may be stored, otherwise its `reasons` keyword.

  The schedule door — `validate`'s `:twap` clause verbatim (extracted so the
  two doors cannot drift): the market, the signer, the fields the fire path
  computes with (quantity, slices, spacing), and the mirror of the order
  notional cap at the level the slices fire at (`fire-twaps` places each
  slice at the top of the ladder for bids — level `n-levels - 1` — or at
  level 0 for asks, where the notional is zero). A slice is never bigger
  than the total, so the total against the slice level covers every slice
  the schedule will ever fire."
  [ex {:keys [account market] :as t}]
  (cond
    (not (account-ok? account)) :bad-account
    (not (market-exists? ex market)) :unknown-market
    (not (contains? #{0 1} (:side t))) :bad-side
    (not (int-in? (:qty t) 1 fx/i53-max)) :bad-quantity
    ;; A schedule of one slice is an order, and a schedule of none is
    ;; nothing. Both are better refused than quietly turned into something
    ;; the trader did not ask for.
    (not (and (integer? (:slices t)) (> (:slices t) 1))) :missing-field
    (not (int-in? (:every t) 1 fx/i53-max)) :missing-field
    ;; Every slice must be at least one lot, or the tail of the schedule
    ;; fires empty orders forever.
    (< (:qty t) (:slices t)) :bad-quantity
    :else
    (when (= (:side t) bk/bid)
      (let [l (dec (n-levels ex market))]
        (when (and (pos? l) (> (:qty t) (quot fx/i53-max l)))
          :bad-amount)))))

;; ── the store shape gates ───────────────────────────────────────────────────
;;
;; What `torihiki.state/apply-tx` asks before it computes with a STORE
;; transaction's fields — the REST of the dispatches (PRs #78/#79 made
;; :order/:amend/:cancel/:trigger/:scale/:twap total). These are the ones
;; where the same disagreement between `validate` and the engine was
;; measured: a transaction `validate` refused could still STORE its garbage
;; into the map keys the encoders fold into the state root (`:clearing
;; :accounts`, `:referrers`, `:sub-of`, `:agents`, `:triggers`, `:funding`,
;; `:last-funding-rate`, `:oracle-submissions`, `:anchors`), and four more
;; could THROW inside `apply-block` (:oracle, :funding-sample and
;; :cancel-all on a market with no book, :evm-deploy with no account).
;; These are the SAME judgments `validate` makes, in the same order,
;; answering with the same keyword from `reasons` — one shape rule, two
;; doors — with ONE deliberate difference: where the engine DEREFERENCES the
;; book (:oracle, :oracle-submit, :funding-sample, :cancel-all), a market
;; with no book is refused here even though `validate` passes it (it only
;; asks that the market exist). "Never a throw" outranks "never over-refuse"
;; at this door: `validate` answers the client, the engine keeps every
;; validator applying the same block. A refusal at the engine is a NO-OP:
;; the transaction is dropped whole and the exchange is returned unchanged.
;; Nothing here throws.

(defn store-tx-shape
  "nil when this transaction may store, otherwise its `reasons` keyword.

  Used by `torihiki.state/apply-tx` at the top of each store dispatch,
  before ANY destructured field is computed with — `account-as-address`
  derives an address, `fnd/premium` reads the book, `cl/withdraw` gates on
  free collateral and mints on a negative amount. The accounts and ids are
  judged as the keys they become (slab-storable, like `account-ok?`); the
  amounts as the arithmetic they enter."
  [ex {:keys [tx account market] :as t}]
  (case tx
    :deposit
    (cond
      (not (account-ok? account)) :bad-account
      ;; `credit` when the bridge is paying somebody: it becomes the
      ;; :accounts KEY the credit lands under.
      (and (some? (:credit t)) (not (account-ok? (:credit t)))) :bad-account
      :else nil)

    :withdraw
    (cond
      (not (account-ok? account)) :bad-account
      ;; A withdrawal is gated on free collateral as a no-op — but a NEGATIVE
      ;; amount passes that gate (`free >= -3`) and pays the withdrawer: the
      ;; mint. Amount is 1..i53-max here, at the door.
      (not (int-in? (:amount t) 1 fx/i53-max)) :bad-amount
      :else nil)

    :evm-deploy
    (when-not (account-ok? account) :bad-account)

    :anchor
    (cond
      (not (account-ok? account)) :bad-account
      (not (and (string? (:cid t)) (<= 1 (count (:cid t)) 128))) :bad-cid
      :else nil)

    :create-sub-account
    (when-not (account-ok? account) :bad-account)

    :set-referrer
    (cond
      (not (account-ok? account)) :bad-account
      (not (account-ok? (:referrer t))) :bad-account
      :else nil)

    (:authorize-agent :revoke-agent)
    (cond
      (not (account-ok? account)) :bad-account
      ;; `agent` is the KEY the authorisation lands under in :agents — and a
      ;; key that cannot verify is an authorisation nobody can use and no
      ;; shape of revoke can name. `validate` requires a base64 Ed25519
      ;; public key (44 characters); this door makes the same judgment.
      (not (string? (:agent t))) :missing-field
      (not= 44 (count (:agent t))) :missing-field
      ;; `expires` is a BLOCK HEIGHT the auth layer COMPARES on every
      ;; agent-signed trade (`torihiki.auth/agent-of`) — a garbage value
      ;; stored here is a throw waiting inside `apply-block` on one runtime
      ;; and a silently dead key on the other (the falsify-6/7 asymmetric
      ;; class), and an out-of-domain height is held differently by the two
      ;; runtimes inside the state root (falsify-8).
      (and (= tx :authorize-agent)
           (some? (:expires t))
           (not (int-in? (:expires t) 1 fx/i53-max)))
      :missing-field
      :else nil)

    (:bond :unbond)
    (cond
      (not (account-ok? account)) :bad-account
      ;; `validator` is the KEY the bond lands under in :bonds — judged as
      ;; the key it becomes, like every account id here.
      (not (account-ok? (:validator t))) :bad-account
      ;; The amount enters the bond/unbond arithmetic — `cl/bond` COERCES a
      ;; string or fractional amount ("5" bonds 5, 2.5 bonds 2) instead of
      ;; refusing it.
      (not (int-in? (:amount t) 1 fx/i53-max)) :bad-amount
      :else nil)

    :collect-unbonded
    (when-not (account-ok? account) :bad-account)

    (:vault-deposit :vault-withdraw)
    (cond
      (not (account-ok? account)) :bad-account
      ;; `vault` is an account id and becomes BOTH a :vaults key and the
      ;; :accounts key its shares credit — a garbage vault minted a garbage
      ;; account.
      (not (account-ok? (:vault t))) :bad-account
      (and (= tx :vault-deposit)
           (not (int-in? (:amount t) 1 fx/i53-max))) :bad-amount
      (and (= tx :vault-withdraw)
           (not (int-in? (:shares t) 1 fx/i53-max))) :bad-quantity
      :else nil)

    :transfer
    (cond
      (not (account-ok? account)) :bad-account
      (not (account-ok? (:to t))) :bad-account
      ;; The amount moves money through `cl/transfer`, which coerces a
      ;; string or fractional amount like the bond path does.
      (not (int-in? (:amount t) 1 fx/i53-max)) :bad-amount
      :else nil)

    :set-leverage
    (cond
      ;; `cl/set-leverage` assoc-in's [:leverage account market] directly —
      ;; a garbage account is a garbage :leverage key.
      (not (account-ok? account)) :bad-account
      (not (market-exists? ex market)) :unknown-market
      (not (and (integer? (:leverage t)) (pos? (:leverage t)))) :missing-field
      :else nil)

    :cancel-trigger
    (cond
      (not (market-exists? ex market)) :unknown-market
      ;; The id a cancel NAMES must be the kind of thing an id is — an
      ;; integer. `trg/cancel` is total on the id, but the engine's
      ;; `update-in` CREATES the :triggers key, so a garbage id used to write
      ;; `:triggers {market []}` into the state root for a transaction
      ;; `validate` refuses. Integer, not natural: a name is a name.
      (not (integer? (:id t))) :missing-field
      :else nil)

    :funding-settle
    (when-not (market-exists? ex market) :unknown-market)

    :funding-sample
    (cond
      (not (market-exists? ex market)) :unknown-market
      (nil? (get-in ex [:books market])) :unknown-market
      :else nil)

    :cancel-all
    (cond
      (not (market-exists? ex market)) :unknown-market
      (nil? (get-in ex [:books market])) :unknown-market
      (not (account-ok? account)) :bad-account
      :else nil)

    :oracle
    (cond
      (not (market-exists? ex market)) :unknown-market
      (nil? (get-in ex [:books market])) :unknown-market
      (not (int-in? (:price t) 1 fx/i53-max)) :bad-price-level
      :else nil)

    :oracle-submit
    (cond
      (not (market-exists? ex market)) :unknown-market
      (nil? (get-in ex [:books market])) :unknown-market
      (not (account-ok? account)) :bad-account
      (not (int-in? (:price t) 1 fx/i53-max)) :bad-price-level
      :else nil)

    ;; ── the attest family ─────────────────────────────────────────────────
    ;; The claims and attestations around the escrow. These are `validate`'s
    ;; clauses mirrored word for word — the same judgments, the same keywords
    ;; from `reasons` — because the engine door answered nil for all six
    ;; whatever the transaction carried (MEASURED 2026-10-30, kbb/SCI): a raw
    ;; `:deposit-attest` STORED its shape RAW into `:inbound` on the first
    ;; attestation — an out-of-domain `:credit` (2^53+1) and `:amount` land
    ;; there as values the two runtimes hold differently, and at quorum the
    ;; same garbage credit is the `:accounts` KEY `cl/deposit` credits. A
    ;; refusal at the engine is a NO-OP: the transaction is dropped whole and
    ;; the exchange is returned unchanged. Nothing here throws.

    :deposit-attest
    (cond
      (not (account-ok? account)) :bad-account
      (not (and (string? (:txid t)) (seq (:txid t)))) :missing-field
      ;; `credit` becomes the `:accounts` key `cl/deposit` credits — judged
      ;; as the key it becomes, like every account id here.
      (not (account-ok? (:credit t))) :bad-account
      (not (int-in? (:amount t) 1 fx/i53-max)) :bad-amount
      (not (and (string? (:asset t)) (seq (:asset t)))) :missing-field
      :else nil)

    :withdraw-attest
    (cond
      (not (account-ok? account)) :bad-account
      (not (integer? (:claim t))) :missing-field
      (not (and (string? (:txid t)) (seq (:txid t)))) :missing-field
      (not (and (string? (:dest t)) (seq (:dest t)))) :missing-field
      ;; optional — "when the event's amount is reported" — but a SAID amount
      ;; is said in the domain or it is garbage
      (and (some? (:amount t)) (not (int-in? (:amount t) 1 fx/i53-max)))
      :bad-amount
      :else nil)

    :withdraw-invalidate-attest
    (cond
      (not (account-ok? account)) :bad-account
      (not (integer? (:claim t))) :missing-field
      (not (and (string? (:txid t)) (seq (:txid t)))) :missing-field
      :else nil)

    (:withdraw-settle :withdraw-cancel)
    (cond
      (not (account-ok? account)) :bad-account
      ;; who may settle and who may cancel is decided in `torihiki.state`,
      ;; where the claim itself is in hand — this judges shape only
      (not (integer? (:claim t))) :missing-field
      :else nil)

    :attest-reserves
    (cond
      (not (account-ok? account)) :bad-account
      ;; zero reserves is a claim
      (not (int-in? (:amount t) 0 fx/i53-max)) :bad-amount
      ;; `:as-of` is stored beside the amount. An integer must be storable;
      ;; anything else (a statement date) passes through untouched.
      (and (some? (:height* t)) (not (spec-ok? (:height* t)))) :missing-field
      :else nil)

    ;; ── the consensus, identity and keeper family ─────────────────────────
    ;; These are `validate`'s clauses mirrored word for word — the same
    ;; judgments in the same order, the same keywords from `reasons` — because
    ;; the engine door answered nil for every one of them whatever the
    ;; transaction carried (the hole PR #84's record named as the remaining
    ;; queue): a raw `:upgrade-propose` STORED out-of-domain `:version`/
    ;; `:activation` numbers into `:protocol :proposals` (and subtracted from
    ;; an `:activation` before it landed — the falsify-8 class inside the
    ;; state root); a raw `:principal-*` keyed `:principal-claims`/
    ;; `:principals`/`:principal-accounts`/`:rotations` by whatever account or
    ;; subject it carried, and `check-claim` COMPARED that account (`(<
    ;; account addr/floor)`) — a throw on one runtime and a silently stored
    ;; key on the other (the falsify-6/7 asymmetric class); a raw
    ;; `:validator-register` stored a garbage `:account` VALUE in the
    ;; `:validators` record, which at slash time is the account the reward is
    ;; `cl/deposit`ed to; a raw `:equivocation-evidence` recorded the slash
    ;; `:by` a garbage submitter and minted its reward to a garbage
    ;; `:accounts` key; a raw `:liquidate` swept whatever `:market` said.
    ;; Refusals are NO-OPs: the transaction is dropped whole and the exchange
    ;; is returned unchanged. Nothing here throws.

    :liquidate
    (when-not (market-exists? ex market) :unknown-market)

    :upgrade-propose
    (cond
      (not (account-ok? account)) :bad-account
      ;; Both land in :protocol :proposals — stored numbers, capped.
      (not (int-in? (:version t) 1 fx/i53-max)) :missing-field
      (not (int-in? (:activation t) 1 fx/i53-max)) :missing-field
      :else nil)

    :upgrade-vote
    (cond
      (not (account-ok? account)) :bad-account
      ;; The id a vote NAMES is a KEY into :proposals (and a winning one is
      ;; stored into :protocol :scheduled :proposal) — judged as the key it
      ;; becomes: slab-storable, like `account-ok?`.
      (not (int-in? (:proposal t) fx/i53-min fx/i53-max)) :missing-field
      :else nil)

    (:principal-claim :principal-confirm)
    (cond
      (not (account-ok? account)) :bad-account
      (not (pr/well-formed-principal? (:principal t))) :malformed-principal
      ;; The subject is an ACCOUNT — it keys :principals and is stored as the
      ;; :principal-accounts VALUE. Judged as `account-ok?` judges an account.
      (and (= (:tx t) :principal-confirm)
           (not (account-ok? (:subject t)))) :bad-account
      :else nil)

    :principal-rotate
    (cond
      (not (account-ok? account)) :bad-account
      ;; The subject is an ACCOUNT — `pr/rotate-propose` keys :rotations by
      ;; it. Judged as `account-ok?` judges an account.
      (not (account-ok? (:subject t))) :bad-account
      (not (and (string? (:pubkey t)) (seq (:pubkey t)))) :missing-field
      :else nil)

    :principal-rotate-cancel
    (when-not (account-ok? account) :bad-account)

    (:validator-register :validator-rotate-key)
    (cond
      (not (account-ok? account)) :bad-account
      (not (string? (:witness t))) :missing-field
      (not (and (string? (:pubkey t)) (seq (:pubkey t)))) :missing-field
      :else nil)

    :validator-retire
    (cond
      (not (account-ok? account)) :bad-account
      (not (string? (:witness t))) :missing-field
      :else nil)

    :equivocation-evidence
    (cond
      (not (account-ok? account)) :bad-account
      (not (string? (:witness t))) :missing-field
      ;; [witness evidence-height view] is the KEY the slash record is filed
      ;; under in :slashed — judged as the key it becomes: slab-storable.
      (not (int-in? (:evidence-height t) fx/i53-min fx/i53-max)) :missing-field
      (not (int-in? (:view t) fx/i53-min fx/i53-max)) :missing-field
      (not (every? #(string? (get t %)) [:hash-a :sig-a :hash-b :sig-b])) :missing-field
      :else nil)

    nil))

;; ── the market shape gates ──────────────────────────────────────────────────
;;
;; What `torihiki.state/apply-tx` asks before it stores a market, merges a
;; spec, or dissocs a schedule. These are `validate`'s `:list-market` /
;; `:amend-market` / `:cancel-twap` clauses extracted verbatim — the same
;; judgments in the same order, answering with the same keyword from
;; `reasons` — one shape rule, two doors. Where the disagreement between the
;; doors was MEASURED (2026-10-30 probes at 5087afc): a raw `:list-market`
;; keyed `:markets` with a garbage MARKET ID (\"5\", 2.5, -1, 0, 2^53, nil —
;; the id is folded into the state root by `encode-market-spec`) and STORED a
;; garbage spec (`:taker-fee-rate \"5\"` / 1000000001 / 2^53,
;; `:maintenance-margin-rate -1`, `:weird 2^53`) RAW into `enc-ints`;
;; `:amend-market` MERGED the same garbage into the live market record; and
;; `:cancel-twap` with a nil account MINTED the `:twaps` key itself (`(= nil
;; nil)` matched and `(update ex :twaps dissoc id)` assocs `:twaps nil`).
;; A refusal at the engine is a NO-OP: the transaction is dropped whole and
;; the exchange is returned unchanged. Nothing here throws.

(defn market-tx-shape
  "nil when this market-admin transaction may be applied, otherwise its
  `reasons` keyword.

  The market id is judged as the KEY it becomes — slab-storable, like
  `account-ok?` (one deliberate widening: the old `validate` clause asked
  only `(and (integer? market) (pos? market))`, so an out-of-domain id
  PASSED and arrived through validated traffic as a garbage key — an
  in-domain bound is the same door `account-ok?` keeps, one map to the
  right, answered with the word the malformed id answers already). The spec
  is judged as the arithmetic and the ROOT BYTES it enters: `spec-ok?` (every
  integer slab-storable), `rates-ok?` (every rate a fraction of rate-scale —
  a rate past the scale takes `amount x rate / rate-scale` out of the domain,
  where `mul-rate` throws mid-fill), and the tier/flat shapes
  `encode-market-spec` folds RAW. `:tick` and `:lot` are judged even though
  `:amend-market` drops them: junk in a transaction is refused at the door,
  not silently discarded. The book options are judged as the allocation
  `new-book` would THROW on. Used by `torihiki.state/apply-tx` at the top of
  each market dispatch and by `validate` — the two doors cannot drift."
  [ex {:keys [tx account market spec id] :as t}]
  (case tx
    :cancel-twap
    (cond
      (not (account-ok? account)) :bad-account
      (not (integer? id)) :missing-field
      :else nil)

    :amend-market
    (cond
      (not (account-ok? account)) :bad-account
      (not (contains? (:markets ex) market)) :unknown-market
      (not (map? spec)) :missing-field
      ;; every integer a spec carries must be slab-storable — it is a tick,
      ;; lot or rate the engine will multiply later (see `spec-ok?`)
      (not (spec-ok? spec)) :missing-field
      ;; and every rate must be a fraction of rate-scale (see `rates-ok?`)
      (not (rates-ok? spec)) :rate-too-high
      ;; a schedule that replaces the old one must be complete like a new one
      ;; (see `cl/margin-tiers-ok?` + `tier-leverage-ok?` for the tier
      ;; `:max-leverage` the pinned core's copy leaves out; `:list-market`
      ;; judges the same shape), and the flat fields beside it must be shaped
      ;; like the encoder and the comparators read them (see `flat-spec-ok?`)
      (not (and (cl/margin-tiers-ok? (:margin-tiers spec))
                (tier-leverage-ok? (:margin-tiers spec))
                (cl/fee-tiers-ok? (:fee-tiers spec))
                (flat-spec-ok? spec))) :missing-field
      :else nil)

    :list-market
    (cond
      (not (account-ok? account)) :bad-account
      ;; The id becomes the KEY the market is stored under and is folded
      ;; into the state root by `encode-market-spec` — slab-storable.
      (not (int-in? market 1 fx/i53-max)) :unknown-market
      ;; Already listed is refused here rather than in the engine so a client
      ;; sees why, and so the engine's no-op stays a safety net rather than
      ;; the only check.
      (contains? (:markets ex) market) :unknown-market
      (not (map? spec)) :missing-field
      (not (spec-ok? spec)) :missing-field
      ;; every rate must be a fraction of rate-scale (see `rates-ok?`) — a
      ;; spec is not refused for what it SAYS only because it stores cleanly
      (not (rates-ok? spec)) :rate-too-high
      ;; A tier is read WHOLE — `tier-for` derefs `:max-notional`, `rates-for`
      ;; the two rates, `fee-rates-for` `:min-volume` — so completeness is
      ;; judged here, at the door, rather than discovered as a throw on the
      ;; first sweep through the market (the falsify-6/7 class). The shape
      ;; `cl/market` documents (`{:max-notional n :max-leverage l}`, rates
      ;; derived) is a GENESIS shape: at listing the rates are stated, not
      ;; derived — a derivation here would silently pick a floor division the
      ;; operator never saw. (see `cl/margin-tiers-ok?` + `tier-leverage-ok?`)
      ;; The flat fields are
      ;; shaped the same way: `encode-market-spec` folds them raw into the
      ;; state root and two readers compare them. (see `flat-spec-ok?`)
      (not (and (cl/margin-tiers-ok? (:margin-tiers spec))
                (tier-leverage-ok? (:margin-tiers spec))
                (cl/fee-tiers-ok? (:fee-tiers spec))
                (flat-spec-ok? spec))) :missing-field
      (not (int-in? (:tick spec) 1 fx/i53-max)) :missing-field
      (not (int-in? (:lot spec) 1 fx/i53-max)) :missing-field
      ;; `new-book` enforces its option constraints by THROWING, so the shape
      ;; is judged here, at the last door before apply-block
      (not (bk/book-opts-ok? (:book-opts t))) :missing-field
      :else nil)

    nil))

(def ^:const max-builder-fee-rate
  "The most a builder may charge, as a rate against `fx/rate-scale`. Ten basis
  points.

  A builder fee is set by whoever wrote the client, and the trader signing the
  order is agreeing to a number they may not have read — so the cap is what
  stands between an interface earning from routing and an interface taking the
  account. Hyperliquid caps it for the same reason.

  An order over the cap is REFUSED rather than trimmed: trimming would fill the
  trader at a cost they did not agree to, which is the same harm arriving
  quietly.

  It lives here and not in `torihiki.state` because `state` requires this
  namespace and not the other way round — the cap is a validation policy, and
  putting it where the engine is would make the engine the thing that decides
  what a client may charge."
  1000000)

(defn- perp? [ex market]
  (let [k (get-in ex [:markets market :kind])] (not (or (= :spot k) (= "spot" k)))))

(defn- spot-amend-funds
  "From protocol version 4, a spot amend that becomes a new order must be one
  the account can fund once the order it replaces has given its reservation
  back — or the cancel would go through and the new order silently fail,
  losing the old one. Refused here, before either."
  [ex {:keys [account market oid level qty]}]
  (when (and (>= (gov/active-version ex) 4) (not (perp? ex market)))
    (let [cur (bk/order-of (get-in ex [:books market]) oid)]
      (when (and cur (= account (:owner cur))
                 (not (and (= level (:level cur)) (< qty (:qty cur)))))
        (let [buy? (= (:side cur) bk/bid)
              asset (if buy? 0 (get-in ex [:markets market :asset]))
              back (if buy? (* (:level cur) (:qty cur)) (:qty cur))
              need (if buy? (* level qty) qty)
              c (:clearing ex)
              have (+ back (if buy?
                             (min (- (get-in c [:accounts account :collateral] 0)
                                     (get-in c [:committed account 0] 0))
                                  (om/free-collateral ex account))
                             (cl/balance c account asset)))]
          (when (> need have) :bad-amount))))))

(defn- amend-margin
  "An amend that cannot keep its place is a cancel and a new order; from
  version 2 the new order must be one the account can back, counted without
  the order it replaces. Refused here, BEFORE the cancel, so an unaffordable
  amend leaves the old order where it was."
  [ex {:keys [account market oid level qty]}]
  (when (and (om/active? ex) (perp? ex market))
    (let [cur (bk/order-of (get-in ex [:books market]) oid)]
      (when (and cur (= account (:owner cur)))
        (cond
          (zero? level) :bad-price-level
          (and (= level (:level cur)) (< qty (:qty cur))) nil
          (not (om/order-allowed?
                ex (om/adjust (:open-orders ex) account market (:side cur) (:level cur) (- (:qty cur)))
                account market (:side cur) level qty 0))
          :insufficient-margin)))))

(defn validate
  "nil when `tx` may be applied, otherwise a keyword from `reasons`.

  Checks SHAPE and RANGE, and — from protocol version 2 — whether a perp
  order or amend is one the account can back (`:insufficient-margin`,
  `torihiki.order-margin`). That one affordability check is here, and not
  only in the engine, so the refusal has a stated reason; the engine checks
  the same function again for orders that never pass through here
  (triggers, TWAP slices). A withdrawal that exceeds free collateral is
  still a no-op in the clearinghouse."
  [ex {:keys [tx account market] :as t}]
  (case tx
    (:order :cancel :cancel-all :amend :trigger :cancel-trigger :oracle
     :oracle-submit :funding-sample :funding-settle :liquidate)
    (cond
      (not (market-exists? ex market)) :unknown-market

      (= tx :order)
      (or (when-not (account-ok? account) :bad-account)
          ;; A builder fee is a number the trader may not have read. The cap is
          ;; what stands between an interface earning from routing and an
          ;; interface taking the account.
          (when (some? (:builder t))
            (cond
              (not (account-ok? (:builder t))) :bad-account
              (not (and (integer? (:builder-fee t)) (pos? (:builder-fee t))))
              :missing-field
              (> (:builder-fee t) max-builder-fee-rate) :builder-fee-too-high))
          (validate-order-shape ex market t)
          ;; Conservative on purpose: the check assumes the whole order could
          ;; open new interest, because whether it does depends on which side
          ;; the counterparty is on and that is not known until it matches.
          ;; Over-rejecting near the cap is the safe direction — the other one
          ;; discovers the breach only after it cannot be undone.
          (when-let [cap (get-in ex [:markets market :open-interest-cap])]
            (when (> (+ (cl/open-interest (:clearing ex) market) (:qty t)) cap)
              :open-interest-cap))
          ;; A quote that can only rest against a full order slab is refused
          ;; HERE, with its reason. The engine answers the same order — one
          ;; that never met validate: a trigger's embedded order — by resting
          ;; nothing (`torihiki.book/place!`), because `take-slot!`'s throw
          ;; used to halt every validator at the same place inside
          ;; `apply-block` (the falsify-6/7 class, reachable with no
          ;; out-of-domain integer at all: `:cap` resting orders and one more
          ;; quote). A CROSSING order is never refused for capacity — it takes
          ;; liquidity and frees a slot for every maker it fills — so the
          ;; check is only for the order that cannot cross.
          (when (and (bk/full? (get-in ex [:books market]))
                     (not (bk/marketable? (get-in ex [:books market])
                                          (:side t) (:level t))))
            :book-full)
          (when (and (om/active? ex) (perp? ex market))
            (cond
              ;; A bid at 0 asks for the asset free and an ask at 0 gives it
              ;; away; neither is a price.
              (zero? (:level t)) :bad-price-level
              ;; Reduce-only orders are exempt inside `order-allowed?`.
              (not (om/orders-allowed? ex (:open-orders ex) account market
                                       [[(:side t) (:level t) (:qty t) (or (:flags t) 0)
                                         (when (:builder t) (:builder-fee t))]]))
              :insufficient-margin)))

      (= tx :cancel)
      ;; `nat-int?`, not `pos?`. An order id is `slot * gen-mod + generation`
      ;; (`bk/oid-of`), so the first order to occupy slot 0 has id 0 — a live,
      ;; cancellable order that this refused as a missing field. Observed on
      ;; the deployed chain: `/orders` returned `{"oid":0,...}` for a resting
      ;; order that nobody, including its owner, could cancel.
      (if-not (nat-int? (:oid t)) :missing-field nil)

      (= tx :cancel-all)
      ;; Nothing but the market and the signer, both already checked. There is
      ;; no id to get wrong, which is the point: a maker pulling out does not
      ;; want a transaction that can be refused for a shape reason.
      (when-not (account-ok? account) :bad-account)

      (= tx :amend)
      (cond
        (not (account-ok? account)) :bad-account
        (not (nat-int? (:oid t))) :missing-field
        ;; The new resting shape has to be a legal order in its own right —
        ;; the same check `:order` gets, because that is what an amend
        ;; becomes whenever it cannot keep its place in the queue.
        :else (or (validate-order-shape ex market (assoc t :side 0 :flags 0))
                  (amend-margin ex t)
                  (spot-amend-funds ex t)))

      (= tx :cancel-trigger)
      (if-not (integer? (:id t)) :missing-field nil)

      (= tx :trigger)
      (cond
        (not (account-ok? account)) :bad-account
        (not (int-in? (:trigger-price t) 1 fx/i53-max))
        :bad-trigger-price
        (not (contains? #{:above :below} (:direction t))) :bad-trigger-direction
        (not (map? (:order t))) :bad-trigger-order
        :else (when-let [r (validate-order-shape ex market (:order t))]
                ;; a bad embedded order is a bad trigger, reported as such —
                ;; the client asked for a trigger, not for an order
                (if (= r :bad-price-level) :bad-price-level :bad-trigger-order)))

      (= tx :oracle)
      (cond
        (not (int-in? (:price t) 1 fx/i53-max)) :bad-price-level
        ;; With publishers configured, the direct setter is closed. Leaving
        ;; both doors open would make the aggregate decorative — an attacker
        ;; would simply use the one that does not aggregate.
        ;;
        ;; ONE exception: the authority may open a market that has never had a
        ;; price. A market listed on a running chain arrives unpriced, and
        ;; nothing can price it — publishers move a price, they do not create
        ;; one, and the direct setter is shut. So a listed market could be
        ;; traded and never margined, with a mark of zero, which is worse than
        ;; either door being open.
        ;;
        ;; It is not a second door into pricing: it closes behind itself the
        ;; moment it is used, because the condition is that there is no price
        ;; yet. The authority opens a market once; after that only publishers
        ;; move it.
        ;; With a validator set the set IS the oracle, and there is no direct
        ;; setter at all — not even the bootstrap below, since the set can
        ;; publish the first price itself.
        (some? (:validator-params ex)) :oracle-is-aggregated
        (and (seq (:oracle-publishers ex))
             (not (and (zero? (get-in ex [:oracle market] 0))
                       (some? (:bridge-authority ex))
                       (= account (:bridge-authority ex)))))
        :oracle-is-aggregated
        :else nil)

      (= tx :oracle-submit)
      (cond
        (not (account-ok? account)) :bad-account
        (not (int-in? (:price t) 1 fx/i53-max)) :bad-price-level
        (not (contains? (publishers ex) account)) :not-a-publisher
        :else nil)

      :else nil)

    :deposit
    (cond
      (not (account-ok? account)) :bad-account
      (not (int-in? (:amount t) 1 fx/i53-max)) :bad-amount
      ;; Collateral has to come from somewhere. With a bridge authority
      ;; configured, only it may credit an account — a deposit is the chain
      ;; recording that value arrived somewhere else, and an account that can
      ;; credit itself is not depositing, it is minting.
      ;;
      ;; Everything the clearinghouse does — margin, liquidation, the
      ;; insurance fund, auto-deleveraging — is arithmetic over collateral. If
      ;; any account can conjure it, all of that arithmetic is exact and means
      ;; nothing, and the failure is invisible because every individual number
      ;; is correct.
      ;;
      ;; Configured closes the door, exactly as `:oracle-publishers` closes the
      ;; direct price setter above: leaving both open would make the authority
      ;; decorative, since an attacker would use the door that does not check.
      (let [bridge (:bridge-authority ex)]
        (and bridge (not= account bridge))) :not-the-bridge
      ;; Bridge mode: the contract is the only way in, by quorum attestation
      ;; (`:deposit-attest`). No account — not even a configured authority —
      ;; may credit collateral by saying so.
      (some? (:bridge ex)) :not-the-bridge
      ;; Who the deposit pays. The signer is still the bridge — the
      ;; certificate backing this collateral is the bridge's own Ed25519
      ;; signature over the transaction, which the chain already verifies and
      ;; which its strictly sequential nonce already protects from replay.
      ;;
      ;; A second signing scheme (an authority-signed voucher carried inside a
      ;; user-submitted deposit) would need its own payload format, its own
      ;; spent-voucher set in the state root, and its own agreement between
      ;; client and node forever. This repo has said twice already why it does
      ;; not keep two implementations of a signed payload; the transaction
      ;; signature IS the certificate.
      ;;
      ;; Omitted, the deposit pays the signer, which is what it did before a
      ;; bridge could exist.
      (and (some? (:credit t)) (not (account-ok? (:credit t)))) :bad-account
      ;; Only a bridge may pay somebody else. Without this, any account could
      ;; credit any other on a chain with no authority configured — harmless
      ;; there in isolation, and a way to obscure where collateral came from
      ;; on a chain where the mint is supposed to be the only source.
      (and (some? (:credit t)) (nil? (:bridge-authority ex))
           (not= (:credit t) account)) :not-the-bridge
      ;; Balance-domain gate (falsify-8): a deposit whose credit would take
      ;; `collateral` past the i53 ceiling is refused HERE, with a reason.
      ;; Two in-domain deposits stacked past 2^53 and the two runtimes held
      ;; different collateral — root divergence, no throw anywhere. The
      ;; engine's `torihiki.clearing/deposit` refuses the same deposit as a
      ;; no-op; this clause is what tells the client why.
      (> (+ (get-in (:clearing ex) [:accounts (or (:credit t) account) :collateral] 0)
            (:amount t))
         fx/i53-max) :bad-amount
      :else nil)

    :withdraw
    (cond
      (not (account-ok? account)) :bad-account
      (not (int-in? (:amount t) 1 fx/i53-max)) :bad-amount
      ;; Bridge mode: the contract pays an address, so the claim must name
      ;; one, and a malformed one is refused here rather than signed by every
      ;; validator and refused by the contract.
      (and (some? (:bridge ex))
           (not (and (string? (:dest t)) (re-matches #"0x[0-9a-fA-F]{40}" (:dest t)))))
      :missing-field
      ;; Not gated: a holder withdrawing their own collateral is the one
      ;; movement that needs no authority beyond the signature, and the
      ;; clearinghouse already refuses to take more than free collateral.
      ;;
      ;; This no longer ends at the decrement. It raises a claim — a leaf, so
      ;; whoever holds the escrow can be handed an inclusion proof and pay
      ;; against it. See `torihiki.state/apply-tx :withdraw-settle`.
      :else nil)

    (:authorize-agent :revoke-agent)
    (cond
      (not (account-ok? account)) :bad-account
      (not (string? (:agent t))) :missing-field
      ;; A base64 Ed25519 public key is 44 characters. Checking the shape here
      ;; keeps an unusable authorisation out of the state root rather than
      ;; discovering it when a key that cannot verify tries to trade.
      (not= 44 (count (:agent t))) :missing-field
      (and (= tx :authorize-agent)
           (some? (:expires t))
           (not (int-in? (:expires t) 1 fx/i53-max)))
      :missing-field
      :else nil)

    (:bond :unbond)
    (cond
      (not (account-ok? account)) :bad-account
      (not (account-ok? (:validator t))) :bad-account
      (not (int-in? (:amount t) 1 fx/i53-max)) :bad-amount
      :else nil)

    :collect-unbonded
    (if (account-ok? account) nil :bad-account)

    (:vault-deposit :vault-withdraw)
    (cond
      (not (account-ok? account)) :bad-account
      (not (account-ok? (:vault t))) :bad-account
      (and (= tx :vault-deposit)
           (not (int-in? (:amount t) 1 fx/i53-max))) :bad-amount
      (and (= tx :vault-withdraw)
           (not (int-in? (:shares t) 1 fx/i53-max))) :bad-quantity
      :else nil)

    :create-sub-account
    (cond
      (not (account-ok? account)) :bad-account
      ;; `:sub` becomes a key in :sub-of and :account-keys — stored.
      (not (account-ok? (:sub t))) :bad-account
      :else nil)

    :transfer
    (cond
      (not (account-ok? account)) :bad-account
      (not (account-ok? (:to t))) :bad-account
      (not (int-in? (:amount t) 1 fx/i53-max)) :bad-amount
      :else nil)

    ;; An anchor: a content-addressed checkpoint (receipt CID) into the append-only
    ;; log. Shape-gated only — it moves no money and touches no market, and the
    ;; validation contract above is SHAPE and RANGE, not authorisation. Who may
    ;; anchor cheaply is a governance question (same class as :oracle-publishers)
    ;; and can be tightened later without changing this shape.
    :anchor
    (cond
      ;; An anchor records its signer into the :anchors log, so the id is a
      ;; value that lands in state: slab-storable, like every account id.
      (not (account-ok? account)) :bad-account
      (not (and (string? (:cid t)) (<= 1 (count (:cid t)) 128))) :bad-cid
      :else nil)

    :set-leverage
    (cond
      (not (account-ok? account)) :bad-account
      (not (contains? (:markets ex) market)) :unknown-market
      (not (and (integer? (:leverage t)) (pos? (:leverage t)))) :missing-field
      :else nil)

    :attest-reserves
    (cond
      (not (account-ok? account)) :bad-account
      (not (int-in? (:amount t) 0 fx/i53-max)) :bad-amount
      ;; :as-of is stored beside the amount. An integer must be storable;
      ;; anything else (a statement date) passes through untouched.
      (and (some? (:height* t)) (not (spec-ok? (:height* t)))) :missing-field
      :else nil)

    ;; An escrow deposit observed on another chain.
    ;;
    ;; Refused HERE for shape, so a malformed attestation is answered rather
    ;; than silently ignored by `apply-tx`. Whether the attestor has weight and
    ;; whether a quorum agrees are consensus questions and stay there — this
    ;; only says the transaction is the shape it claims to be.
    :deposit-attest
    (cond
      (not (account-ok? account)) :bad-account
      (not (and (string? (:txid t)) (seq (:txid t)))) :missing-field
      (not (account-ok? (:credit t))) :bad-account
      (not (int-in? (:amount t) 1 fx/i53-max)) :bad-amount
      (not (and (string? (:asset t)) (seq (:asset t)))) :missing-field
      :else nil)

    ;; Contract code, published into the chain.
    :evm-deploy
    (cond
      (not (account-ok? account)) :bad-account
      (not (and (string? (:code t)) (seq (:code t)))) :missing-field
      (odd? (count (:code t))) :missing-field
      :else nil)

    :set-referrer
    (cond
      (not (account-ok? account)) :bad-account
      (not (account-ok? (:referrer t))) :bad-account
      :else nil)

    :scale
    (or (scale-basics ex t)
        ;; From version 2 the ladder is checked WHOLE, as it is placed whole:
        ;; refusing it here is what keeps the engine from placing the rungs it
        ;; can back and silently dropping the rest.
        (when (and (om/active? ex) (perp? ex market)
                   (let [{:keys [side level qty step]} t
                         dir (if (= side bk/bid) -1 1)
                         n (n-levels ex market)
                         rungs (for [i (range (:count* t))
                                     :let [l (+ level (* dir i step))]
                                     :when (and (<= 0 l) (< l n))]
                                 [side l qty (or (:flags t) 0)])]
                     (not (om/orders-allowed? ex (:open-orders ex) account market rungs))))
          :insufficient-margin)
        ;; Mirror door — `scale-rungs`: the engine gate judges every rung as
        ;; an order the moment the ladder is placed
        ;; (`torihiki.state/apply-tx :scale` dispatches each rung through
        ;; `:order`), so what `validate-order-shape` would refuse for a rung
        ;; has to be refused HERE too — or the gate would drop rungs this
        ;; function passed and a ladder would arrive silently short. Same
        ;; rungs, same judgment: out-of-bounds rungs are skipped by the
        ;; engine (a scale that ran past the end of the book does not take
        ;; the rungs that fit with it), so they are skipped here too.
        (scale-rungs ex t))

    :twap
    (twap-tx-shape ex t)

    :cancel-twap
    (market-tx-shape ex t)

    :amend-market
    (market-tx-shape ex t)

    :list-market
    ;; The market door — extracted verbatim into `market-tx-shape` (which the
    ;; engine's `apply-tx` gates call too), so the two doors cannot drift. Its
    ;; docstring carries the rationale the clauses used to: the id as the key
    ;; it becomes, the spec as the root bytes it enters, the book options as
    ;; the allocation `new-book` would throw on.
    (market-tx-shape ex t)

    ;; It had no case here, so through `apply-block` — the only path a
    ;; deployed chain has — every exit attestation was refused `:unknown-tx`
    ;; and no claim could ever settle by quorum. The tests called `apply-tx`
    ;; directly, which skips this function, and so never saw it.
    :upgrade-propose
    (cond
      (not (account-ok? account)) :bad-account
      ;; Both land in :protocol :proposals — stored numbers, capped.
      (not (int-in? (:version t) 1 fx/i53-max)) :missing-field
      (not (int-in? (:activation t) 1 fx/i53-max)) :missing-field
      :else nil)

    :upgrade-vote
    (cond
      (not (account-ok? account)) :bad-account
      (not (int-in? (:proposal t) fx/i53-min fx/i53-max)) :missing-field
      :else nil)

    :withdraw-attest
    (cond
      (not (account-ok? account)) :bad-account
      (not (integer? (:claim t))) :missing-field
      (not (and (string? (:txid t)) (seq (:txid t)))) :missing-field
      (not (and (string? (:dest t)) (seq (:dest t)))) :missing-field
      (and (some? (:amount t)) (not (int-in? (:amount t) 1 fx/i53-max))) :bad-amount
      :else nil)

    :withdraw-invalidate-attest
    (cond
      (not (account-ok? account)) :bad-account
      (not (integer? (:claim t))) :missing-field
      (not (and (string? (:txid t)) (seq (:txid t)))) :missing-field
      :else nil)

    (:withdraw-settle :withdraw-cancel)
    (cond
      (not (account-ok? account)) :bad-account
      (not (integer? (:claim t))) :missing-field
      ;; Who may settle and who may cancel is decided in `torihiki.state`,
      ;; where the claim itself is in hand: settling needs the bridge, and
      ;; cancelling needs the claim's owner. Neither question is answerable
      ;; from the transaction's shape, which is all this function judges.
      :else nil)

    ;; Identity. The shape only: whether this account may claim, whether the
    ;; sender is the controller, and whether a binding already exists are
    ;; decided in `torihiki.state` with `torihiki.principal`, for the same
    ;; reason `:withdraw-settle` decides its authority there — none of it is
    ;; answerable from the transaction's shape, which is all this judges.
    (:principal-claim :principal-confirm)
    (cond
      (not (account-ok? account)) :bad-account
      (not (pr/well-formed-principal? (:principal t))) :malformed-principal
      ;; The subject is an ACCOUNT — it keys :principals and is stored as the
      ;; :principal-accounts VALUE. Judged as `account-ok?` judges an account.
      (and (= (:tx t) :principal-confirm)
           (not (account-ok? (:subject t)))) :bad-account
      :else nil)

    :principal-rotate
    (cond
      (not (account-ok? account)) :bad-account
      ;; The subject is an ACCOUNT — `pr/rotate-propose` keys :rotations by
      ;; it. Judged as `account-ok?` judges an account.
      (not (account-ok? (:subject t))) :bad-account
      (not (and (string? (:pubkey t)) (seq (:pubkey t)))) :missing-field
      :else nil)

    ;; The veto carries no subject: the signer is the party refusing, and a
    ;; `:subject` field would invite a client to cancel somebody else's.
    :principal-rotate-cancel
    (cond
      (not (account-ok? account)) :bad-account
      :else nil)

    (:validator-register :validator-rotate-key)
    (cond
      (not (account-ok? account)) :bad-account
      (not (string? (:witness t))) :missing-field
      (not (and (string? (:pubkey t)) (seq (:pubkey t)))) :missing-field
      :else nil)

    :validator-retire
    (cond
      (not (account-ok? account)) :bad-account
      (not (string? (:witness t))) :missing-field
      :else nil)

    :equivocation-evidence
    (cond
      (not (account-ok? account)) :bad-account
      (not (string? (:witness t))) :missing-field
      ;; [witness evidence-height view] is the KEY the slash record is filed
      ;; under in :slashed — judged as the key it becomes: slab-storable.
      (not (int-in? (:evidence-height t) fx/i53-min fx/i53-max)) :missing-field
      (not (int-in? (:view t) fx/i53-min fx/i53-max)) :missing-field
      (not (every? #(string? (get t %)) [:hash-a :sig-a :hash-b :sig-b])) :missing-field
      :else nil)

    :unknown-tx))

;; ── read models ─────────────────────────────────────────────────────────────
;;
;; What a client needs, shaped for a client. These deliberately do not hand
;; back the internals: a caller that reached into `:books` would be coupled to
;; the slab layout, and the terminal did exactly that before this existed.

(defn depth
  "Top `n` levels of one side, nearest the touch first, with a running
  cumulative size — the shape an order-book panel renders."
  [ex market side n]
  (let [book (get-in ex [:books market])]
    (loop [level (bk/best book side) i 0 cum 0 out []]
      (if (or (neg? level) (>= i n))
        out
        (let [q (bk/level-qty book side level)
              cum (+ cum q)]
          (recur (bk/next-occupied book side level) (inc i) cum
                 (conj out {:level level :qty q :cum cum})))))))

(defn book-snapshot
  [ex market n]
  {:market market
   :bids (depth ex market bk/bid n)
   :asks (depth ex market bk/ask n)
   :resting (bk/resting-count (get-in ex [:books market]))})

(defn fills-since
  "Fills produced in the current block from index `from` onward. A
  block-scoped view, not history — a client wanting history keeps its own,
  or replays the log.

  Read from `:block-fills`, the fills settlement recorded, and not from the
  book's event buffer: that stops recording at `ev-cap`, and since protocol
  version 3 settlement does not, so the buffer could omit fills a position
  already holds."
  [ex market from]
  (vec (drop from (get-in ex [:block-fills market] []))))

(defn account-state
  "Everything a client needs to render a portfolio and decide what it may do
  next. `:free-collateral` is the number that answers 'can I open this', and
  it is computed here rather than by the client because getting it wrong is
  how a client offers a trade the chain will refuse."
  [ex account]
  (let [c (:clearing ex)
        marks (:marks ex)
        markets (:markets ex)]
    {:account account
     ;; The only nonce this account may sign next. A client that guesses gets
     ;; :bad-nonce, and a client that tracks its own drifts the moment anything
     ;; else submits for the account or a request is lost in flight — so the
     ;; chain says it, since the chain is the thing that decides.
     :next-nonce (auth/expected-nonce ex account)
     ;; Which key owns the id, or nil when it is unclaimed. Without this a
     ;; client cannot tell "nobody has taken this id" from "somebody else has",
     ;; and would discover the difference as a :wrong-key rejection after
     ;; signing.
     :bound-key (get-in ex [:account-keys account])
     ;; The Stable Principal this id belongs to, and any queued replacement of
     ;; its owner key.
     ;;
     ;; `:pending-rotation` is here because a veto nobody can see is not a
     ;; veto. `torihiki.principal` gives the holder a window to refuse a
     ;; controller-proposed key replacement, and a holder who cannot read
     ;; `{:pubkey ... :effective <height>}` off their own account has no way to
     ;; know there is anything to refuse or how long they have. nil means
     ;; nothing is queued.
     :principal (pr/principal-of ex account)
     :pending-rotation (pr/pending-rotation ex account)
     :rotation-delay-blocks (pr/rotation-delay ex)
     :collateral (get-in c [:accounts account :collateral] 0)
     :equity (cl/equity c account marks)
     :initial-margin (cl/initial-margin c account marks markets)
     :maintenance-margin (cl/maintenance-margin c account marks markets)
     ;; From protocol version 2 both count resting orders
     ;; (`torihiki.order-margin`): what is backing an order is not free.
     :order-margin (when (om/active? ex)
                     (om/requirement c (:open-orders ex) account marks markets))
     :free-collateral (om/free-collateral ex account)
     :liquidatable (boolean (cl/liquidatable? c account marks markets))
     :positions (into {}
                      (for [[m p] (get-in c [:accounts account :positions] {})
                            :when (not (zero? (:size p)))]
                        [m {:size (:size p)
                            :entry (cl/entry-price p)
                            :unrealized (cl/unrealized p (get marks m 0))
                            :isolated (:isolated p)}]))
     :triggers (vec (for [[m ts] (:triggers ex)
                          t ts
                          :when (= account (:account t))]
                      (assoc (select-keys t [:id :trigger-price :direction :order])
                             :market m)))}))

(defn market-info
  [ex market]
  (let [m (get-in ex [:markets market])]
    {:id market
     ;; What to call it. A read model that returns every rate and no name
     ;; makes the client invent one, and two clients invent two.
     :symbol (:symbol m)
     :open-interest (cl/open-interest (:clearing ex) market)
     :open-interest-cap (:open-interest-cap m)
     ;; The fee schedule, so a client can show what a trade will cost and what
     ;; volume would make it cost less. A venue that charges by tier and does
     ;; not publish the tiers is asking to be trusted about the price.
     :fee-tiers (mapv #(select-keys % [:min-volume :taker-fee-rate :maker-fee-rate])
                      (:fee-tiers m []))
     :margin-tiers (mapv #(select-keys % [:max-notional :max-leverage
                                          :initial-margin-rate
                                          :maintenance-margin-rate])
                         (:margin-tiers m []))
     :tick (:tick m)
     :lot (:lot m)
     :max-leverage (:max-leverage m)
     :initial-margin-rate (:initial-margin-rate m)
     :maintenance-margin-rate (:maintenance-margin-rate m)
     :taker-fee-rate (get m :taker-fee-rate 0)
     :maker-fee-rate (get m :maker-fee-rate 0)
     :oracle (get-in ex [:oracle market] 0)
     :oracle-stale (boolean (get-in ex [:oracle-stale market] false))
     :oracle-publishers (count (publishers ex))
     ;; Who disagrees with the published price, and by how much (a rate
     ;; against `fx/rate-scale`). Monitoring, not enforcement — see
     ;; `orc/deviation` — but a validator that is persistently far from its
     ;; peers should be visible to everyone who can read the market, not only
     ;; to whoever thinks to compute it.
     :oracle-deviations
     (let [ref (get-in ex [:oracle market] 0)
           ps (publishers ex)]
       (vec (for [[pub {:keys [price ts]}] (sort-by key (get-in ex [:oracle-submissions market] {}))
                  :when (contains? ps pub)]
              {:publisher pub :price price :ts ts
               :deviation (orc/deviation price ref)})))
     :mark (get-in ex [:marks market] 0)
     :last (get-in ex [:last market] 0)
     :funding-rate (get-in ex [:last-funding-rate market] 0)}))
