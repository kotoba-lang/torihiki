(ns torihiki.log
  "Phase 2: the verifiable log. A single sequencer, and a way for anyone to
  check that it did not lie.

  ## Sequencer, not consensus

  This namespace produces blocks. One writer decides their order, and nothing
  here votes, gossips, or tolerates a Byzantine peer. Calling that
  arrangement `consensus` would be a lie of the kind ADR-2608010930 Decision 5
  exists to forbid: a single writer plus compare-and-swap is a SEQUENCER. It
  is a real and useful thing — it gives total order, and the log it produces
  is independently checkable — but a validator set is what replaces trust in
  the operator, and there isn't one yet.

  ## What the log actually guarantees

  Two different properties, and conflating them is how a chain ends up
  trusting its own operator:

  1. `chain.core/verify-chain` proves the log was NOT TAMPERED WITH after the
     fact. Every commit re-derives to its own CID from its own bytes, and
     `seq` increases by exactly one. Rewriting a past block changes its CID
     and orphans every descendant.

  2. `replay` proves the recorded state roots are CORRECT. This is the
     stronger claim and the one that matters: a sequencer can publish a
     perfectly well-formed, untampered chain in which every state root is
     invented. Only re-executing the transactions catches that. Property (1)
     is about the log's integrity; property (2) is about the sequencer's
     honesty, and (1) does not imply (2).

  ## Injected, not imported

  Storage arrives as `put!`/`get-fn`, exactly the seam `chain.core` and
  `prolly-tree.core` already use, so a caller shares one block store with no
  adapter. Signing arrives as `sign-fn`/`verify-fn` for the same reason and
  one more: `kotoba-lang/ed25519` is JVM-only, and importing it would make
  this namespace — whose whole purpose is that anyone can re-check the log —
  unable to run in the browser that wants to check it."
  (:require [chain.core :as chain]
            [torihiki.api :as api]
            [torihiki.fixed :as fx]
            [torihiki.state :as st]))

;; ── wire encoding ───────────────────────────────────────────────────────────
;;
;; The commit body is dag-cbor, so it holds strings, integers, vectors and
;; maps — not keywords. The codec's job is FIDELITY, not validation: a
;; transaction the engine refuses is part of the block's outcome (`:rejected`
;; lands in the state root), so the log must record it exactly as submitted,
;; and `commit-block!` wraps `apply-block`, whose liveness contract is that a
;; block is applied or rejected and never thrown from.
;;
;; The codec before this one did the opposite in two directions, both measured.
;; It whitelisted eight transaction kinds and ten integer fields: every other
;; kind — `:amend`, `:trigger`, `:cancel-all`, forty more that `apply-tx`
;; dispatches on — threw `unknown transaction kind` out of `commit-block!`
;; (one legal tx stopped the sequencer), and every field it did not know was
;; SILENTLY DROPPED (a `:trigger` lost its `:order`; replay then recomputed a
;; different block than the one that was applied). A whitelist that goes stale
;; is worse than no whitelist, because its failure modes are a halt and a
;; quiet fork.
;;
;; What stays explicit is the KIND: it is named on the wire under "tx". What
;; becomes total is the VALUE space. Integers and strings encode bare — the
;; exact shape every block already committed has, so old logs keep decoding.
;; Numbers outside that shape carry their EXACT digits under a tag: a whole
;; number out of the i53 domain under "u", a fractional double (or a signed
;; infinity) under "d" — one number, one wire form, byte-identical on both
;; runtimes (see the number canon below). Keywords, booleans, nils, nested
;; maps and vectors encode tagged
;; (`["k" "below"]`), because a bare string and a keyword must not decode to
;; the same thing. Round trip is the law: `(= tx (wire->tx (tx->wire tx)))`
;; for every transaction, including the ones the engine will reject.

(def ^:private pairs-key
  "Wire key carrying the entries that cannot live in the flat part of the
  wire map: keys that are not plain keywords, or whose plain names would
  collide. Each is a `[key value]` pair in encoded form."
  "_pairs")

;; ── the number canon ────────────────────────────────────────────────────────
;;
;; Every real number a transaction can carry has ONE canonical form on the
;; wire and ONE canonical rendering in the signing payload, byte-identical
;; on both runtimes. `str` is neither: the JVM prints 1e17 as "1.0E17" and
;; JS as "100000000000000000", and neither prints the 55-digit expansion the
;; double 0.1 actually holds. A whole number — however typed, in or out of
;; the i53 domain — carries its exact integer digits under "u"; a fractional
;; double (and a signed infinity) carries its exact decimal expansion under
;; "d". NaN has no canonical form (`(= ##NaN ##NaN)` is false, so the round
;; trip law cannot hold) and is refused loudly, like a function value.

(defn- wire-number?
  "The number TYPES the canon covers: doubles and true integers. A JVM Ratio
  or BigDecimal is refused — its wire form would be a value decision the
  canon has not made — and a js/BigInt is digits-only (it is not `number?`
  and `long` throws on it; measured on SCI)."
  [v]
  #?(:clj (or (instance? Double v) (integer? v))
     :cljs (number? v)))

(defn- u-digits
  "The exact decimal digits of a whole number. A double is the integer it
  ACTUALLY holds (1e17 is 100000000000000000): the BigDecimal double
  CONSTRUCTOR is exact (`bigdec` is shortest-representation and disagrees
  with JS), and on the JS side `js/BigInt`'s string conversion of the double
  is exact. Arithmetic through BigInt is deliberately avoided — a 50-step
  BigInt x5 loop measured corrupted on SCI at the double-rounding scale
  (evidence/wnc-kbb-probe.cljk) — digits in, digits out, nothing else."
  [v]
  #?(:clj (if (instance? Double v)
            (str (.toBigIntegerExact (BigDecimal. (double v))))
            (str v))
     :cljs (.toString (js/BigInt v))))

#?(:cljs
   (defn- mul5d
     "Digits (least significant first) of a digit vector times 5, by carry —
     plain digit-string arithmetic, no BigInt (validated on SCI)."
     [ds]
     (loop [i 0 carry 0 acc []]
       (if (< i (count ds))
         (let [p (+ (* (nth ds i) 5) carry)]
           (recur (inc i) (quot p 10) (conj acc (rem p 10))))
         (if (pos? carry) (conj acc carry) acc)))))

#?(:cljs
   (defn- digits-of
     "Exact decimal digits (least significant first) of a non-negative
     integral double — its `js/BigInt` decimal STRING, char by char."
     [x]
     (let [n (.toString (js/BigInt x))]
       (loop [i (dec (count n)) acc []]
         (if (neg? i)
           acc
           (recur (dec i) (conj acc (- (js/parseInt (subs n i (inc i)) 10) 0))))))))

#?(:cljs
   (defn- frac-expansion
     "The exact decimal expansion of a finite fractional double. The double
     is exactly m*2^k (k >= 1 once the value is scaled whole), so its exact
     decimal is m*5^k over 10^k: digits of m, x5-with-carry k times, point
     placed k from the right. (The route is evidence/wnc-kbb-probe.cljk,
     validated byte-for-byte against the JVM's BigDecimal ground truth.)"
     [v]
     (let [neg? (neg? v)
           av (if neg? (- v) v)]
       (loop [x av k 0]
         (if (== x (js/Math.floor x))
           (let [ds0 (digits-of x)
                 ds (loop [i 0 ds ds0] (if (< i k) (recur (inc i) (mul5d ds)) ds))
                 lp (count ds)
                 padded (if (<= lp k) (into ds (repeat (inc (- k lp)) 0)) ds)
                 ip (- (count padded) k)
                 pstr (apply str (map str (reverse padded)))
                 out (if (zero? k) pstr (str (subs pstr 0 ip) "." (subs pstr ip)))]
             (if neg? (str "-" out) out))
           (recur (* x 2) (inc k)))))))

(defn- d-digits
  "The exact decimal expansion of a finite fractional double — the digits
  the double actually holds — and the string \"Infinity\"/\"-Infinity\" for
  a signed infinity. JVM: BigDecimal's double constructor is exact and
  `toPlainString` never goes scientific. JS: the digit-vector route above."
  [v]
  #?(:clj (if (Double/isInfinite v)
            (if (neg? v) "-Infinity" "Infinity")
            (.toPlainString (BigDecimal. (double v))))
     :cljs (if (js/Number.isFinite v)
             (frac-expansion v)
             (if (neg? v) "-Infinity" "Infinity"))))

(defn- enc-val
  "The wire form of one value: bare where the wire format was always bare
  (integers, strings), tagged `[tag payload]` where the type must survive the
  round trip. Total over the EDN subset a transaction can carry; anything
  else has no wire form and is refused loudly rather than mangled.

  Map entries are sorted by the printed encoding of their key so two runtimes
  that fold the same map produce the same bytes — an unsorted pair list would
  make the CID depend on hash iteration order."
  [v]
  (cond
    ;; An in-bounds integral double IS its integer — the canon
    ;; (`torihiki.api/canon-tx`). `(long v)` is exact for a whole value
    ;; inside the domain, so `{:qty 5.0}` encodes to the same bare bytes as
    ;; `{:qty 5}` on both runtimes (it used to throw "no wire form" on the
    ;; JVM and encode bare on nbb — one transaction, two logs).
    (and (api/int-like? v) (fx/in-domain? v)) (long v)
    ;; A whole number OUTSIDE the domain carries its exact digits under "u"
    ;; (Gap 1: it used to throw "no wire form" on the JVM, where `integer?`
    ;; is a TYPE test, and encode bare on JS, where it is a VALUE test — one
    ;; signed block, two logs, and the JVM sequencer halted at the wire).
    ;; A js/BigInt is digits-only here: not `number?`, and `long` throws.
    (or (and (wire-number? v) (api/int-like? v))
        #?(:cljs (instance? js/BigInt v) :clj false))
    ["u" (u-digits v)]
    ;; A fractional double and a signed infinity carry their exact decimal
    ;; expansion under "d" (Gap 2: both threw "no wire form" on BOTH
    ;; runtimes — a block the engine had already handled and recorded as
    ;; :rejected into the root could not be committed at all). NaN falls
    ;; past here on purpose: `(= ##NaN ##NaN)` is false, the round-trip law
    ;; cannot hold, so it stays the loud refusal at the bottom.
    (and (wire-number? v) (== v v)) ["d" (d-digits v)]
    (string? v) v
    ;; The colon is `str`'s, not the keyword's: `:a/y` stringifies to
    ;; ":a/y" and `(keyword ":a/y")` names a DIFFERENT keyword (one whose
    ;; name is ":a/y"), so the printed colon is stripped here and
    ;; `keyword` re-parses the slash on the way back — `:a/y` out of
    ;; "a/y", exactly.
    (keyword? v) ["k" (subs (str v) 1)]
    (boolean? v) ["b" v]
    (nil? v) ["n"]
    (map? v) ["m" (mapv (fn [[k vv]] [(enc-val k) (enc-val vv)])
                        (sort-by (fn [[k]] (pr-str (enc-val k))) v))]
    (vector? v) ["v" (mapv enc-val v)]
    (set? v) ["set" (mapv enc-val (sort-by pr-str v))]
    :else (throw (ex-info "torihiki.log: value has no wire form" {:value v}))))

(defn- dec-val
  "Exact inverse of `enc-val`."
  [w]
  (cond
    (vector? w) (case (first w)
                  "k" (keyword (second w))
                  "b" (second w)
                  "n" nil
                  ;; "u" decodes to the runtime's own integer category —
                  ;; BigInt on the JVM, Number on JS. This is the one place
                  ;; the two runtimes' value TYPES legitimately differ; the
                  ;; wire digits are identical and `==` (unlike `=`, which
                  ;; is type-sensitive across categories) is the honest
                  ;; comparison for a recovered value.
                  "u" #?(:clj (bigint (second w))
                         :cljs (js/Number (js/BigInt (second w))))
                  ;; "d" parses to the nearest double — which, for the
                  ;; exact expansion of a double, is the double itself.
                  "d" #?(:clj (Double/parseDouble (second w))
                         :cljs (js/parseFloat (second w)))
                  "m" (into {} (map (fn [[k v]] [(dec-val k) (dec-val v)])
                                    (second w)))
                  "v" (mapv dec-val (second w))
                  "set" (into #{} (map dec-val) (second w))
                  ;; a bare vector (never produced here) decodes structurally
                  (mapv dec-val w))
    :else w))

(defn tx->wire
  "Encode a transaction exactly — every key, every value, whatever the engine
  will later make of it.

  The kind rides under \"tx\": a plain keyword as its name string (the shape
  every committed block has), anything else tagged. Other entries ride under
  their name string when that name is unambiguous, and under `pairs-key` when
  it is not — so a transaction carrying a namespaced key or a key the codec
  has never seen still round-trips byte-exactly through `wire->tx`."
  [tx]
  (let [kind (:tx tx)
        entries (seq (dissoc tx :tx))
        plain-name (fn [k] (when (and (keyword? k) (nil? (namespace k)))
                             (name k)))
        freq (frequencies (map (comp plain-name key) entries))
        flat? (fn [k] (let [n (plain-name k)]
                        (and n (not= n pairs-key) (= 1 (get freq n)))))
        flat (into {} (for [[k v] entries :when (flat? k)]
                        [(name k) (enc-val v)]))
        rest-pairs (for [[k v] entries :when (not (flat? k))] [k v])]
    (cond-> (assoc flat "tx"
                   (cond
                     (and (keyword? kind) (nil? (namespace kind))) (name kind)
                     (keyword? kind) (enc-val kind)
                     (string? kind) ["s" kind]
                     :else (enc-val kind)))
      (seq rest-pairs)
      (assoc pairs-key (mapv (fn [[k v]] [(enc-val k) (enc-val v)])
                             (sort-by (fn [[k]] (pr-str (enc-val k)))
                                      rest-pairs))))))

(defn wire->tx
  "Exact inverse of `tx->wire`."
  [w]
  (let [kind-w (get w "tx")
        kind (cond
               ;; bare string is the old wire shape — it always meant a
               ;; keyword kind and still does
               (string? kind-w) (keyword kind-w)
               ;; `["s" ...]` is a STRING kind, tagged apart from the bare
               ;; form above so the two do not decode to the same thing
               (and (vector? kind-w) (= "s" (first kind-w))) (second kind-w)
               (vector? kind-w) (dec-val kind-w)
               :else kind-w)]
    (-> (into {:tx kind}
              (for [[k v] w :when (not (or (= k "tx") (= k pairs-key)))]
                [(keyword k) (dec-val v)]))
        (into (map (fn [[k v]] [(dec-val k) (dec-val v)]))
              (get w pairs-key)))))

(defn block->wire
  [{:keys [height ts txs]} state-root sig]
  (cond-> {"height" height
           "ts" ts
           "state-root" state-root
           "txs" (mapv tx->wire txs)}
    sig (assoc "sig" sig)))

(defn wire->block
  [w]
  {:height (get w "height")
   :ts (get w "ts")
   :txs (mapv wire->tx (get w "txs"))})

;; ── what gets signed ────────────────────────────────────────────────────────

(defn- slot-str
  "The canonical rendering of one signed value: a number goes through the
  number canon (exact digits — `str` would print 1e17 as \"1.0E17\" on the
  JVM and \"100000000000000000\" on JS, so the two runtimes would sign
  different bytes over the same block), anything else is `str` — nil as the
  empty string, as before. Total: it never throws."
  [v]
  (cond
    (and (wire-number? v) (api/int-like? v)) (u-digits v)
    #?(:cljs (instance? js/BigInt v) :clj false) (u-digits v)
    (and (wire-number? v) (== v v)) (d-digits v)
    :else (str v)))

(defn- kind-str
  "The canonical rendering of a transaction kind. Total — `(name (:tx t))`
  threw on a kind that was not a keyword and DROPPED a namespaced
  keyword's namespace (`:a/y` printed \"y\"): a keyword becomes its string
  with the slash kept, a string is itself, anything else falls back to the
  slot rendering."
  [k]
  (cond
    (keyword? k) (subs (str k) 1)
    (string? k) k
    :else (slot-str k)))

(defn signing-payload
  "The canonical bytes-as-string a sequencer signs.

  Deliberately covers the parent CID as well as this block's own contents. A
  signature over the block alone would let anyone splice a validly-signed
  block under a different parent and produce a chain the operator never
  produced — the signature has to commit to the position, not just the
  payload."
  [height ts state-root prev-cid txs]
  (str "torihiki/block\n"
       "height=" height "\n"
       "ts=" ts "\n"
       "state-root=" state-root "\n"
       "prev=" (or prev-cid "genesis") "\n"
       "ntx=" (count txs) "\n"
       (apply str (for [t txs
                        :let [t (api/canon-tx t)]]
                    (str (kind-str (:tx t)) ":"
                         (slot-str (:account t)) ":" (slot-str (:market t)) ":"
                         (slot-str (:side t)) ":" (slot-str (:level t)) ":"
                         (slot-str (:qty t)) ":" (slot-str (:flags t)) ":"
                         (slot-str (:oid t)) ":" (slot-str (:amount t)) ":"
                         (slot-str (:price t)) "\n")))))

;; ── producing the log ───────────────────────────────────────────────────────

(defn commit-block!
  "Apply `block` to `ex`, then append it to the chain rooted at `prev-cid`.

  Returns `{:exchange :cid :state-root}`. `sign-fn` is optional and receives
  the signing payload; whatever it returns rides in the commit under `sig`.

  The state root is computed AFTER application and stored alongside the
  transactions that produced it, which is exactly what makes `replay` able to
  contradict it."
  ([ex put! get-fn prev-cid block] (commit-block! ex put! get-fn prev-cid block nil))
  ([ex put! get-fn prev-cid block sign-fn]
   (let [ex' (st/apply-block ex block)
         root (st/state-root ex')
         sig (when sign-fn
               (sign-fn (signing-payload (:height block) (:ts block)
                                         root prev-cid (:txs block))))
         cid (chain/commit! put! get-fn (block->wire block root sig) prev-cid)]
     {:exchange ex' :cid cid :state-root root})))

(defn commit-blocks!
  "Fold a sequence of blocks into the log. Returns `{:exchange :cid :roots}`."
  ([ex put! get-fn prev-cid blocks] (commit-blocks! ex put! get-fn prev-cid blocks nil))
  ([ex put! get-fn prev-cid blocks sign-fn]
   (reduce (fn [{:keys [exchange cid roots]} b]
             (let [r (commit-block! exchange put! get-fn cid b sign-fn)]
               {:exchange (:exchange r) :cid (:cid r) :roots (conj roots (:state-root r))}))
           {:exchange ex :cid prev-cid :roots []}
           blocks)))

;; ── checking the log ────────────────────────────────────────────────────────

(defn replay
  "Re-execute every block in the chain ending at `cid` against a fresh
  exchange from `new-exchange-fn`, and compare each recomputed state root
  with the one the sequencer recorded.

  Returns `{:ok true :blocks n :exchange ex}` when every root agrees, or
  `{:ok false :height h :recorded r :recomputed r'}` at the FIRST block whose
  root does not — first, not all, because after one divergence every later
  root is computed from a state the verifier and the sequencer no longer
  share, so the remaining mismatches are noise.

  This is what makes the operator checkable. `chain.core/verify-chain` should
  be run too, but it answers a different question — see this namespace's
  docstring."
  [get-fn cid new-exchange-fn]
  (let [entries (chain/chain get-fn cid)]
    (loop [ex (new-exchange-fn)
           [e & more] entries
           n 0]
      (if (nil? e)
        {:ok true :blocks n :exchange ex}
        (let [w (:state e)
              recorded (get w "state-root")
              block (wire->block w)
              ex' (st/apply-block ex block)
              recomputed (st/state-root ex')]
          (if (= recorded recomputed)
            (recur ex' more (inc n))
            {:ok false
             :height (:height block)
             :recorded recorded
             :recomputed recomputed}))))))

(defn verify-signatures
  "Check every block's signature with `verify-fn`, which receives
  `[payload sig]` and returns truthy when the signature is good.

  Returns `{:ok true :blocks n}` or `{:ok false :height h :reason ...}`. A
  block with no signature is a failure rather than a skip: an unsigned block
  in a signed log is precisely what an attacker who cannot sign would
  produce, so treating it as 'nothing to check' would make the whole
  verification optional at the attacker's discretion."
  [get-fn cid verify-fn]
  (let [entries (chain/chain get-fn cid)]
    (loop [[e & more] entries n 0]
      (if (nil? e)
        {:ok true :blocks n}
        (let [w (:state e)
              sig (get w "sig")
              block (wire->block w)]
          (cond
            (nil? sig)
            {:ok false :height (:height block) :reason :unsigned}

            (not (verify-fn (signing-payload (:height block) (:ts block)
                                             (get w "state-root")
                                             (:prev e) (:txs block))
                            sig))
            {:ok false :height (:height block) :reason :bad-signature}

            :else (recur more (inc n))))))))

(defn tip-root
  "The state root the sequencer claims at the tip, without replaying."
  [get-fn cid]
  (some-> (chain/head get-fn cid) :state (get "state-root")))
